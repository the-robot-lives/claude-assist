# Terraform working dirs (state lives in MinIO); lock is fine to commit.
.terraform/
terraform.tfvars
*.secret.tfvars
*.secret.tfvars.json
backend.secret.hcl
*.tfstate
*.tfstate.*

# The repo-root .gitignore ignores every `secrets/` directory. Re-include ours
# so the committed *.sealedsecret.yaml files are tracked. The secrets/ dir has
# its OWN .gitignore that keeps plaintext (unsealed/, *.env) out.
!secrets/
