{
  "name": "@noizu/styleguide",
  "version": "0.1.15",
  "description": "Design system components and CSS generation from styleguide-engine",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-robot-lives/styleguide.git",
    "directory": "app/pkg"
  },
  "publishConfig": {
    "registry": "https://npm.noizu.com"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components.ts",
    "./primitives": "./src/primitives.ts",
    "./showcases": "./src/showcases.ts",
    "./viewers": "./src/viewers.ts",
    "./layout": "./src/layout.ts",
    "./demos": "./src/demos.ts",
    "./providers": "./src/providers.ts",
    "./sections": "./src/sections.ts",
    "./viewer": "./src/viewer.ts",
    "./css-gen": "./src/css-gen.ts",
    "./types": "./src/types.ts",
    "./viewer-css": "./dist/viewer.css",
    "./viewer-tailwind-css": "./dist/viewer.tailwind.css"
  },
  "bin": {
    "styleguide-serve": "bin/styleguide-serve.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "dist/engine-src/",
    "dist/viewer.css",
    "dist/viewer.tailwind.css"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": ">=0.52.0 <1",
    "js-yaml": "^5.1.0",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
