# Styleguide Hologram — Authentik OIDC (same app as hologram-start-app)
# Copy to .env and fill client id/secret from START_APP_OIDC_* / Infisical.
#
# Issuer (fixed for starter):
#   https://auth.derobot.is/application/o/startapp
#
# Authentik redirect URI for local dev:
#   http://localhost:4500/auth/oidc/callback
# (add this URI on the startapp OAuth2 provider in Authentik)

PORT=4500
PHX_HOST=localhost

OIDC_ISSUER=https://auth.derobot.is/application/o/startapp
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4500/auth/oidc/callback

# Same as start-app-site.tf
SSO_DOMAINS=noizu.com=oidc;therobotlives.com=oidc;derobot.is=oidc
