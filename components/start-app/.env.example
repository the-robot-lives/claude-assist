# ── Project identity (derived by `make init`) ────────────────────
PROJECT_SLUG=starter
REGISTRY=ops.noizu.com

# ── Postgres (container hostname on lets-go_default network) ─────
DATABASE_URL=ecto://starter:starter_dev@db:5432/start_app_dev

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://starter:starter_dev@redis:6379/0
REDIS_KEY_PREFIX=starter:

# ── Secrets (generated by `make init`) ───────────────────────────
SECRET_KEY_BASE=CHANGE_ME
GUARDIAN_SECRET_KEY=CHANGE_ME

# ── App ──────────────────────────────────────────────────────────
PHX_HOST=localhost
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://app.localhost:8080
NEXT_PUBLIC_COOKIE_DOMAIN=
# Absolute URL of the frontend — SSO callbacks redirect here.
FRONTEND_URL=http://localhost:8080

# ── SSO: Authentik (OIDC) ───────────────────────────────────────
# The "Sign in with SSO" button + /auth/oidc flow activate when
# OIDC_CLIENT_ID is set. Authentik is the default OIDC provider.
# Register an OAuth2/OIDC provider + application in Authentik, then:
#   OIDC_ISSUER       = https://auth.noizu.com/application/o/<app-slug>
#   OIDC_REDIRECT_URI = https://<your-host>/auth/oidc/callback  (default: derived from PHX_HOST)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# When "true", SSO only logs in users that already exist (no auto-provision).
SSO_REQUIRE_INVITE=false
# Format: "example.com=oidc;corp.example=google,oidc"
SSO_DOMAINS=

# ── Port (nginx, host-side) ─────────────────────────────────────
PORT=8080
