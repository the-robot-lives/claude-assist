FROM node:22-alpine AS build

RUN apk add --no-cache git python3 make g++ libc6-compat
RUN corepack enable

WORKDIR /app
COPY . .

ENV NODE_OPTIONS=--max-old-space-size=4096
RUN pnpm install --frozen-lockfile
RUN pnpm --filter=@webstudio-is/builder... build

FROM node:22-alpine AS production

RUN apk add --no-cache libc6-compat
RUN corepack enable

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

COPY --from=build /app /app

# Vite/Remix builds output to a runtime-specific subdirectory; remix-serve expects build/server/index.js
RUN if [ ! -f apps/builder/build/server/index.js ] && [ -d apps/builder/build/server ]; then \
      subdir=$(ls apps/builder/build/server/ | head -1) && \
      ln -s "/app/apps/builder/build/server/${subdir}/index.js" /app/apps/builder/build/server/index.js; \
    fi

EXPOSE 3000
CMD ["pnpm", "--filter=@webstudio-is/builder", "start"]
