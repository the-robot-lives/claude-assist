#!/bin/bash
# Reads /etc/osx-fstab and ensures each volume is mounted at its declared path.
#
# Format (one entry per line):
#   uuid=<UUID>  label=<Label>  disk=<device>  <mountpoint>  <fstype>  <options>  0  0
#
# Use - for unknown/unavailable identifiers.
# Mount attempt order: UUID → label → disk (first success wins).
# Volumes already at the correct mount point are left untouched.
# Volumes mounted elsewhere are force-unmounted then remounted at the correct path.

CONFIG="${OSX_FSTAB:-/etc/osx-fstab}"
NTFS_3G="${NTFS_3G_BIN:-$(command -v ntfs-3g 2>/dev/null || echo /usr/local/bin/ntfs-3g)}"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [fstab-remount] $*"; }

# Allow time for external disks to enumerate after boot
sleep 3

resolve_disk_device() {
    local identifier="$1"
    [[ -z "$identifier" || "$identifier" == "-" ]] && return 1
    local info
    info=$(diskutil info "$identifier" 2>/dev/null) || return 1
    awk -F':[[:space:]]+' '/[[:space:]]Device Node:/{print $2}' <<< "$info"
}

attempt_mount() {
    local identifier="$1" mountpoint="$2"
    [[ -z "$identifier" || "$identifier" == "-" ]] && return 1
    diskutil info "$identifier" &>/dev/null || return 1
    diskutil mount -mountPoint "$mountpoint" "$identifier" &>/dev/null
}

attempt_mount_ntfs_rw() {
    local identifier="$1" mountpoint="$2" options="$3"
    [[ -z "$identifier" || "$identifier" == "-" ]] && return 1

    if [[ ! -x "$NTFS_3G" ]]; then
        log "FAIL  ntfs-3g not found at $NTFS_3G — install with: brew install ntfs-3g"
        return 1
    fi

    local device
    device=$(resolve_disk_device "$identifier") || return 1

    local ntfs_opts="rw,allow_other,auto_xattr"
    if [[ "$options" == *"uid="* ]]; then
        ntfs_opts="$ntfs_opts,$(grep -oE 'uid=[0-9]+' <<< "$options")"
    fi
    if [[ "$options" == *"gid="* ]]; then
        ntfs_opts="$ntfs_opts,$(grep -oE 'gid=[0-9]+' <<< "$options")"
    fi
    if [[ "$options" == *"umask="* ]]; then
        ntfs_opts="$ntfs_opts,$(grep -oE 'umask=[0-9]+' <<< "$options")"
    fi

    local err
    err=$("$NTFS_3G" "$device" "$mountpoint" -o "$ntfs_opts" 2>&1) || {
        log "NTFS  ntfs-3g error: $err"
        return 1
    }
}

attempt_mount_ntfs_ro() {
    local identifier="$1" mountpoint="$2"
    [[ -z "$identifier" || "$identifier" == "-" ]] && return 1

    local device
    device=$(resolve_disk_device "$identifier") || return 1

    mount_ntfs -o ro "$device" "$mountpoint" 2>/dev/null
}

while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    uuid="" label="" disk=""

    # Extract tagged key=value pairs (values are single tokens, except label which may have spaces)
    [[ "$line" =~ uuid=([^[:space:]]+) ]] && uuid="${BASH_REMATCH[1]}" || uuid="-"
    [[ "$line" =~ disk=([^[:space:]]+) ]] && disk="${BASH_REMATCH[1]}" || disk="-"
    if [[ "$line" =~ label=(.*)[[:space:]][[:space:]]+disk= ]]; then
        label="${BASH_REMATCH[1]}"
    else
        label="-"
    fi

    # Positional fields: everything after "disk=<device> " — mountpoint may contain spaces
    # but fstype, options, dump, fsck are always single tokens, so parse from the right
    positional=$(sed 's/.*disk=[^[:space:]]*[[:space:]]*//' <<< "$line")
    fstype=$(awk '{print $(NF-3)}' <<< "$positional")
    options=$(awk '{print $(NF-2)}' <<< "$positional")
    mountpoint=$(awk '{for(i=1;i<=NF-4;i++) printf "%s%s",$i,(i<NF-4?" ":"")}' <<< "$positional")

    # Decode fstab-style octal escapes (e.g. \040 → space)
    mountpoint="$(printf '%b' "$mountpoint")"
    fstype="$(printf '%b' "$fstype")"
    options="$(printf '%b' "$options")"

    [[ -z "$mountpoint" || "$mountpoint" == "none" ]] && continue
    [[ "$options" == *"noauto"* ]] && continue

    # Determine current mount point using the first resolvable identifier
    current=""
    found_id=""
    for id in "$uuid" "$label" "$disk"; do
        [[ -z "$id" || "$id" == "-" ]] && continue
        info=$(diskutil info "$id" 2>/dev/null) || continue
        current=$(awk -F':[[:space:]]+' '/[[:space:]]Mount Point:/{print $2}' <<< "$info")
        found_id="$id"
        break
    done

    # Disk not present (offline / removable) — skip silently
    [[ -z "$found_id" ]] && continue

    # Check mount(8) for FUSE-T mounts (invisible to diskutil)
    mount_opts=$(mount | grep -F " on $mountpoint " | grep -o '(.*)' || true)
    fuse_mounted=""
    if [[ -n "$mount_opts" && -z "$current" ]]; then
        fuse_mounted=1
        current="$mountpoint"
    fi

    # Already at the correct mount point — check if mode is correct
    if [[ "$current" == "$mountpoint" ]]; then
        needs_remount=""

        if [[ "$fstype" == "ntfs" ]]; then
            if [[ "$mount_opts" == *"read-only"* ]]; then
                log "REMOUNT $mountpoint — currently ro, need rw via ntfs-3g"
                needs_remount=1
            elif [[ -n "$fuse_mounted" ]]; then
                log "OK    $mountpoint (ntfs rw via fuse-t, already correct)"
                continue
            fi
        fi

        if [[ -z "$needs_remount" ]]; then
            log "OK    $mountpoint (already correct)"
            if [[ "$options" == *"owners"* && "$fstype" != ntfs* ]]; then
                if [[ "$mount_opts" == *"noowners"* ]]; then
                    if diskutil enableOwnership "$mountpoint" &>/dev/null; then
                        log "OWN   $mountpoint — ownership enabled"
                    else
                        log "WARN  $mountpoint — failed to enable ownership"
                    fi
                fi
            fi
            continue
        fi

        # Unmount the incorrectly-mounted volume before remounting
        if [[ -n "$fuse_mounted" ]]; then
            umount "$mountpoint" 2>/dev/null || true
        else
            diskutil unmount force "$found_id" &>/dev/null || {
                log "FAIL  could not unmount $found_id for remount — skipping"
                continue
            }
        fi
    fi

    # Mounted at a different location — unmount first
    if [[ "$current" == /* && "$current" != "$mountpoint" ]]; then
        log "MOVE  $current → $mountpoint"
        diskutil unmount force "$found_id" &>/dev/null || {
            log "FAIL  could not unmount $found_id from $current — skipping"
            continue
        }
    else
        log "MOUNT → $mountpoint"
    fi

    # Ensure the target directory exists
    mkdir -p "$mountpoint"

    # Try UUID → label → disk, dispatching by fstype
    mounted_id=""
    for id in "$uuid" "$label" "$disk"; do
        [[ -z "$id" || "$id" == "-" ]] && continue
        case "$fstype" in
            ntfs)
                if attempt_mount_ntfs_rw "$id" "$mountpoint" "$options"; then
                    log "OK    $mountpoint (ntfs rw, by $id)"
                    mounted_id="$id"
                    break
                fi
                ;;
            ntfs-ro)
                if attempt_mount_ntfs_ro "$id" "$mountpoint"; then
                    log "OK    $mountpoint (ntfs ro, by $id)"
                    mounted_id="$id"
                    break
                fi
                ;;
            *)
                if attempt_mount "$id" "$mountpoint"; then
                    log "OK    $mountpoint (by $id)"
                    mounted_id="$id"
                    break
                fi
                ;;
        esac
    done

    if [[ -z "$mounted_id" ]]; then
        log "FAIL  $mountpoint — exhausted uuid=$uuid label=$label disk=$disk (fstype=$fstype)"
        continue
    fi

    # Post-mount verification for NTFS rw
    if [[ "$fstype" == "ntfs" ]]; then
        post_opts=$(mount | grep -F " on $mountpoint " || true)
        if [[ -z "$post_opts" ]]; then
            log "FAIL  $mountpoint — ntfs-3g returned success but volume not in mount table"
        elif echo "$post_opts" | grep -q "read-only"; then
            log "FAIL  $mountpoint — mounted but still read-only"
        else
            log "VERIFY $mountpoint — ntfs rw confirmed"
        fi
    fi

    # Enable ownership if requested (APFS only)
    if [[ -n "$mounted_id" && "$options" == *"owners"* && "$fstype" != ntfs* ]]; then
        if diskutil enableOwnership "$mountpoint" &>/dev/null; then
            log "OWN   $mountpoint — ownership enabled"
        else
            log "WARN  $mountpoint — failed to enable ownership"
        fi
    fi

done < "$CONFIG"
