#!/usr/bin/env bash
set -euo pipefail
# =============================================================================
# deploy-service — Headless build → push → values-bump → helm upgrade.
#
# One command to ship a portfolio image: build + multi-arch push (with version
# promotion), rewrite the target chart's values.yaml to the newly-pushed tag,
# then run helm-upgrade for the owning release.
#
# Config source (same as docker-build / docker-push): .infra-config.yaml,
# resolved via k8-lib's config-resolver (--config / K8_CONFIG / INFRA_ROOT /
# git-root walk). Each image declares its deploy target with a `helm:` stanza:
#
#   # composite:  .project.projects[].services[].helm
#   # flat:       .project.docker.images[].helm
#   helm:
#     chart_path:  kubernetes/helm/apps/codefresh   # dir holding values.yaml
#     values_path: .codefresh.backend.image         # yq path inside values.yaml
#     format:      image | tag                       # default: tag
#
#   format=tag    values_path is a bare version string  (".image.tag")
#   format=image  values_path is a full image ref       (".backend.image");
#                 only the tag is swapped, the registry prefix is preserved.
#
# The chart (helm release) is basename(chart_path) — the same key helm-upgrade
# discovers from paths.helm_dir / helm_scan_dirs / chart_path_overrides.
#
# Usage:
#   deploy-service <image-key> [<image-key>...] [flags]
#
# Batched behaviour:
#   Multiple image-keys build+push sequentially (fail-fast). Each image's
#   values.yaml is bumped, then each unique helm release is upgraded exactly
#   once at the end — so a coupled backend+frontend ship as a single deploy.
#
# Arguments:
#   <image-key>    docker-build target. Flat name (e.g. bottlecrm) or composite
#                  (e.g. codefre.sh/backend). Directory names and single-service
#                  domain shorthand resolve the same way docker-build resolves
#                  them. Repeatable.
#
# Flags:
#   --tag TAG      Force the edge build tag (e.g. v2.1.edge); rejected with >1 key.
#   --stage        Set BUILD_ENV=stage.
#   --prod         Set BUILD_ENV=prod.
#   --dev          Set BUILD_ENV=dev  (default).
#   --env ENV      Set BUILD_ENV to a custom value.
#   --no-cache     Pass --no-cache through to docker-build.
#   --skip-build   Skip build/push and the values bump; deploy current values.yaml.
#   --skip-deploy  Build + push + bump values only; no helm-upgrade.
#   --yes, -y      Auto-confirm all prompts (docker push + helm-upgrade headless).
#   --dry-run      Print the plan; touch nothing.
#   --config PATH  Path to .infra-config.yaml.
#   -v, --verbose  Echo sub-commands before running them.
#   -h, --help     Show this help.
#
# Requires: docker-build, docker-push, helm-upgrade, yq, git on PATH.
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

# common.sh → colours + step/ok/warn/die + config-resolver (sets INFRA_ROOT,
#             HELM_DIR, REGISTRY-related K8_* vars from .infra-config.yaml)
# docker-config.sh → docker image registry (normalize_repo_name, DOCKER_REPOS,
#             _registry_path_for_image) + build/push state (.docker-state)
# helm-common.sh → chart discovery (_CHART_DIRS), release/namespace resolution
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/docker-config.sh"
source "$K8_LIB_DIR/bin/helm-common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

BOLD=$'\033[1m'

# --- Parse args --------------------------------------------------------------
IMAGE_KEYS=()
TAG_OVERRIDE=""
FLAG_NO_CACHE=false
FLAG_SKIP_BUILD=false
FLAG_SKIP_DEPLOY=false
FLAG_DRY_RUN=false
FLAG_VERBOSE=false
FLAG_YES=false

usage() {
  sed -n '3,/^# ===/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tag)          TAG_OVERRIDE="$2"; shift 2 ;;
    --tag=*)        TAG_OVERRIDE="${1#--tag=}"; shift ;;
    --no-cache)     FLAG_NO_CACHE=true; shift ;;
    --skip-build)   FLAG_SKIP_BUILD=true; shift ;;
    --skip-deploy)  FLAG_SKIP_DEPLOY=true; shift ;;
    --stage)        export BUILD_ENV=stage; shift ;;
    --prod)         export BUILD_ENV=prod; shift ;;
    --dev)          export BUILD_ENV=dev; shift ;;
    --env=*)        export BUILD_ENV="${1#--env=}"; shift ;;
    --env)          export BUILD_ENV="$2"; shift 2 ;;
    --yes|-y)       FLAG_YES=true; shift ;;
    --dry-run)      FLAG_DRY_RUN=true; shift ;;
    --config=*)     shift ;;
    --config)       shift 2 ;;
    -v|--verbose)   FLAG_VERBOSE=true; shift ;;
    -h|--help)      usage 0 ;;
    --)             shift; IMAGE_KEYS+=("$@"); break ;;
    -*)             die "Unknown flag: $1 (see --help)" ;;
    *)              IMAGE_KEYS+=("$1"); shift ;;
  esac
done

(( ${#IMAGE_KEYS[@]} >= 1 )) || die "Missing <image-key> (see --help)"
if [[ -n "$TAG_OVERRIDE" && ${#IMAGE_KEYS[@]} -gt 1 ]]; then
  die "--tag is only allowed with a single image-key; got ${#IMAGE_KEYS[@]} keys"
fi

command -v yq >/dev/null            || die "yq not on PATH"
command -v git >/dev/null           || die "git not on PATH"
$FLAG_SKIP_BUILD || command -v docker-build >/dev/null \
  || die "docker-build not on PATH"
$FLAG_SKIP_DEPLOY || command -v helm-upgrade >/dev/null \
  || die "helm-upgrade not on PATH"

if $FLAG_YES; then
  export DOCKER_YES=true AUTO_YES=true
fi

# --- Resolve an image key → its helm: stanza from the merged .infra-config.yaml
# Sets RES_CHART_PATH / RES_VALUES_PATH / RES_FORMAT. Returns 1 if no stanza.
resolve_image_helm() {
  local key="$1" cfg="$_K8_MERGED_CONFIG" q hj
  RES_CHART_PATH="" RES_VALUES_PATH="" RES_FORMAT=""

  if [[ "$key" == */* ]]; then
    local domain="${key%%/*}" svc="${key#*/}"
    q=".project.projects[]? | select(.domain == \"$domain\") | .services[]? | select(.name == \"$svc\") | .helm"
  else
    q=".project.docker.images[]? | select(.name == \"$key\") | .helm"
  fi

  hj="$(yq -o=json -I=0 "$q // \"\"" "$cfg" 2>/dev/null | head -n1 || true)"
  [[ -z "$hj" || "$hj" == '""' || "$hj" == "null" ]] && return 1

  RES_CHART_PATH="$(printf '%s' "$hj"  | yq -r '.chart_path // ""')"
  RES_VALUES_PATH="$(printf '%s' "$hj" | yq -r '.values_path // ""')"
  RES_FORMAT="$(printf '%s' "$hj"      | yq -r '.format // "tag"')"
  return 0
}

# --- Most recent promoted tag docker-push recorded for a key -----------------
# .docker-state/pushes lines are: epoch|image-key|sha|version-tag
last_pushed_vsn() {
  local f="${DOCKER_STATE_DIR}/pushes"
  [[ -f "$f" ]] || return 1
  awk -F'|' -v k="$1" '$2==k{v=$4} END{ if (v != "") print v }' "$f"
}

# --- Rewrite values.yaml at values_path to the newly-pushed tag --------------
bump_values() {
  local vf="$1" vp="$2" fmt="$3" tag="$4"
  if [[ "$fmt" == "image" ]]; then
    local cur prefix
    cur="$(yq -r "$vp // \"\"" "$vf")"
    if [[ "$cur" == *:* ]]; then
      prefix="${cur%:*}"
    else
      prefix="$cur"   # no existing tag — write bare (unusual)
    fi
    yq -i "$vp = \"${prefix}:${tag}\"" "$vf"
  else
    yq -i "$vp = \"${tag}\"" "$vf"
  fi
}

# --- Build per-image plan ----------------------------------------------------
declare -a PLAN_KEYS PLAN_CHART_PATH PLAN_CHART_NAME PLAN_VALUES_FILE
declare -a PLAN_YQ_PATH PLAN_FORMAT PLAN_CURRENT PLAN_EDGE

for raw in "${IMAGE_KEYS[@]}"; do
  # Canonicalise the key exactly like docker-build (dir names, single-service
  # domain shorthand, …).
  if key="$(normalize_repo_name "$raw" 2>/dev/null)"; then :; else
    die "Unknown image '$raw'. Known: $(get_all_docker_repos 2>/dev/null | tr '\n' ' ')"
  fi

  resolve_image_helm "$key" \
    || die "$key: no helm: stanza in .infra-config.yaml (need chart_path + values_path)"

  chart_path="$RES_CHART_PATH"
  yq_path="$RES_VALUES_PATH"
  fmt="$RES_FORMAT"

  [[ -z "$chart_path" ]] && die "$key: helm.chart_path is required"
  [[ -z "$yq_path" ]]    && die "$key: helm.values_path is required"
  [[ "$fmt" == "tag" || "$fmt" == "image" ]] \
    || die "$key: helm.format must be 'tag' or 'image' (got '$fmt')"
  [[ "$yq_path" != .* ]] && yq_path=".$yq_path"

  # Resolve values.yaml (chart_path is repo-root-relative unless absolute).
  if [[ "$chart_path" == /* ]]; then
    values_file="$chart_path/values.yaml"
  else
    values_file="$INFRA_ROOT/$chart_path/values.yaml"
  fi
  if [[ ! -f "$values_file" ]]; then
    die "chart values.yaml not found: $values_file
   Portfolio charts live under projects/*/helm/; shared platform charts live in
   the upstream noizu-infra repo (kubernetes/helm/*). Run deploy-service where
   the chart is checked out, or fix helm.chart_path for '$key'."
  fi

  chart_name="$(basename "$chart_path")"
  if [[ -z "${_CHART_DIRS[$chart_name]+x}" ]] && ! $FLAG_SKIP_DEPLOY; then
    warn "chart '$chart_name' not discoverable by helm-upgrade (not under paths.helm_dir / helm_scan_dirs / chart_path_overrides) — deploy step may be a no-op"
  fi

  current_val="$(yq -r "${yq_path} // \"\"" "$values_file")"
  [[ -z "$current_val" || "$current_val" == "null" ]] && \
    die "$values_file has no value at $yq_path"

  if [[ "$fmt" == "image" ]]; then
    [[ "$current_val" == *:* ]] || die "image string lacks a tag: $current_val ($values_file)"
    cur_tag="${current_val##*:}"
  else
    cur_tag="$current_val"
  fi

  # Derive the edge build tag (v<major>.<minor>.edge[-env]) so version
  # promotion continues the series the chart currently references.
  clean_cur="${cur_tag#v}"
  if [[ -n "$TAG_OVERRIDE" ]]; then
    edge="${TAG_OVERRIDE#v}"; edge="v$edge"
  elif [[ "$clean_cur" =~ ^([0-9]+)\.([0-9]+)\.edge([-.].*)?$ ]]; then
    edge="v$clean_cur"
  elif [[ "$clean_cur" =~ ^([0-9]+)\.([0-9]+)\. ]]; then
    env_val="${BUILD_ENV:-dev}"
    env_sfx=""
    [[ "$env_val" != "prod" && "$env_val" != "production" ]] && env_sfx="-${env_val}"
    edge="v${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.edge${env_sfx}"
  else
    die "cannot derive an edge tag from current value '$cur_tag' in $values_file (need M.m.patch form, or pass --tag)"
  fi

  PLAN_KEYS+=("$key")
  PLAN_CHART_PATH+=("$chart_path")
  PLAN_CHART_NAME+=("$chart_name")
  PLAN_VALUES_FILE+=("$values_file")
  PLAN_YQ_PATH+=("$yq_path")
  PLAN_FORMAT+=("$fmt")
  PLAN_CURRENT+=("$current_val")
  PLAN_EDGE+=("$edge")
done

# Unique helm releases (chart names), preserving first-seen order.
UNIQUE_CHARTS=()
for name in "${PLAN_CHART_NAME[@]}"; do
  seen=false
  for existing in "${UNIQUE_CHARTS[@]:-}"; do
    [[ "$existing" == "$name" ]] && { seen=true; break; }
  done
  $seen || UNIQUE_CHARTS+=("$name")
done

# --- Plan summary ------------------------------------------------------------
step "deploy-service plan (${#PLAN_KEYS[@]} image$([ ${#PLAN_KEYS[@]} -gt 1 ] && echo s), env=${BUILD_ENV:-dev})"
for i in "${!PLAN_KEYS[@]}"; do
  printf "  ${BOLD}[%d] %s${NC}\n" "$((i + 1))" "${PLAN_KEYS[$i]}"
  printf "      %-14s %s\n" "chart"       "${PLAN_CHART_NAME[$i]}  (${PLAN_CHART_PATH[$i]})"
  printf "      %-14s %s\n" "values.yaml" "${PLAN_VALUES_FILE[$i]#$INFRA_ROOT/}"
  printf "      %-14s %s  [%s]\n" "values_path" "${PLAN_YQ_PATH[$i]}" "${PLAN_FORMAT[$i]}"
  printf "      %-14s %s\n" "current"     "${PLAN_CURRENT[$i]}"
  printf "      %-14s %s → v<M>.<m>.<next patch> (resolved on push)\n" "edge build" "${PLAN_EDGE[$i]}"
done
echo
if $FLAG_SKIP_BUILD; then
  echo "  build step:  skip (--skip-build); deploying current values.yaml as-is"
else
  s="docker-build --push --multiarch --vsn <edge>"; $FLAG_NO_CACHE && s+=" --no-cache"
  echo "  build step:  $s  × ${#PLAN_KEYS[@]}"
  echo "  bump step:   values.yaml ← promoted tag (from .docker-state)"
fi
if $FLAG_SKIP_DEPLOY; then
  echo "  deploy step: skip (--skip-deploy)"
else
  echo "  deploy step: helm-upgrade --include ${UNIQUE_CHARTS[*]:-<none>}"
fi
echo

run() {
  $FLAG_VERBOSE && echo "  \$ $*"
  if $FLAG_DRY_RUN; then
    echo "  [dry-run] $*"
    return 0
  fi
  "$@"
}

if $FLAG_DRY_RUN; then
  warn "Dry run — nothing built, bumped, or deployed."
  exit 0
fi

# --- Stage 1: build + push + bump values -------------------------------------
if ! $FLAG_SKIP_BUILD; then
  for i in "${!PLAN_KEYS[@]}"; do
    key="${PLAN_KEYS[$i]}"
    step "[$((i + 1))/${#PLAN_KEYS[@]}] Build & push ${key} (edge: ${PLAN_EDGE[$i]})"

    build_args=(docker-build --push --multiarch --vsn "${PLAN_EDGE[$i]}")
    $FLAG_NO_CACHE && build_args+=(--no-cache)
    $FLAG_VERBOSE  && build_args+=(--verbose)
    $FLAG_YES      && build_args+=(--yes)
    build_args+=("$key")
    run "${build_args[@]}" < /dev/null

    # docker-push recorded the promoted tag to .docker-state/pushes.
    if promoted="$(last_pushed_vsn "$key")" && [[ -n "$promoted" ]]; then
      :
    else
      die "could not determine promoted tag for '$key' from ${DOCKER_STATE_DIR}/pushes (push may have failed)"
    fi

    step "Bump ${PLAN_VALUES_FILE[$i]#$INFRA_ROOT/}: ${PLAN_YQ_PATH[$i]} → ${promoted}"
    bump_values "${PLAN_VALUES_FILE[$i]}" "${PLAN_YQ_PATH[$i]}" "${PLAN_FORMAT[$i]}" "$promoted"
    ok "${key} pushed ${promoted}; values.yaml updated"
  done
else
  warn "Skipping build/push/bump (--skip-build) — deploying values.yaml as checked out"
fi

# --- Stage 2: helm upgrade ---------------------------------------------------
if ! $FLAG_SKIP_DEPLOY; then
  helm_flags=()
  $FLAG_YES && helm_flags+=(--headless)
  for name in "${UNIQUE_CHARTS[@]:-}"; do
    [[ -z "$name" ]] && continue
    step "helm-upgrade --include $name"
    run helm-upgrade --include "$name" "${helm_flags[@]+"${helm_flags[@]}"}"
    ok "$name upgrade dispatched"
  done
else
  warn "Skipping deploy (--skip-deploy)"
fi

step "Done"
