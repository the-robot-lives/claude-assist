# {name}.md.prompt — prompt spec template
# Fillable. Extends media-payload schema v0.4 with type: prompt.
# Copy to {name}.md.prompt beside the prompt file, fill the < > slots, delete comments you don't need.

schema: "0.4"
id: <stable-kebab-id>                 # e.g. claude-md-root
type: prompt                          # NEW chat-type — see references/file-mode-convention.md appendix

name: "<human name>"
description: "<one line: what this prompt is and who loads it>"

# --- declared intent: drives question-aware compression (what MUST work + why + focus) ---
key_requirements:
  - "<requirement 1 — a behavior that must survive compression>"
  - "<requirement 2>"
  - "<requirement 3>"

# --- request axes: per-prompt optimization defaults (0..5; see assets/compactness-scale.md) ---
compactness: <0-5>                    # default target level
style: <pure-npl|yaml-meta|mermaid|checklist|pointer-index|shorthand|plain>   # optional
protect:                              # survive VERBATIM at every level (never compressed, never ledgered as dropped)
  - "<exact rule / command / gotcha that must not drift>"
lossy_ok:                             # loss acceptable here — spend budget savings first
  - "<area where dropping detail is fine>"

# --- evaluation (extends v0.4 eval block) ---
eval:
  rules: >
    <the rubric: what makes one variant behaviorally better for this prompt's purpose.
     Name the criteria families — behavior fidelity, fact recall, cost — and their weights.>
  pass_threshold: 0.8                 # min weighted normalized score (0.8 recommended for behavior-critical prompts)
  # required_pass: [<criterion>]      # criteria that must EACH clear the bar (e.g. compliance)
  dataset:                            # inline scenarios now; future: dataset_links to codefre.sh
    - id: <case-id>
      input: >
        <the scenario / user message the prompt-under-test will face>
      expect: >
        <the behavior a correct prompt should induce (not exact words unless scoring: exact/contains)>
      scoring: rubric                 # exact | contains | rubric | judge
      weight: 1.0
      tags: [<protected-fact | edge-case | deep-path | ...>]
    - id: <protected-fact-probe>      # ALWAYS include a probe for each protect item
      input: "<ask that requires a protected fact>"
      expect: "<the exact protected string>"
      scoring: contains
  # dataset_links:                    # FUTURE — link project datasets
  #   - "codefresh://project/<project>/datasets/<name>"

# --- selection ---
pin: null                             # null = auto-select best passing variant within budget; else a variant slug
