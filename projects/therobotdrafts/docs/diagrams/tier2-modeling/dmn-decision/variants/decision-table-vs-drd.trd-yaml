# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: DMN Variant - Decision Table vs DRD (same decision)
elements:
  - { id: CS, type: UseCase, name: Credit\nScore }
  - { id: DTI, type: UseCase, name: DTI }
  - { id: LTV, type: UseCase, name: LTV }
  - { id: RC, type: Boundary, name: Risk\nClass, stereotype: decision }
  - { id: Guide, type: Artifact, name: Underwriting\nGuide }
  - { id: ~note1, type: Note, name: '**LEFT = DRD (topology)**', documentation: '**LEFT = DRD (topology)**\n"Risk Class exists and consumes\nCredit Score, DTI, LTV, and is\ngoverned by the Underwriting\nGuide."\nThis is a GRAPH view.' }
  - { id: ~note2, type: Note, name: '**RIGHT = Decision Table (payload of "Risk Class…', documentation: '**RIGHT = Decision Table (payload of "Risk Class")**\nHit Policy: **UNIQUE**\n--\n| Credit Score | DTI  | LTV  | => Risk Class |\n| >= 750       | <36% | <=80%| A (prime)     |\n| 680-749      | <43% | <=90%| B (near)      |\n| 620-679      | <50% | <=95%| C (subprime)  |\n| < 620        | --   | --   | D (decline)   |\n--\nThis is the decision''s LOGIC, not a\nnode on the graph. One rectangle on\nthe DRD holds this whole table.' }
  - { id: ~note3, type: Note, name: '**Key relationship**', documentation: '**Key relationship**\nThe DRD rectangle "Risk Class" is a CONTAINER. Its CONTENTS (the boxed\nexpression) is the decision table on the right. Changing the table edits the\ndecision''s rules; it does not change the DRD''s topology. Adding/removing\ninputs or outputs of the table MIGHT change the DRD edges.' }
edges:
  - { id: e1, type: DirectedAssociation, from: CS, to: RC }
  - { id: e2, type: DirectedAssociation, from: DTI, to: RC }
  - { id: e3, type: DirectedAssociation, from: LTV, to: RC }
  - { id: e4, type: Dependency, from: RC, to: Guide, label: authority }
  - { id: e5, type: NoteLink, from: ~note1, to: RC }
  - { id: e6, type: NoteLink, from: ~note2, to: RC }
  - { id: e7, type: NoteLink, from: ~note3, to: RC }
diagrams:
  - { id: d1, name: DMN Variant - Decision Table vs DRD (same decision), kind: usecase, layoutProvenance: Synthesized }
