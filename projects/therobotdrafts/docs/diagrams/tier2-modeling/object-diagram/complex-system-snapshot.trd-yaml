# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Object Diagram - Complex Platform Snapshot
elements:
  - { id: ns, type: Class, name: 'ns:Namespace' }
  - { id: cfg, type: Class, name: 'cfg:ConfigMap' }
  - { id: sec, type: Class, name: 'sec:Secret' }
  - { id: img, type: Class, name: 'img:Image' }
  - { id: depApi, type: Class, name: 'dep-api:Deployment' }
  - { id: replicas, type: Lifeline, name: replicas }
  - { id: 3, type: Lifeline, name: 3 }
  - { id: depWrk, type: Class, name: 'dep-wrk:Deployment' }
  - { id: 2, type: Lifeline, name: 2 }
  - { id: svc, type: Class, name: 'svc:Service' }
  - { id: port, type: Lifeline, name: port }
  - { id: 8080, type: Lifeline, name: 8080 }
  - { id: p0, type: Class, name: 'p0:Pod' }
  - { id: p1, type: Class, name: 'p1:Pod' }
  - { id: p2, type: Class, name: 'p2:Pod' }
  - { id: c0, type: Class, name: 'c0:Container' }
  - { id: c1, type: Class, name: 'c1:Container' }
  - { id: w0, type: Class, name: 'w0:Pod' }
  - { id: hpa, type: Class, name: 'scaling:HPA' }
  - { id: ~note1, type: Note, name: '<b>Shared instances</b>', documentation: '<b>Shared instances</b>\ncfg, sec, img, and ns are each\nreferenced by several links — they\nare the SAME runtime object, not\ncopies.  Object diagrams make this\nidentity explicit.' }
  - { id: ~note2, type: Note, name: '<b>Qualified association</b>', documentation: '<b>Qualified association</b>\nsvc -> p0  via  [name="api-0"]\nThe qualifier is a key that selects\nONE target from a set — a map-style\nlookup expressed at the link level.' }
edges:
  - { id: e1, type: Association, from: replicas, to: 3 }
  - { id: e2, type: Association, from: replicas, to: 2 }
  - { id: e3, type: Association, from: port, to: 8080 }
  - { id: e4, type: Composition, from: ns, to: depApi, label: contains, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e5, type: Composition, from: ns, to: depWrk, label: contains, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e6, type: Composition, from: ns, to: cfg, label: holds, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e7, type: Composition, from: ns, to: sec, label: holds, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e8, type: Composition, from: ns, to: svc, label: holds, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e9, type: Composition, from: depApi, to: p0, label: owns, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e10, type: Composition, from: depApi, to: p1, label: owns, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e11, type: Composition, from: depApi, to: p2, label: owns, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e12, type: Composition, from: depWrk, to: w0, label: owns, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e13, type: Composition, from: p0, to: c0 }
  - { id: e14, type: Composition, from: p1, to: c1 }
  - { id: e15, type: MessageReply, from: p0, to: cfg, label: mounts }
  - { id: e16, type: MessageReply, from: p1, to: cfg, label: mounts }
  - { id: e17, type: MessageReply, from: p2, to: cfg, label: mounts }
  - { id: e18, type: MessageReply, from: p0, to: sec, label: consumes }
  - { id: e19, type: MessageReply, from: p1, to: sec, label: consumes }
  - { id: e20, type: MessageReply, from: w0, to: sec, label: consumes }
  - { id: e21, type: MessageReply, from: c0, to: img, label: runs }
  - { id: e22, type: MessageReply, from: c1, to: img, label: runs }
  - { id: e23, type: MessageReply, from: hpa, to: depApi, label: targets }
  - { id: e24, type: MessageReply, from: svc, to: depApi, label: selects }
  - { id: e25, type: MessageReply, from: svc, to: p0, label: 'endpoint  [[name="api-0"]]' }
  - { id: e26, type: MessageReply, from: svc, to: p1, label: 'endpoint  [[name="api-1"]]' }
  - { id: e27, type: NoteLink, from: ~note1, to: hpa }
  - { id: e28, type: NoteLink, from: ~note2, to: svc }
diagrams:
  - { id: d1, name: Example Object Diagram - Complex Platform Snapshot, kind: sequence, layoutProvenance: Synthesized }
