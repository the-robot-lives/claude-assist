@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex object diagram — a 12+ instance runtime configuration of a deployed micro-service platform.
'   usecase:      Teach shared instances referenced by several links, qualified associations, and large snapshots.
'   complexity:   complex
'   domain:       DevOps / Platform
' ============================================================================
title Example Object Diagram - Complex Platform Snapshot

' ---------------------------------------------------------------------------
' Snapshot of a Kubernetes-style deployment at a single instant:
'  - two Deployments sharing one Namespace and one ConfigMap
'  - a Service fronting one Deployment's pods
'  - a Secret mounted by several pods
'  - a shared Registry image referenced by multiple containers
' Qualified associations (key=value near the arrow tail) model map lookups
' such as pod.metadata[name="api-0"].
' ---------------------------------------------------------------------------

object "ns:Namespace" as ns {
  name = "production"
  cluster = "noizu-east"
}

object "cfg:ConfigMap" as cfg {
  name = "api-config"
  LOG_LEVEL = "info"
  MAX_CONN = "200"
}

object "sec:Secret" as sec {
  name = "db-credentials"
  __ref = "infisical://db/pw"
}

object "img:Image" as img {
  ref = "registry.noizu.com/api:v1.4.2"
  digest = "sha256:9a3f..."
}

object "dep-api:Deployment" as depApi {
  name = "api-server"
  replicas = 3
}

object "dep-wrk:Deployment" as depWrk {
  name = "worker"
  replicas = 2
}

object "svc:Service" as svc {
  name = "api-svc"
  clusterIP = "10.96.10.10"
  port = 8080
}

object "p0:Pod" as p0 {
  name = "api-0"
  phase = "Running"
}

object "p1:Pod" as p1 {
  name = "api-1"
  phase = "Running"
}

object "p2:Pod" as p2 {
  name = "api-2"
  phase = "Pending"
}

object "c0:Container" as c0 {
  name = "api"
  cpu = "500m"
}

object "c1:Container" as c1 {
  name = "api"
  cpu = "500m"
}

object "w0:Pod" as w0 {
  name = "worker-0"
  phase = "Running"
}

object "scaling:HPA" as hpa {
  name = "api-hpa"
  targetCPU = "70%"
}

' --- Links: containment & ownership ---------------------------------------
ns "1" *-- "*" depApi : contains
ns "1" *-- "*" depWrk : contains
ns "1" *-- "*" cfg : holds
ns "1" *-- "*" sec : holds
ns "1" *-- "*" svc : holds

depApi "1" *-- "*" p0 : owns
depApi "1" *-- "*" p1 : owns
depApi "1" *-- "*" p2 : owns
depWrk "1" *-- "*" w0 : owns

p0 *-- c0
p1 *-- c1

' --- Links: shared instances referenced by many --------------------------
' The same ConfigMap is mounted by multiple pods — a SHARED instance.
p0 --> cfg : mounts
p1 --> cfg : mounts
p2 --> cfg : mounts

' The same Secret is consumed by the api pods and the worker.
p0 --> sec : consumes
p1 --> sec : consumes
w0 --> sec : consumes

' The same container image is referenced by every api container.
c0 --> img : runs
c1 --> img : runs

' The HPA targets the api Deployment; the Service selects api pods.
hpa --> depApi : targets
svc --> depApi : selects

' --- Qualified association -----------------------------------------------
' A Service looks up an individual pod by name in a map.  The qualifier
' [name="api-0"] near the target end expresses that lookup key.
svc --> p0 : endpoint  [[name="api-0"]]
svc --> p1 : endpoint  [[name="api-1"]]

note right of hpa
  <b>Shared instances</b>
  cfg, sec, img, and ns are each
  referenced by several links — they
  are the SAME runtime object, not
  copies.  Object diagrams make this
  identity explicit.
end note

note bottom of svc
  <b>Qualified association</b>
  svc -> p0  via  [name="api-0"]
  The qualifier is a key that selects
  ONE target from a set — a map-style
  lookup expressed at the link level.
end note

@enduml
