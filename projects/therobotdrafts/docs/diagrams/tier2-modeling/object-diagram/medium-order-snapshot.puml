@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Medium object diagram — an e-commerce order snapshot with 7 linked instances and a collection of line items.
'   usecase:      Teach multi-instance links, link roles, and a collection (list) of parts inside a composite.
'   complexity:   medium
'   domain:       E-Commerce
' ============================================================================
title Example Object Diagram - Medium Order Snapshot

' ---------------------------------------------------------------------------
' This snapshot captures one Order placed by a Customer, shipped to an
' Address, paid by a CreditCard, and containing two OrderItem lines that each
' reference a Product.  The Order holds a collection (list) of OrderItems —
' modelled here as individual linked instances because an object diagram
' shows discrete runtime objects, not arrays.
' ---------------------------------------------------------------------------

object "alice:Customer" as alice {
  customerId = 55
  name = "Alice Lee"
}

object "ord:Order" as ord {
  orderId = 9001
  status = "CONFIRMED"
  placedAt = "2026-07-09T08:00:00Z"
}

object "home:Address" as home {
  street = "742 Evergreen Terrace"
  city = "Springfield"
  zip = "62704"
}

object "card:CreditCard" as card {
  last4 = "4242"
  brand = "VISA"
  expires = "2028-03"
}

' Two OrderItem instances — together they form the ordered collection
' { line1, line2 } referenced by the Order.
object "line1:OrderItem" as line1 {
  sequence = 1
  quantity = 2
  unitPrice = 29.99
}

object "line2:OrderItem" as line2 {
  sequence = 2
  quantity = 1
  unitPrice = 199.00
}

object "widget:Product" as widget {
  sku = "WID-001"
  name = "Widget Pro"
}

object "cable:Product" as cable {
  sku = "CBL-USB-C"
  name = "USB-C Cable"
}

' --- Links ---------------------------------------------------------------
' A Customer places many Orders; here one concrete link alice -> ord.
alice "1" --> "places *" ord

' Composition link: the Order is made of its line items (ordered collection).
ord "1" o-- "*" line1 : contains
ord "1" o-- "*" line2 : contains

' Each OrderItem references exactly one Product (qualified by sku).
line1 --> widget : ref
line2 --> cable : ref

' Shared target: the Order reuses the Customer's home address for shipping.
ord --> home : shipTo
alice --> home : livesAt

' Payment link: the Order was charged to one CreditCard.
ord --> card : paidBy

note bottom of ord
  <b>Collection slot</b>
  Order.items is a List<OrderItem> =
  { line1, line2 }.
  An object diagram renders each
  element as its own instance box
  rather than an inline array literal.
end note

@enduml
