# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Object Diagram Variant - Object vs Class
elements:
  - { id: oJohn, type: Class, name: 'john:Customer', members: [{ name: name, isOperation: false, visibility: Public, defaultValue: '"John Smith"', rawText: 'name = "John Smith"' }, { name: customerId, isOperation: false, visibility: Public, defaultValue: 42, rawText: customerId = 42 }] }
  - { id: oAcct, type: Class, name: 'acct:Account', members: [{ name: accountId, isOperation: false, visibility: Public, defaultValue: 1001, rawText: accountId = 1001 }, { name: balance, isOperation: false, visibility: Public, defaultValue: 1500.00, rawText: balance = 1500.00 }] }
  - { id: Customer, type: Class, name: Customer, stereotype: class, members: [{ name: name, isOperation: false, visibility: Private, type: String, rawText: '- name : String' }, { name: customerId, isOperation: false, visibility: Private, type: int, rawText: '- customerId : int' }, { name: openAccount, isOperation: true, visibility: Public, type: Account, rawText: '+ openAccount() : Account' }] }
  - { id: Account, type: Class, name: Account, stereotype: class, members: [{ name: accountId, isOperation: false, visibility: Private, type: int, rawText: '- accountId : int' }, { name: balance, isOperation: false, visibility: Private, type: Money, rawText: '- balance : Money' }, { name: deposit, isOperation: true, visibility: Public, params: [{ name: amount, type: Money }], rawText: '+ deposit(amount : Money)' }] }
  - { id: ~note1, type: Note, name: '<b>OBJECT DIAGRAM</b>', documentation: '<b>OBJECT DIAGRAM</b>\nInstances with concrete slot values.\n"john:Customer" is ONE customer.\nLinks connect specific objects.' }
  - { id: ~note2, type: Note, name: '<b>CLASS DIAGRAM</b>', documentation: '<b>CLASS DIAGRAM</b>\nType definitions with typed members.\nCustomer is the CLASS for ALL customers.\nAssociations connect classifiers.' }
  - { id: ~note3, type: Note, name: '<b>Instance-snapshot vs type-definition</b>', documentation: '<b>Instance-snapshot vs type-definition</b>\nThe class diagram (right) defines WHAT fields and links are possible.\nThe object diagram (left) shows WHAT the values are RIGHT NOW.\nEvery object must conform to its class: john.name is a String because\nCustomer.name : String; the john->acct link is legal because the\nCustomer "owns" Account association permits it.' }
edges:
  - { id: e1, type: DirectedAssociation, from: oJohn, to: oAcct, fromMultiplicity: 1, toMultiplicity: 'owns *' }
  - { id: e2, type: DirectedAssociation, from: Customer, to: Account, fromMultiplicity: 1, toMultiplicity: 'owns *' }
  - { id: e3, type: NoteLink, from: ~note1, to: oJohn }
  - { id: e4, type: NoteLink, from: ~note2, to: Customer }
  - { id: e5, type: NoteLink, from: ~note3, to: Customer }
diagrams:
  - { id: d1, name: Example Object Diagram Variant - Object vs Class, kind: class, layoutProvenance: Synthesized }
