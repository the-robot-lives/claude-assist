# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Object Diagram - Medium Order Snapshot
elements:
  - { id: alice, type: Class, name: 'alice:Customer' }
  - { id: customerId, type: Lifeline, name: customerId }
  - { id: 55, type: Lifeline, name: 55 }
  - { id: ord, type: Class, name: 'ord:Order' }
  - { id: orderId, type: Lifeline, name: orderId }
  - { id: 9001, type: Lifeline, name: 9001 }
  - { id: home, type: Class, name: 'home:Address' }
  - { id: card, type: Class, name: 'card:CreditCard' }
  - { id: line1, type: Class, name: 'line1:OrderItem' }
  - { id: sequence, type: Lifeline, name: sequence }
  - { id: 1, type: Lifeline, name: 1 }
  - { id: quantity, type: Lifeline, name: quantity }
  - { id: 2, type: Lifeline, name: 2 }
  - { id: unitPrice, type: Lifeline, name: unitPrice }
  - { id: 29.99, type: Lifeline, name: 29.99 }
  - { id: line2, type: Class, name: 'line2:OrderItem' }
  - { id: 199.00, type: Lifeline, name: 199.00 }
  - { id: widget, type: Class, name: 'widget:Product' }
  - { id: cable, type: Class, name: 'cable:Product' }
  - { id: ~note1, type: Note, name: '<b>Collection slot</b>', documentation: '<b>Collection slot</b>\nOrder.items is a List<OrderItem> =\n{ line1, line2 }.\nAn object diagram renders each\nelement as its own instance box\nrather than an inline array literal.' }
edges:
  - { id: e1, type: Association, from: customerId, to: 55 }
  - { id: e2, type: Association, from: orderId, to: 9001 }
  - { id: e3, type: Association, from: sequence, to: 1 }
  - { id: e4, type: Association, from: quantity, to: 2 }
  - { id: e5, type: Association, from: unitPrice, to: 29.99 }
  - { id: e6, type: Association, from: sequence, to: 2 }
  - { id: e7, type: Association, from: quantity, to: 1 }
  - { id: e8, type: Association, from: unitPrice, to: 199.00 }
  - { id: e9, type: MessageReply, from: alice, to: ord, fromMultiplicity: 1, toMultiplicity: 'places *' }
  - { id: e10, type: Aggregation, from: ord, to: line1, label: contains, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e11, type: Aggregation, from: ord, to: line2, label: contains, fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e12, type: MessageReply, from: line1, to: widget, label: ref }
  - { id: e13, type: MessageReply, from: line2, to: cable, label: ref }
  - { id: e14, type: MessageReply, from: ord, to: home, label: shipTo }
  - { id: e15, type: MessageReply, from: alice, to: home, label: livesAt }
  - { id: e16, type: MessageReply, from: ord, to: card, label: paidBy }
  - { id: e17, type: NoteLink, from: ~note1, to: ord }
diagrams:
  - { id: d1, name: Example Object Diagram - Medium Order Snapshot, kind: sequence, layoutProvenance: Synthesized }
