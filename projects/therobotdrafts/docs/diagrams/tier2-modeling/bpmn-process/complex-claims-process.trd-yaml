# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Process - Claims Handling
elements:
  - { id: DS1, type: Database, name: Claims DB }
  - { id: DS2, type: Database, name: Policy DB }
  - { id: 'MsgStart   '' message start', type: UseCase, name: 'MsgStart   '' message start' }
  - { id: 'TimerInt   '' timer intermediate', type: UseCase, name: 'TimerInt   '' timer intermediate' }
  - { id: 'SigEnd     '' signal end', type: UseCase, name: 'SigEnd     '' signal end' }
  - { id: 'ErrEnd     '' error end', type: UseCase, name: 'ErrEnd     '' error end' }
  - { id: 'OkEnd      '' normal end', type: UseCase, name: 'OkEnd      '' normal end' }
  - { id: T1, type: Boundary, name: Log Claim }
  - { id: T2, type: Boundary, name: Assign Adjuster }
  - { id: T3, type: Boundary, name: Gather Docs }
  - { id: T4, type: Boundary, name: Assess Damage }
  - { id: T5, type: Boundary, name: Decision Review }
  - { id: T6, type: Boundary, name: Notify Customer }
  - { id: T7, type: Boundary, name: Issue Payment }
  - { id: T8, type: Boundary, name: Close Claim }
  - { id: T9, type: Boundary, name: Escalate }
  - { id: SP1, type: Boundary, name: 'Fraud Check [+]' }
  - { id: And1, type: UseCase, name: Split (AND) }
  - { id: And2, type: UseCase, name: Merge (AND) }
  - { id: Xor1, type: UseCase, name: 'Covered?' }
  - { id: Or1, type: UseCase, name: Risk Split (OR) }
  - { id: Eb1, type: UseCase, name: Wait For (Event) }
  - { id: TX, type: Package, name: Settlement Transaction }
  - { id: T10, type: Boundary, name: Reconcile, parentId: TX }
  - { id: MsgStart, type: Actor, name: MsgStart }
  - { id: TimerInt, type: Actor, name: TimerInt }
  - { id: ErrEnd, type: Actor, name: ErrEnd }
  - { id: SigEnd, type: Actor, name: SigEnd }
  - { id: ~note1, type: Note, name: '<b>Message start event</b>', documentation: '<b>Message start event</b>\nProcess starts on inbound\nclaim message.' }
  - { id: ~note2, type: Note, name: '<b>Collapsed sub-process (+)</b>', documentation: '<b>Collapsed sub-process (+)</b>\nHidden detail; click to expand.' }
  - { id: ~note3, type: Note, name: '<b>Event-based gateway</b>', documentation: '<b>Event-based gateway</b>\nWaits for one of several\nevents; first to fire wins.' }
  - { id: ~note4, type: Note, name: '<b>Transaction</b>', documentation: '<b>Transaction</b>\nCompensable unit — if T7 fails,\na compensation handler undoes it.' }
  - { id: ~note5, type: Note, name: '<b>Data store</b>', documentation: '<b>Data store</b>\nPersistent; survives runs.\nData object = transient token.' }
edges:
  - { id: e1, type: DirectedAssociation, from: MsgStart, to: T1 }
  - { id: e2, type: DirectedAssociation, from: T1, to: DS1, label: write }
  - { id: e3, type: DirectedAssociation, from: DS2, to: T1, label: read policy }
  - { id: e4, type: DirectedAssociation, from: T1, to: And1 }
  - { id: e5, type: DirectedAssociation, from: And1, to: T2 }
  - { id: e6, type: DirectedAssociation, from: And1, to: SP1 }
  - { id: e7, type: DirectedAssociation, from: T2, to: T3 }
  - { id: e8, type: DirectedAssociation, from: T3, to: T4 }
  - { id: e9, type: DirectedAssociation, from: T4, to: Xor1 }
  - { id: e10, type: DirectedAssociation, from: SP1, to: Or1 }
  - { id: e11, type: DirectedAssociation, from: Xor1, to: T5, label: (yes) }
  - { id: e12, type: DirectedAssociation, from: Xor1, to: T9, label: (no — denied) }
  - { id: e13, type: DirectedAssociation, from: Or1, to: T5 }
  - { id: e14, type: DirectedAssociation, from: Or1, to: T9 }
  - { id: e15, type: DirectedAssociation, from: T5, to: Eb1 }
  - { id: e16, type: DirectedAssociation, from: Eb1, to: TimerInt, label: customer silent 7d }
  - { id: e17, type: DirectedAssociation, from: Eb1, to: T6, label: customer replies }
  - { id: e18, type: DirectedAssociation, from: TimerInt, to: ErrEnd }
  - { id: e19, type: DirectedAssociation, from: T6, to: And2 }
  - { id: e20, type: DirectedAssociation, from: T5, to: And2 }
  - { id: e21, type: DirectedAssociation, from: And2, to: T7 }
  - { id: e22, type: DirectedAssociation, from: T7, to: T10 }
  - { id: e23, type: DirectedAssociation, from: T7, to: T8 }
  - { id: e24, type: DirectedAssociation, from: T8, to: SigEnd }
  - { id: e25, type: DirectedAssociation, from: T9, to: ErrEnd }
  - { id: e26, type: NoteLink, from: ~note1, to: MsgStart }
  - { id: e27, type: NoteLink, from: ~note2, to: SP1 }
  - { id: e28, type: NoteLink, from: ~note3, to: Eb1 }
  - { id: e29, type: NoteLink, from: ~note4, to: TX }
  - { id: e30, type: NoteLink, from: ~note5, to: DS1 }
diagrams:
  - { id: d1, name: Example BPMN Process - Claims Handling, kind: usecase, layoutProvenance: Synthesized }
