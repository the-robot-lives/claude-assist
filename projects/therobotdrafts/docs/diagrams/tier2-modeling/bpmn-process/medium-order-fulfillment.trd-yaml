# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Process - Order Fulfillment
elements:
  - { id: Start, type: UseCase, name: Start }
  - { id: T1, type: Boundary, name: Receive Order }
  - { id: T2, type: Boundary, name: Charge Payment }
  - { id: T3, type: Boundary, name: Pack Items }
  - { id: T4, type: Boundary, name: Ship Order }
  - { id: T5, type: Boundary, name: Refund Customer }
  - { id: And1, type: UseCase, name: Split (AND) }
  - { id: Xor1, type: UseCase, name: 'Paid?' }
  - { id: EndOk, type: UseCase, name: EndOk }
  - { id: EndFail, type: UseCase, name: EndFail }
  - { id: ~note1, type: Note, name: '<b>Error boundary event</b>', documentation: '<b>Error boundary event</b>\n(concentric circle on task)\nIf payment raises an error,\nthe token jumps to the\ncompensation path (Refund).' }
  - { id: ~note2, type: Note, name: '<b>Parallel gateway (AND)</b>', documentation: '<b>Parallel gateway (AND)</b>\nForks into concurrent branches;\nthe matching join waits for all.' }
  - { id: ~note3, type: Note, name: '<b>Exclusive gateway (XOR)</b>', documentation: '<b>Exclusive gateway (XOR)</b>\nOne path taken based on condition.' }
  - { id: ~note4, type: Note, name: '<b>End event (thick circle)</b>', documentation: '<b>End event (thick circle)</b>' }
edges:
  - { id: e1, type: DirectedAssociation, from: Start, to: T1 }
  - { id: e2, type: DirectedAssociation, from: T1, to: And1 }
  - { id: e3, type: DirectedAssociation, from: And1, to: T2 }
  - { id: e4, type: DirectedAssociation, from: And1, to: T3 }
  - { id: e5, type: DirectedAssociation, from: T2, to: Xor1 }
  - { id: e6, type: DirectedAssociation, from: Xor1, to: T4, label: (yes) }
  - { id: e7, type: DirectedAssociation, from: Xor1, to: T5, label: (no — payment error) }
  - { id: e8, type: NoteLink, from: ~note1, to: T2 }
  - { id: e9, type: DirectedAssociation, from: T3, to: T4 }
  - { id: e10, type: DirectedAssociation, from: T4, to: EndOk }
  - { id: e11, type: DirectedAssociation, from: T5, to: EndFail }
  - { id: e12, type: NoteLink, from: ~note2, to: And1 }
  - { id: e13, type: NoteLink, from: ~note3, to: Xor1 }
  - { id: e14, type: NoteLink, from: ~note4, to: EndOk }
diagrams:
  - { id: d1, name: Example BPMN Process - Order Fulfillment, kind: usecase, layoutProvenance: Synthesized }
