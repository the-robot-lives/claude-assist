# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Process - Simple Approval
elements:
  - { id: 'Start  '' thin circle ~ start event', type: UseCase, name: 'Start  '' thin circle ~ start event' }
  - { id: 'End    '' thick circle ~ end event (render as end below)', type: UseCase, name: 'End    '' thick circle ~ end event (render as end below)' }
  - { id: Xor1, type: UseCase, name: 'Approved?' }
  - { id: Task1, type: Boundary, name: Review Request }
  - { id: Start, type: Actor, name: Start }
  - { id: End, type: Actor, name: End }
  - { id: ~note1, type: Note, name: '<b>Start event</b> (thin circle):', documentation: '<b>Start event</b> (thin circle):\nprocess begins here.' }
  - { id: ~note2, type: Note, name: '<b>Exclusive gateway (XOR)</b>', documentation: '<b>Exclusive gateway (XOR)</b>\nDiamond with X.\nExactly one outgoing path taken.' }
  - { id: ~note3, type: Note, name: '<b>End event</b> (thick circle):', documentation: '<b>End event</b> (thick circle):\nprocess terminates.' }
  - { id: ~note4, type: Note, name: '<b>User task</b> (rectangle):', documentation: '<b>User task</b> (rectangle):\na human performs this step.' }
edges:
  - { id: e1, type: DirectedAssociation, from: Start, to: Task1, label: sequence flow }
  - { id: e2, type: DirectedAssociation, from: Task1, to: Xor1 }
  - { id: e3, type: DirectedAssociation, from: Xor1, to: End, label: (yes) }
  - { id: e4, type: DirectedAssociation, from: Xor1, to: Task1, label: (no — return to review) }
  - { id: e5, type: NoteLink, from: ~note1, to: Start }
  - { id: e6, type: NoteLink, from: ~note2, to: Xor1 }
  - { id: e7, type: NoteLink, from: ~note3, to: End }
  - { id: e8, type: NoteLink, from: ~note4, to: Task1 }
diagrams:
  - { id: d1, name: Example BPMN Process - Simple Approval, kind: usecase, layoutProvenance: Synthesized }
