# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Communication - Complex Distributed Collaboration
elements:
  - { id: Client, type: Lifeline, name: Client, stereotype: actor }
  - { id: Gateway, type: Lifeline, name: Gateway }
  - { id: AuthSvc, type: Lifeline, name: AuthSvc }
  - { id: OrderSvc, type: Lifeline, name: OrderSvc }
  - { id: InventorySvc, type: Lifeline, name: InventorySvc }
  - { id: PricingSvc, type: Lifeline, name: PricingSvc }
  - { id: PaymentSvc, type: Lifeline, name: PaymentSvc }
  - { id: ShippingSvc, type: Lifeline, name: ShippingSvc }
  - { id: AuditSvc, type: Lifeline, name: AuditSvc }
  - { id: Cache, type: Lifeline, name: Cache }
  - { id: DB, type: Lifeline, name: DB }
edges:
  - { id: e1, type: Association, from: Client, to: Gateway }
  - { id: e2, type: Association, from: Gateway, to: AuthSvc }
  - { id: e3, type: Association, from: Gateway, to: OrderSvc }
  - { id: e4, type: Association, from: OrderSvc, to: InventorySvc }
  - { id: e5, type: Association, from: OrderSvc, to: PricingSvc }
  - { id: e6, type: Association, from: OrderSvc, to: PaymentSvc }
  - { id: e7, type: Dependency, from: OrderSvc, to: ShippingSvc }
  - { id: e8, type: Dependency, from: OrderSvc, to: AuditSvc }
  - { id: e9, type: Association, from: OrderSvc, to: Cache }
  - { id: e10, type: Association, from: OrderSvc, to: DB }
  - { id: e11, type: MessageReply, from: Client, to: Gateway, label: '1: submitOrder(payload)' }
  - { id: e12, type: MessageReply, from: Gateway, to: AuthSvc, label: '1.1: verifyToken()' }
  - { id: e13, type: MessageReply, from: Gateway, to: OrderSvc, label: '2: placeOrder()' }
  - { id: e14, type: MessageReply, from: OrderSvc, to: InventorySvc, label: '2.1a: reserveItem()*[for each line item]' }
  - { id: e15, type: MessageReply, from: OrderSvc, to: PricingSvc, label: '2.1b: calculateTotals()' }
  - { id: e16, type: MessageReply, from: OrderSvc, to: DB, label: '2.2: persistOrder()' }
  - { id: e17, type: MessageReply, from: OrderSvc, to: Cache, label: '2.3: warmCache(orderId)' }
  - { id: e18, type: MessageReply, from: OrderSvc, to: PaymentSvc, label: '3: chargeCard()' }
  - { id: e19, type: MessageReply, from: PaymentSvc, to: OrderSvc, label: '3.1a: paymentApproved()' }
  - { id: e20, type: MessageReply, from: PaymentSvc, to: OrderSvc, label: '3.1b: paymentDeclined()[auth_failed]' }
  - { id: e21, type: MessageReply, from: OrderSvc, to: ShippingSvc, label: '4: scheduleShipment()' }
  - { id: e22, type: MessageReply, from: OrderSvc, to: AuditSvc, label: '5: logTransaction()' }
  - { id: e23, type: MessageReply, from: Gateway, to: Client, label: '6: returnConfirmation()' }
diagrams:
  - { id: d1, name: Example Communication - Complex Distributed Collaboration, kind: sequence, layoutProvenance: Synthesized }
