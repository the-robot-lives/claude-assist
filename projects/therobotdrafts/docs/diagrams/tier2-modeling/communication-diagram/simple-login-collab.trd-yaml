  - { id: LoginForm, type: Lifeline, name: LoginForm }
  - { id: AuthService, type: Lifeline, name: AuthService }
edges:
  - { id: e1, type: MessageReply, from: User, to: LoginForm, label: '1: enterCredentials()' }
