# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Communication - Medium Booking Collaboration
elements:
  - { id: Guest, type: Lifeline, name: Guest, stereotype: actor }
  - { id: BookingUI, type: Lifeline, name: BookingUI }
  - { id: ReservationSvc, type: Lifeline, name: ReservationSvc }
  - { id: InventorySvc, type: Lifeline, name: InventorySvc }
  - { id: PaymentSvc, type: Lifeline, name: PaymentSvc }
  - { id: NotificationSvc, type: Lifeline, name: NotificationSvc }
edges:
  - { id: e1, type: MessageReply, from: Guest, to: BookingUI, label: '1: searchRooms(checkIn, checkOut)' }
  - { id: e2, type: MessageReply, from: BookingUI, to: InventorySvc, label: '1.1: queryAvailability()' }
  - { id: e3, type: MessageReply, from: InventorySvc, to: BookingUI, label: '1.2: returnAvailableRooms()' }
  - { id: e4, type: MessageReply, from: BookingUI, to: Guest, label: '1.3: showResults()' }
  - { id: e5, type: MessageReply, from: Guest, to: BookingUI, label: '2: selectRoom(roomId)' }
  - { id: e6, type: MessageReply, from: BookingUI, to: ReservationSvc, label: '2.1: createHold(roomId)' }
  - { id: e7, type: MessageReply, from: ReservationSvc, to: PaymentSvc, label: '2.2: preAuthorizeCard()[card_on_file]' }
  - { id: e8, type: MessageReply, from: ReservationSvc, to: ReservationSvc, label: '2.3: setExpiryTimer()' }
  - { id: e9, type: MessageReply, from: Guest, to: BookingUI, label: '3: confirmBooking()' }
  - { id: e10, type: MessageReply, from: BookingUI, to: ReservationSvc, label: '3.1: confirm()' }
  - { id: e11, type: MessageReply, from: ReservationSvc, to: PaymentSvc, label: '3.2: capturePayment()' }
  - { id: e12, type: MessageReply, from: ReservationSvc, to: NotificationSvc, label: '3.3: sendConfirmation()' }
  - { id: e13, type: MessageReply, from: NotificationSvc, to: Guest, label: '3.4: emailConfirmation()' }
diagrams:
  - { id: d1, name: Example Communication - Medium Booking Collaboration, kind: sequence, layoutProvenance: Synthesized }
