# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Use Case Diagram - Complex Banking
elements:
  - { id: cust, type: Actor, name: Customer }
  - { id: teller, type: Actor, name: Teller }
  - { id: fraud, type: Actor, name: FraudOfficer }
  - { id: timer, type: Actor, name: SystemTimer }
  - { id: staff, type: Actor, name: Staff }
  - { id: Bank, type: Boundary, name: Bank }
  - { id: ucAuth, type: UseCase, name: Authenticate, parentId: Bank }
  - { id: ucTransfer, type: UseCase, name: Transfer Funds, parentId: Bank }
  - { id: ucStmt, type: UseCase, name: Request Statement, parentId: Bank }
  - { id: ucFraud, type: UseCase, name: Review Fraud, parentId: Bank }
  - { id: Teller Channel, type: Boundary, name: Teller Channel, parentId: Bank }
  - { id: ucOpen, type: UseCase, name: Open Account, parentId: Teller Channel }
  - { id: ucClose, type: UseCase, name: Close Account, parentId: Teller Channel }
  - { id: ucTDep, type: UseCase, name: Cash Deposit, parentId: Teller Channel }
  - { id: ATM Channel, type: Boundary, name: ATM Channel, parentId: Bank }
  - { id: ucWithdraw, type: UseCase, name: Withdraw Cash, parentId: ATM Channel }
  - { id: ucBal, type: UseCase, name: Check Balance, parentId: ATM Channel }
  - { id: ucMini, type: UseCase, name: Print Mini-Stmt, parentId: ATM Channel }
  - { id: Online Channel, type: Boundary, name: Online Channel, parentId: Bank }
  - { id: ucLogin, type: UseCase, name: Login, parentId: Online Channel }
  - { id: ucBill, type: UseCase, name: Pay Bill, parentId: Online Channel }
  - { id: ucAlert, type: UseCase, name: Set Up Alert, parentId: Online Channel }
  - { id: ucOver, type: UseCase, name: Overdraft Warning, parentId: Bank }
  - { id: ucSms, type: UseCase, name: SMS Notification, parentId: Bank }
  - { id: ~note1, type: Note, name: '<b>«extend» — Overdraft Warning</b>', documentation: '<b>«extend» — Overdraft Warning</b>\nCondition: { transfer exceeds balance }.\nThe base Transfer is valid without it;\nthe warning adds behaviour only when\ntriggered.' }
  - { id: ~note2, type: Note, name: '<b>«include» — Authenticate</b>', documentation: '<b>«include» — Authenticate</b>\nTransfer, Login, and (indirectly via\nBill) other flows MUST authenticate.\nFactoring Authenticate out as an\ninclude keeps each base use case lean\nand centralises the security contract.' }
  - { id: ~note3, type: Note, name: '<b>Non-human actor</b>', documentation: '<b>Non-human actor</b>\nSystemTimer is an actor too — anything\nexternal that initiates behaviour counts,\nincluding schedulers and other systems.' }
edges:
  - { id: e1, type: Generalization, from: teller, to: staff }
  - { id: e2, type: DirectedAssociation, from: cust, to: ucAuth }
  - { id: e3, type: DirectedAssociation, from: cust, to: ucTransfer }
  - { id: e4, type: DirectedAssociation, from: cust, to: ucStmt }
  - { id: e5, type: DirectedAssociation, from: cust, to: ucWithdraw }
  - { id: e6, type: DirectedAssociation, from: cust, to: ucBal }
  - { id: e7, type: DirectedAssociation, from: cust, to: ucLogin }
  - { id: e8, type: DirectedAssociation, from: cust, to: ucBill }
  - { id: e9, type: DirectedAssociation, from: teller, to: ucOpen }
  - { id: e10, type: DirectedAssociation, from: teller, to: ucClose }
  - { id: e11, type: DirectedAssociation, from: teller, to: ucTDep }
  - { id: e12, type: DirectedAssociation, from: fraud, to: ucFraud }
  - { id: e13, type: Include, from: ucTransfer, to: ucAuth }
  - { id: e14, type: Include, from: ucLogin, to: ucAuth }
  - { id: e15, type: Include, from: ucBill, to: ucTransfer }
  - { id: e16, type: Include, from: ucMini, to: ucStmt }
  - { id: e17, type: Extend, from: ucOver, to: ucTransfer }
  - { id: e18, type: Extend, from: ucSms, to: ucWithdraw }
  - { id: e19, type: Extend, from: ucAlert, to: ucSms }
  - { id: e20, type: NoteLink, from: ~note1, to: ucOver }
  - { id: e21, type: NoteLink, from: ~note2, to: ucAuth }
  - { id: e22, type: NoteLink, from: ~note3, to: timer }
diagrams:
  - { id: d1, name: Example Use Case Diagram - Complex Banking, kind: usecase, layoutProvenance: Synthesized }
