@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Simple SysML Package Diagram grouping blocks and value types into packages with dependency and import.
'   usecase:      Teach package grouping, dependency, and «import» relationship (reuses UML package projection).
'   complexity:   simple
'   domain:       methodology
' ============================================================================
title Example Package - Simple Model Organization

package "VehicleModel" {
  package "Blocks" {
    class "Vehicle" <<block>> { }
    class "Wheel" <<block>> { }
    class "Engine" <<block>> { }
  }
  package "ValueTypes" {
    class "Mass" <<valueType>> { }
    class "Length" <<valueType>> { }
  }
  package "UseCases" {
    usecase "Drive" as UC1
  }
}

"Blocks" ..> "ValueTypes" : dependency
"UseCases" ..> "Blocks" : dependency

note right of "ValueTypes"
  Packages group model elements.
  «import» (dashed arrow with stereotype)
  brings names from one package into
  another's namespace. A plain dependency
  (..>) just shows a usage relationship.
end note

@enduml
