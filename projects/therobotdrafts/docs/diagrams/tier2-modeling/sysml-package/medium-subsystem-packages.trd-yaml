# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Package - Medium Subsystem Packages
elements:
  - { id: RobotSystem, type: Package, name: RobotSystem }
  - { id: Requirements, type: Package, name: Requirements, parentId: RobotSystem }
  - { id: Operational, type: Package, name: Operational, parentId: Requirements }
  - { id: '"ReqMotion"  { }', type: Requirement, name: '"ReqMotion"  { }', parentId: Operational }
  - { id: '"ReqPower"  { }', type: Requirement, name: '"ReqPower"  { }', parentId: Operational }
  - { id: Safety, type: Package, name: Safety, parentId: Requirements }
  - { id: '"ReqEStop"  { }', type: Requirement, name: '"ReqEStop"  { }', parentId: Safety }
  - { id: Analysis, type: Package, name: Analysis, parentId: RobotSystem }
  - { id: '"MotionBudget"  { }', type: Block, name: '"MotionBudget"  { }', parentId: Analysis }
  - { id: '"PowerBudget"  { }', type: Block, name: '"PowerBudget"  { }', parentId: Analysis }
  - { id: Design, type: Package, name: Design, parentId: RobotSystem }
  - { id: Mechanical, type: Package, name: Mechanical, parentId: Design }
  - { id: '"Chassis"  { }', type: Block, name: '"Chassis"  { }', parentId: Mechanical }
  - { id: '"DriveTrain"  { }', type: Block, name: '"DriveTrain"  { }', parentId: Mechanical }
  - { id: Electrical, type: Package, name: Electrical, parentId: Design }
  - { id: '"PowerBoard"  { }', type: Block, name: '"PowerBoard"  { }', parentId: Electrical }
  - { id: '"MotorDriver"  { }', type: Block, name: '"MotorDriver"  { }', parentId: Electrical }
  - { id: Software, type: Package, name: Software, parentId: Design }
  - { id: '"MotionController"  { }', type: Block, name: '"MotionController"  { }', parentId: Software }
  - { id: '"SafetyMonitor"  { }', type: Block, name: '"SafetyMonitor"  { }', parentId: Software }
  - { id: ValueTypes, type: Package, name: ValueTypes, parentId: RobotSystem }
  - { id: '"Torque"  { }', type: ValueType, name: '"Torque"  { }', parentId: ValueTypes }
  - { id: '"Current"  { }', type: ValueType, name: '"Current"  { }', parentId: ValueTypes }
  - { id: '"Voltage"  { }', type: ValueType, name: '"Voltage"  { }', parentId: ValueTypes }
  - { id: .Operational, type: Class, name: .Operational }
  - { id: ~note1, type: Note, name: «import» brings public names INTO the, documentation: '«import» brings public names INTO the\nimporting package''s namespace (transitive\nunless marked otherwise).\n«access» is the non-transitive variant:\nnames are reachable but not re-exported.' }
edges:
  - { id: e1, type: Dependency, from: Analysis, to: .Operational, label: access, toMultiplicity: Requirements }
  - { id: e2, type: NoteLink, from: ~note1, to: Analysis }
diagrams:
  - { id: d1, name: Example Package - Medium Subsystem Packages, kind: class, layoutProvenance: Synthesized }
