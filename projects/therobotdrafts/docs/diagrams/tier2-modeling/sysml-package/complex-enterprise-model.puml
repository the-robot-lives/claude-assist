@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex SysML Package Diagram spanning requirements, analysis, and design layers with package generalization and transitive imports across 12+ packages.
'   usecase:      Teach multi-layer enterprise model organization, package generalization, and transitive imports.
'   complexity:   complex
'   domain:       enterprise-systems-engineering
' ============================================================================
title Example Package - Complex Enterprise Model

package "EnterpriseModel" {
  package "StakeholderNeeds" {
    class "MissionNeed" <<requirement>> { }
    class "MarketNeed" <<requirement>> { }
  }

  package "SystemRequirements" {
    class "SysPerf" <<requirement>> { }
    class "SysInterface" <<requirement>> { }
    class "SysConstraint" <<requirement>> { }
  }

  package "SubsystemRequirements" {
    package "AvionicsReqs" {
      class "AvCompute" <<requirement>> { }
      class "AvRedundancy" <<requirement>> { }
    }
    package "PowerReqs" {
      class "PowerBudget" <<requirement>> { }
      class "PowerQuality" <<requirement>> { }
    }
    package "ThermalReqs" {
      class "TempLimit" <<requirement>> { }
      class "CoolingCap" <<requirement>> { }
    }
  }

  package "Analysis" {
    package "PerformanceSim" {
      class "DynamicModel" <<block>> { }
      class "ThermalModel" <<block>> { }
    }
    package "TradeStudies" {
      class "ArchTrade" <<block>> { }
      class "CostTrade" <<block>> { }
    }
  }

  package "Design" {
    package "MechDesign" {
      class "Structure" <<block>> { }
      class "Mechanism" <<block>> { }
    }
    package "ElecDesign" {
      class "PowerDistribution" <<block>> { }
      class "WiringHarness" <<block>> { }
    }
    package "SWDesign" {
      class "FlightSW" <<block>> { }
      class "GndSW" <<block>> { }
    }
  }

  package "Verification" {
    class "TestPlan" <<block>> { }
    class "AnalysisReport" <<block>> { }
  }

  package "CommonTypes" {
    package "ValueTypes" {
      class "Mass" <<valueType>> { }
      class "Power" <<valueType>> { }
      class "Temperature" <<valueType>> { }
    }
    package "Interfaces" {
      class "IDataLink" <<interface>> { }
      class "IPower" <<interface>> { }
    }
  }
}

"StakeholderNeeds" <|-- "SystemRequirements" : package generalization
"SystemRequirements" <|-- "SubsystemRequirements" : package generalization

"SystemRequirements" ..> "StakeholderNeeds" : <<import>>
"SubsystemRequirements" ..> "SystemRequirements" : <<import>>
"Analysis" ..> "SubsystemRequirements" : <<import>>
"Design" ..> "Analysis" : <<import>>
"Verification" ..> "Design" : <<import>>

"Design".MechDesign ..> "CommonTypes".ValueTypes : <<import>>
"Design".ElecDesign ..> "CommonTypes".ValueTypes : <<import>>
"Design".SWDesign ..> "CommonTypes".Interfaces : <<import>>
"Analysis".PerformanceSim ..> "CommonTypes".ValueTypes : <<import>>

note right of "Analysis"
  Package GENERALIZATION (<|--) means the
  specialized package inherits the public
  contents of the general package, modeling
  a refinement hierarchy across layers.
end note

note bottom of "Verification"
  TRANSITIVE IMPORT: Verification -> Design -> Analysis
  -> SubsystemRequirements -> SystemRequirements.
  Names imported at the top ripple down the
  chain, so Verification can reference needs
  and requirements without direct imports.
end note

@enduml
