# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Package - SysML vs UML Package
elements:
  - { id: SysML-labeled tree, type: Package, name: SysML-labeled tree }
  - { id: SysModel, type: Package, name: SysModel, parentId: SysML-labeled tree }
  - { id: Blocks, type: Package, name: Blocks, parentId: SysModel }
  - { id: '"Sensor"  { }', type: Block, name: '"Sensor"  { }', parentId: Blocks }
  - { id: '"Controller"  { }', type: Block, name: '"Controller"  { }', parentId: Blocks }
  - { id: ValueTypes, type: Package, name: ValueTypes, parentId: SysModel }
  - { id: '"Voltage"  { }', type: ValueType, name: '"Voltage"  { }', parentId: ValueTypes }
  - { id: Requirements, type: Package, name: Requirements, parentId: SysModel }
  - { id: '"R1"  { }', type: Requirement, name: '"R1"  { }', parentId: Requirements }
  - { id: UML-labeled tree (same shape), type: Package, name: UML-labeled tree (same shape) }
  - { id: UmlModel, type: Package, name: UmlModel, parentId: UML-labeled tree (same shape) }
  - { id: Classes, type: Package, name: Classes, parentId: UmlModel }
  - { id: '"Sensor" { }', type: Class, name: SensorUML, parentId: Classes }
  - { id: '"Controller" { }', type: Class, name: ControllerUML, parentId: Classes }
  - { id: DataTypes, type: Package, name: DataTypes, parentId: UmlModel }
  - { id: '"Voltage" { }', type: Class, name: VoltageUML, parentId: DataTypes }
