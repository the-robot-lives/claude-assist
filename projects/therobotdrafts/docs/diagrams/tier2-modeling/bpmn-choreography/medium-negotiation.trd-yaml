# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Choreography - Negotiation
elements:
  - { id: Start, type: UseCase, name: Start }
  - { id: EndAccept, type: UseCase, name: EndAccept }
  - { id: EndReject, type: UseCase, name: EndReject }
  - { id: T1, type: Package, name: 'Request Quote\n[ Buyer | Seller ]' }
  - { id: T2, type: Package, name: 'Send Quote\n[ Seller | Buyer ]' }
  - { id: T3, type: Package, name: 'Counter Offer\n[ Buyer | Seller ]' }
  - { id: T4, type: Package, name: 'Evaluate Offer\n[ Seller | Buyer ]' }
  - { id: T5, type: Package, name: 'Accept Quote\n[ Buyer | Seller ]' }
  - { id: T6, type: Package, name: 'Issue PO\n[ Buyer | Seller ]' }
  - { id: X1, type: UseCase, name: 'Acceptable?' }
  - { id: ~note1, type: Note, name: '<b>Message variables</b>', documentation: '<b>Message variables</b>\nT1 establishes QuoteId; later\ntasks reference it. Price\nvariable is updated by T2/T3.' }
  - { id: ~note2, type: Note, name: '<b>Gateway on message data</b>', documentation: '<b>Gateway on message data</b>\nBranch condition reads a\nvariable (e.g. Price <= Budget).' }
  - { id: ~note3, type: Note, name: '<b>Role swap</b>', documentation: '<b>Role swap</b>\nSeller initiates the evaluation\nmessage; Buyer responds with\nacceptance or new counter.' }
edges:
  - { id: e1, type: DirectedAssociation, from: Start, to: T1 }
  - { id: e2, type: DirectedAssociation, from: T1, to: T2 }
  - { id: e3, type: DirectedAssociation, from: T2, to: X1 }
  - { id: e4, type: DirectedAssociation, from: X1, to: T5, label: (buyer accepts) }
  - { id: e5, type: DirectedAssociation, from: X1, to: T3, label: (buyer counters) }
  - { id: e6, type: DirectedAssociation, from: T3, to: T4 }
  - { id: e7, type: DirectedAssociation, from: T4, to: X1, label: re-evaluate }
  - { id: e8, type: DirectedAssociation, from: T5, to: T6 }
  - { id: e9, type: DirectedAssociation, from: T6, to: EndAccept }
  - { id: e10, type: DirectedAssociation, from: T4, to: EndReject, label: (seller rejects) }
  - { id: e11, type: NoteLink, from: ~note1, to: T1 }
  - { id: e12, type: NoteLink, from: ~note2, to: X1 }
  - { id: e13, type: NoteLink, from: ~note3, to: T4 }
diagrams:
  - { id: d1, name: Example BPMN Choreography - Negotiation, kind: usecase, layoutProvenance: Synthesized }
