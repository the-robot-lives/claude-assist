# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Choreography - Simple Handshake
elements:
  - { id: Start, type: UseCase, name: Start }
  - { id: End1, type: UseCase, name: End1 }
  - { id: CT1, type: Package, name: 'Request Greeting\n[ Buyer | Seller ]' }
  - { id: CT2, type: Package, name: 'Return Quote\n[ Seller | Buyer ]' }
  - { id: CT3, type: Package, name: 'Confirm Order\n[ Buyer | Seller ]' }
  - { id: ~note1, type: Note, name: '<b>Choreography task</b>', documentation: '<b>Choreography task</b>\nTop band (white)  = <b>Buyer</b> (initiator)\nBottom band (grey)= <b>Seller</b> (responder)\nTask carries the message(s):\nBuyer -> Seller : "Hello"' }
  - { id: ~note2, type: Note, name: 'Roles swap:', documentation: 'Roles swap:\nSeller initiates the\nreturn quote, Buyer responds.' }
  - { id: ~note3, type: Note, name: '<b>Key difference</b>', documentation: '<b>Key difference</b>\nNo enclosing pool. The\nchoreography IS the\ncollaboration''s protocol.' }
edges:
  - { id: e1, type: DirectedAssociation, from: Start, to: CT1 }
  - { id: e2, type: DirectedAssociation, from: CT1, to: CT2 }
  - { id: e3, type: DirectedAssociation, from: CT2, to: CT3 }
  - { id: e4, type: DirectedAssociation, from: CT3, to: End1 }
  - { id: e5, type: NoteLink, from: ~note1, to: CT1 }
  - { id: e6, type: NoteLink, from: ~note2, to: CT2 }
  - { id: e7, type: NoteLink, from: ~note3, to: Start }
diagrams:
  - { id: d1, name: Example BPMN Choreography - Simple Handshake, kind: usecase, layoutProvenance: Synthesized }
