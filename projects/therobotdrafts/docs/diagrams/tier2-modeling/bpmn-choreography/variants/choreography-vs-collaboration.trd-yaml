# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Choreography - Choreography vs Collaboration (Variant)
elements:
  - { id: ChStart, type: UseCase, name: ChStart }
  - { id: ChEnd, type: UseCase, name: ChEnd }
  - { id: CT1, type: Package, name: 'Place Order\n[ Buyer | Seller ]' }
  - { id: CT2, type: Package, name: 'Acknowledge\n[ Seller | Buyer ]' }
  - { id: CT3, type: Package, name: 'Ship Goods\n[ Seller | Buyer ]' }
  - { id: CT4, type: Package, name: 'Send Payment\n[ Buyer | Seller ]' }
  - { id: ~note1, type: Note, name: '<b>Choreography viewpoint</b>', documentation: '<b>Choreography viewpoint</b>\nNo pools. Each task IS the\nexchange, banded by who starts\n(Buyer, white) and who responds\n(Seller, grey). The focus is\nthe CONTRACT between participants.' }
  - { id: P1, type: Boundary, name: '**Buyer**' }
  - { id: Bs, type: UseCase, name: Bs, parentId: P1 }
  - { id: Bt1, type: Boundary, name: Submit Order, parentId: P1 }
  - { id: Bt2, type: Boundary, name: Pay, parentId: P1 }
  - { id: Bt3, type: Boundary, name: Receive Goods, parentId: P1 }
  - { id: Be, type: UseCase, name: Be, parentId: P1 }
  - { id: P2, type: Boundary, name: '**Seller**' }
  - { id: Ss, type: UseCase, name: Ss, parentId: P2 }
  - { id: St1, type: Boundary, name: Accept Order, parentId: P2 }
  - { id: St2, type: Boundary, name: Ship, parentId: P2 }
  - { id: Se, type: UseCase, name: Se, parentId: P2 }
  - { id: ~note2, type: Note, name: '<b>Collaboration viewpoint</b>', documentation: '<b>Collaboration viewpoint</b>\nIndependent pools. Each pool owns\nits internal process; message flows\n(dashed) connect them. The focus is\neach participant''s WORK, glued by\nmessages.' }
  - { id: ~note3, type: Note, name: '<b>When to use which</b>', documentation: '<b>When to use which</b>\nChoreography: protocol/contract\ndesign, multi-party orchestration,\nstandards (e.g. WS-CDL feel).\nCollaboration: each party''s\ninternal behavior + handoffs.' }
edges:
  - { id: e1, type: DirectedAssociation, from: ChStart, to: CT1 }
  - { id: e2, type: DirectedAssociation, from: CT1, to: CT2 }
  - { id: e3, type: DirectedAssociation, from: CT2, to: CT3 }
  - { id: e4, type: DirectedAssociation, from: CT3, to: CT4 }
  - { id: e5, type: DirectedAssociation, from: CT4, to: ChEnd }
  - { id: e6, type: NoteLink, from: ~note1, to: CT1 }
  - { id: e7, type: DirectedAssociation, from: Bs, to: Bt1 }
  - { id: e8, type: DirectedAssociation, from: Bt1, to: Bt2 }
  - { id: e9, type: DirectedAssociation, from: Bt1, to: Bt3 }
  - { id: e10, type: DirectedAssociation, from: Bt3, to: Be }
  - { id: e11, type: DirectedAssociation, from: Bt2, to: Be }
  - { id: e12, type: DirectedAssociation, from: Ss, to: St1 }
  - { id: e13, type: DirectedAssociation, from: St1, to: St2 }
  - { id: e14, type: DirectedAssociation, from: St2, to: Se }
  - { id: e15, type: Dependency, from: Bt1, to: St1, label: '"Order"' }
  - { id: e16, type: Dependency, from: St1, to: Bt1, label: '"Ack"' }
  - { id: e17, type: Dependency, from: St2, to: Bt3, label: '"Goods"' }
  - { id: e18, type: Dependency, from: Bt2, to: St2, label: '"Payment"' }
  - { id: e19, type: NoteLink, from: ~note2, to: P1 }
  - { id: e20, type: NoteLink, from: ~note3, to: P2 }
diagrams:
  - { id: d1, name: Example BPMN Choreography - Choreography vs Collaboration (Variant), kind: usecase, layoutProvenance: Synthesized }
