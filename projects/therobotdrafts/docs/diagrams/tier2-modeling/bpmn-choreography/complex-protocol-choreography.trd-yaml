# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Choreography - Complex Protocol
elements:
  - { id: Start, type: UseCase, name: Start }
  - { id: EndOk, type: UseCase, name: EndOk }
  - { id: EndFail, type: UseCase, name: EndFail }
  - { id: 'Timer '' intermediate timer event', type: UseCase, name: 'Timer '' intermediate timer event' }
  - { id: T1, type: Package, name: 'Submit Order\n[ Buyer | Seller ]' }
  - { id: T2, type: Package, name: 'Ack Order\n[ Seller | Buyer ]' }
  - { id: T3, type: Package, name: 'Check Stock\n[ Seller | Warehouse ]' }
  - { id: T4, type: Package, name: 'Quote Shipping\n[ Seller | Logistics ]' }
  - { id: T5, type: Package, name: 'Send Quote\n[ Logistics | Seller ]' }
  - { id: T6, type: Package, name: 'Request Payment\n[ Seller | Buyer ]' }
  - { id: T7, type: Package, name: 'Authorize Payment\n[ Buyer | Bank ]' }
  - { id: T8, type: Package, name: 'Send Confirmation\n[ Bank | Seller ]' }
  - { id: SUB1, type: Package, name: 'Fulfillment Sub-Choreography [+]\n[ Seller | Logistics ]' }
  - { id: T10, type: Package, name: 'Confirm Shipment\n[ Logistics | Buyer ]' }
  - { id: T11, type: Package, name: 'Close Order\n[ Seller | Buyer ]' }
  - { id: T12, type: Package, name: 'Cancel Order\n[ Seller | Buyer ]' }
  - { id: X1, type: UseCase, name: 'In Stock?' }
  - { id: Eb1, type: UseCase, name: 'Pay On Time?' }
  - { id: Timer, type: Actor, name: Timer }
  - { id: ~note1, type: Note, name: '<b>Sub-choreography (+)</b>', documentation: '<b>Sub-choreography (+)</b>\nCollapsed band group; its own\nparticipant-to-participant\nprotocol (pickup, transport,\ndelivery handshakes).' }
  - { id: ~note2, type: Note, name: '<b>Event-based gateway</b>', documentation: '<b>Event-based gateway</b>\nRace: Buyer''s payment vs a\n24-hour timer. First wins;\nthe other is cancelled.' }
  - { id: ~note3, type: Note, name: '<b>Timer intermediate event</b>', documentation: '<b>Timer intermediate event</b>\nDetects the buyer failed to\npay within the SLA window.' }
  - { id: ~note4, type: Note, name: '<b>Multi-party choreography</b>', documentation: '<b>Multi-party choreography</b>\nFour participants, banded per\ntask. Roles (initiator/responder)\ncan swap between tasks.' }
edges:
  - { id: e1, type: DirectedAssociation, from: Start, to: T1 }
  - { id: e2, type: DirectedAssociation, from: T1, to: T2 }
  - { id: e3, type: DirectedAssociation, from: T2, to: T3 }
  - { id: e4, type: DirectedAssociation, from: T3, to: X1 }
  - { id: e5, type: DirectedAssociation, from: X1, to: T4, label: (yes) }
  - { id: e6, type: DirectedAssociation, from: X1, to: T12, label: (no) }
  - { id: e7, type: DirectedAssociation, from: T4, to: T5 }
  - { id: e8, type: DirectedAssociation, from: T5, to: T6 }
  - { id: e9, type: DirectedAssociation, from: T6, to: Eb1 }
  - { id: e10, type: DirectedAssociation, from: Eb1, to: T7, label: Buyer pays }
  - { id: e11, type: DirectedAssociation, from: Eb1, to: Timer, label: 24h timeout }
  - { id: e12, type: DirectedAssociation, from: Timer, to: T12 }
  - { id: e13, type: DirectedAssociation, from: T7, to: T8 }
  - { id: e14, type: DirectedAssociation, from: T8, to: SUB1 }
  - { id: e15, type: DirectedAssociation, from: SUB1, to: T10 }
  - { id: e16, type: DirectedAssociation, from: T10, to: T11 }
  - { id: e17, type: DirectedAssociation, from: T11, to: EndOk }
  - { id: e18, type: DirectedAssociation, from: T12, to: EndFail }
  - { id: e19, type: NoteLink, from: ~note1, to: SUB1 }
  - { id: e20, type: NoteLink, from: ~note2, to: Eb1 }
  - { id: e21, type: NoteLink, from: ~note3, to: Timer }
  - { id: e22, type: NoteLink, from: ~note4, to: T3 }
diagrams:
  - { id: d1, name: Example BPMN Choreography - Complex Protocol, kind: usecase, layoutProvenance: Synthesized }
