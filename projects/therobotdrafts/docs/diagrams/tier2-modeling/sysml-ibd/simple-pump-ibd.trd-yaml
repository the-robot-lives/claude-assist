# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example IBD - Simple Pump Interior
elements:
  - { id: HydraulicPump, type: Block, name: HydraulicPump }
  - { id: HydraulicPump interior, type: Package, name: HydraulicPump interior }
  - { id: pMotor, type: Class, name: 'pMotor : Motor', parentId: HydraulicPump interior }
  - { id: pChamber, type: Class, name: 'pChamber : PumpChamber', parentId: HydraulicPump interior }
  - { id: pOutlet, type: Class, name: 'pOutlet : OutletValve', parentId: HydraulicPump interior }
  - { id: inPwr, type: Class, name: inPwr }
  - { id: outFlow, type: Class, name: outFlow }
  - { id: ~note1, type: Note, name: 'Each box is a PART (role:Type).', documentation: 'Each box is a PART (role:Type).\nThe enclosing frame IS the block\nHydraulicPump; the parts compose it.' }
  - { id: ~note2, type: Note, name: 'Boundary ports (inPwr, outFlow)', documentation: 'Boundary ports (inPwr, outFlow)\nare the block''s interaction points\nvisible from outside.' }
edges:
  - { id: e1, type: DirectedAssociation, from: inPwr, to: pMotor, label: power }
  - { id: e2, type: DirectedAssociation, from: pMotor, to: pChamber, label: shaft }
  - { id: e3, type: DirectedAssociation, from: pChamber, to: pOutlet, label: fluid }
  - { id: e4, type: DirectedAssociation, from: pOutlet, to: outFlow, label: flow }
  - { id: e5, type: NoteLink, from: ~note1, to: pMotor }
  - { id: e6, type: NoteLink, from: ~note2, to: outFlow }
diagrams:
  - { id: d1, name: Example IBD - Simple Pump Interior, kind: class, layoutProvenance: Synthesized }
