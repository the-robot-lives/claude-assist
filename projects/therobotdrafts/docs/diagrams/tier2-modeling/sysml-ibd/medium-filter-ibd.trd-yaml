# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example IBD - Medium Filter Internals
elements:
  - { id: FluidFilter, type: Block, name: FluidFilter }
  - { id: FluidFilter interior, type: Package, name: FluidFilter interior }
  - { id: fInlet, type: Class, name: 'fInlet : InletPort' }
  - { id: fPreFilter, type: Class, name: 'fPreFilter : PreFilterMesh' }
  - { id: fCartridge, type: Class, name: 'fCartridge : CarbonCartridge' }
  - { id: fSensor, type: Class, name: 'fSensor : PressureSensor' }
  - { id: fBypass, type: Class, name: 'fBypass : BypassValve' }
  - { id: fOutlet, type: Class, name: 'fOutlet : OutletPort' }
  - { id: supply, type: Lifeline, name: supply }
  - { id: ret, type: Lifeline, name: ret }
  - { id: telemetry, type: Lifeline, name: telemetry }
  - { id: ~note1, type: Note, name: 'Delegation connector: boundary port', documentation: 'Delegation connector: boundary port\ninternal part fInlet. Item flow type\nis carried on the connector.' }
  - { id: ~note2, type: Note, name: Flow ports carry an item flow (here FluidFlow)., documentation: 'Flow ports carry an item flow (here FluidFlow).\nConnectors between flow ports transmit that\nitem type end-to-end.' }
edges:
  - { id: e1, type: MessageReply, from: supply, to: fInlet, label: FluidFlow }
  - { id: e2, type: MessageReply, from: fInlet, to: fPreFilter, label: FluidFlow }
  - { id: e3, type: MessageReply, from: fPreFilter, to: fCartridge, label: FluidFlow }
  - { id: e4, type: MessageReply, from: fCartridge, to: fBypass, label: FluidFlow }
  - { id: e5, type: MessageReply, from: fBypass, to: fOutlet, label: FluidFlow }
  - { id: e6, type: MessageReply, from: fOutlet, to: ret, label: FluidFlow }
  - { id: e7, type: MessageReply, from: fSensor, to: fCartridge, label: senses }
  - { id: e8, type: MessageReply, from: fSensor, to: telemetry, label: PressureReading }
  - { id: e9, type: NoteLink, from: ~note1, to: supply }
  - { id: e10, type: NoteLink, from: ~note2, to: fBypass }
diagrams:
  - { id: d1, name: Example IBD - Medium Filter Internals, kind: sequence, layoutProvenance: Synthesized }
