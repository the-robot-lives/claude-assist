# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example IBD - IBD vs UML Composite Structure
elements:
  - { id: SysML Internal Block Diagram, type: Package, name: SysML Internal Block Diagram }
  - { id: ControllerBox, type: Block, name: ControllerBox, parentId: SysML Internal Block Diagram }
  - { id: ControllerBox interior, type: Package, name: ControllerBox interior, parentId: SysML Internal Block Diagram }
  - { id: cInput, type: Class, name: 'cInput : InputStage', parentId: ControllerBox interior }
  - { id: cProc, type: Class, name: 'cProc : Processor', parentId: ControllerBox interior }
  - { id: cDriver, type: Class, name: 'cDriver : OutputDriver', parentId: ControllerBox interior }
  - { id: sensorIn, type: Class, name: sensorIn, parentId: SysML Internal Block Diagram }
  - { id: actuatorOut, type: Class, name: actuatorOut, parentId: SysML Internal Block Diagram }
  - { id: UML Composite Structure, type: Package, name: UML Composite Structure }
  - { id: uInput, type: Class, name: 'uInput : InputStage', parentId: UML Composite Structure }
  - { id: uProc, type: Class, name: 'uProc : Processor', parentId: UML Composite Structure }
  - { id: uDriver, type: Class, name: 'uDriver : OutputDriver', parentId: UML Composite Structure }
  - { id: ~note1, type: Note, name: 'SysML IBD adds over UML composite structure:', documentation: 'SysML IBD adds over UML composite structure:\n- FLOW PORTS with direction (in/out) carrying an item flow type\n(e.g. sensorIn carries SampleStream)\n- ITEM FLOW labels on connectors naming the substance moving\n(DigitalSignal, DriveCurrent)\nUML composite has parts, ports, and connectors but NO typed\nitem flow and NO directional flow ports — only generic links.' }
edges:
  - { id: e1, type: DirectedAssociation, from: sensorIn, to: cInput, label: SampleStream }
  - { id: e2, type: DirectedAssociation, from: cInput, to: cProc, label: DigitalSignal }
  - { id: e3, type: DirectedAssociation, from: cProc, to: cDriver, label: CommandWord }
  - { id: e4, type: DirectedAssociation, from: cDriver, to: actuatorOut, label: DriveCurrent }
  - { id: e5, type: Composition, from: ControllerBox, to: uInput }
  - { id: e6, type: Composition, from: ControllerBox, to: uProc }
  - { id: e7, type: Composition, from: ControllerBox, to: uDriver }
  - { id: e8, type: DirectedAssociation, from: uInput, to: uProc, label: signal }
  - { id: e9, type: DirectedAssociation, from: uProc, to: uDriver, label: command }
  - { id: e10, type: NoteLink, from: ~note1, to: ControllerBox }
diagrams:
  - { id: d1, name: Example IBD - IBD vs UML Composite Structure, kind: class, layoutProvenance: Synthesized }
