  - { id: ~note1, type: Note, name: '<b>Requirement box convention:</b>', documentation: '<b>Requirement box convention:</b>\n- id : the requirement identifier\n- text : the "shall" statement\n- Optional: source, verifyMethod,\nrisk, status.' }
