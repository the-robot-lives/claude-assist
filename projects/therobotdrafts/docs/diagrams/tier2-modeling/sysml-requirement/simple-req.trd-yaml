# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example SysML Requirement - Simple Satisfaction
elements:
  - { id: Max Payload, type: Requirement, name: Max Payload, members: [{ name: id, isOperation: false, visibility: Public, type: REQ-001, rawText: 'id : REQ-001' }, { name: text, isOperation: false, visibility: Public, type: '"The robot shall lift at least 5 kg."', rawText: 'text : "The robot shall lift at least 5 kg."' }] }
  - { id: Reach Distance, type: Requirement, name: Reach Distance, members: [{ name: id, isOperation: false, visibility: Public, type: REQ-002, rawText: 'id : REQ-002' }, { name: text, isOperation: false, visibility: Public, type: '"The robot shall reach 1.2 m horizontally."', rawText: 'text : "The robot shall reach 1.2 m horizontally."' }] }
  - { id: Cycle Time, type: Requirement, name: Cycle Time, members: [{ name: id, isOperation: false, visibility: Public, type: REQ-003, rawText: 'id : REQ-003' }, { name: text, isOperation: false, visibility: Public, type: '"The robot shall complete a cycle in under 10 s."', rawText: 'text : "The robot shall complete a cycle in under 10 s."' }] }
