# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example SysML Requirement - Graph vs Traceability Matrix (Variant)
elements:
  - { id: '"ROOT"  { id : REQ-R }', type: Requirement, name: '"ROOT"  { id : REQ-R }' }
  - { id: '"REQ-A"  { id : REQ-A1 }', type: Requirement, name: '"REQ-A"  { id : REQ-A1 }' }
  - { id: '"REQ-B"  { id : REQ-B1 }', type: Requirement, name: '"REQ-B"  { id : REQ-B1 }' }
  - { id: Block1, type: Block, name: Block1 }
  - { id: Block2, type: Block, name: Block2 }
  - { id: '"Test1"  { id : T1 }', type: TestCase, name: '"Test1"  { id : T1 }' }
  - { id: '"Test2"  { id : T2 }', type: TestCase, name: '"Test2"  { id : T2 }' }
  - { id: ~note1, type: Note, name: '<b>Graph view — best when:</b>', documentation: '<b>Graph view — best when:</b>\n- Few requirements, rich topology\n- Reading paths/traces aloud\n- Spotting orphan requirements\n- Stakeholder review' }
  - { id: ROOT, type: Class, name: ROOT }
  - { id: ~note2, type: Note, name: '<b>Matrix view — best when:</b>', documentation: '<b>Matrix view — best when:</b>\n- Hundreds/thousands of requirements\n- Auditing coverage cell-by-cell\n- Compliance reporting (X cell empty = gap)\n- Tabular tooling (DOORS, Jama, etc.)' }
  - { id: REQ-B, type: Class, name: REQ-B }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: ROOT }
  - { id: e2, type: NoteLink, from: ~note2, to: REQ-B }
diagrams:
  - { id: d1, name: Example SysML Requirement - Graph vs Traceability Matrix (Variant), kind: class, layoutProvenance: Synthesized }
