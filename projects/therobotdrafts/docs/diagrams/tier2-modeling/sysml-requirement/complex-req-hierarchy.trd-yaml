# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example SysML Requirement - Complex Hierarchy
elements:
  - { id: 'M: Mission Success', type: Requirement, name: 'M: Mission Success', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-M1, rawText: 'id : REQ-M1' }, { name: text, isOperation: false, visibility: Public, type: '"The mission shall achieve all primary objectives."', rawText: 'text : "The mission shall achieve all primary objectives."' }] }
  - { id: 'M: Crew Safety', type: Requirement, name: 'M: Crew Safety', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-M2, rawText: 'id : REQ-M2' }, { name: text, isOperation: false, visibility: Public, type: '"The mission shall preserve crew safety with P > 0.9999."', rawText: 'text : "The mission shall preserve crew safety with P > 0.9999."' }] }
  - { id: 'O: Reach Orbit', type: Requirement, name: 'O: Reach Orbit', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-O1, rawText: 'id : REQ-O1' }, { name: text, isOperation: false, visibility: Public, type: '"The launch vehicle shall deliver 10 t to LEO."', rawText: 'text : "The launch vehicle shall deliver 10 t to LEO."' }] }
  - { id: 'O: Re-entry Recovery', type: Requirement, name: 'O: Re-entry Recovery', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-O2, rawText: 'id : REQ-O2' }, { name: text, isOperation: false, visibility: Public, type: '"The crew module shall survive re-entry and splash down."', rawText: 'text : "The crew module shall survive re-entry and splash down."' }] }
  - { id: 'O: Comms Link', type: Requirement, name: 'O: Comms Link', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-O3, rawText: 'id : REQ-O3' }, { name: text, isOperation: false, visibility: Public, type: '"Telemetry shall be available for 95% of the mission."', rawText: 'text : "Telemetry shall be available for 95% of the mission."' }] }
  - { id: 'S: Thrust Profile', type: Requirement, name: 'S: Thrust Profile', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-S1, rawText: 'id : REQ-S1' }, { name: text, isOperation: false, visibility: Public, type: '"Engines shall produce 9 MN total thrust at sea level."', rawText: 'text : "Engines shall produce 9 MN total thrust at sea level."' }] }
  - { id: 'S: Heat Shield', type: Requirement, name: 'S: Heat Shield', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-S2, rawText: 'id : REQ-S2' }, { name: text, isOperation: false, visibility: Public, type: '"The TPS shall withstand 3000 K peak."', rawText: 'text : "The TPS shall withstand 3000 K peak."' }] }
  - { id: 'S: Antenna Gain', type: Requirement, name: 'S: Antenna Gain', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-S3, rawText: 'id : REQ-S3' }, { name: text, isOperation: false, visibility: Public, type: '"The S-band antenna shall provide 30 dBi gain."', rawText: 'text : "The S-band antenna shall provide 30 dBi gain."' }] }
  - { id: 'S: Avionics Redundancy', type: Requirement, name: 'S: Avionics Redundancy', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-S4, rawText: 'id : REQ-S4' }, { name: text, isOperation: false, visibility: Public, type: '"Flight computers shall be triple-redundant."', rawText: 'text : "Flight computers shall be triple-redundant."' }] }
  - { id: 'C: Engine Bell Alloy', type: Requirement, name: 'C: Engine Bell Alloy', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-C1, rawText: 'id : REQ-C1' }, { name: text, isOperation: false, visibility: Public, type: '"The nozzle alloy shall sustain 1100 K continuous."', rawText: 'text : "The nozzle alloy shall sustain 1100 K continuous."' }] }
  - { id: 'C: Ablator Density', type: Requirement, name: 'C: Ablator Density', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-C2, rawText: 'id : REQ-C2' }, { name: text, isOperation: false, visibility: Public, type: '"Ablator density shall be 0.3 g/cc nominal."', rawText: 'text : "Ablator density shall be 0.3 g/cc nominal."' }] }
  - { id: 'C: RF Amp Output', type: Requirement, name: 'C: RF Amp Output', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-C3, rawText: 'id : REQ-C3' }, { name: text, isOperation: false, visibility: Public, type: '"RF amplifier shall deliver 20 W saturated."', rawText: 'text : "RF amplifier shall deliver 20 W saturated."' }] }
  - { id: 'C: Voter Logic', type: Requirement, name: 'C: Voter Logic', members: [{ name: id, isOperation: false, visibility: Public, type: REQ-C4, rawText: 'id : REQ-C4' }, { name: text, isOperation: false, visibility: Public, type: '"Voting shall mask a single fault within 10 ms."', rawText: 'text : "Voting shall mask a single fault within 10 ms."' }] }
  - { id: EngineBell, type: Block, name: EngineBell }
  - { id: HeatShield, type: Block, name: HeatShield }
  - { id: RFAmplifier, type: Block, name: RFAmplifier }
  - { id: FlightComputer, type: Block, name: FlightComputer }
  - { id: '"EngineStaticFire"  { id : TC-501 }', type: TestCase, name: '"EngineStaticFire"  { id : TC-501 }' }
  - { id: '"ArcJetTest"  { id : TC-502 }', type: TestCase, name: '"ArcJetTest"  { id : TC-502 }' }
  - { id: '"RFRangeTest"  { id : TC-503 }', type: TestCase, name: '"RFRangeTest"  { id : TC-503 }' }
  - { id: '"FaultInjectionBench"  { id : TC-504 }', type: TestCase, name: '"FaultInjectionBench"  { id : TC-504 }' }
  - { id: ~note1, type: Note, name: '<b>Rationale:</b>', documentation: '<b>Rationale:</b>\nDensity cap trades mass for\ninsulation performance; chosen\nvia arc-jet trade study ARC-22.' }
  - { id: ~note2, type: Note, name: '<b>Rationale:</b>', documentation: '<b>Rationale:</b>\nTriple modular redundancy selected\nover duplex for single-fault masking\nwithout reversion logic complexity.' }
  - { id: ~note3, type: Note, name: '<b>Edge legend:</b>', documentation: '<b>Edge legend:</b>\n«deriveReqt» «satisfy» «verify»\n«refine» «trace» «copy»' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: 'C: Ablator Density' }
  - { id: e2, type: NoteLink, from: ~note2, to: 'S: Avionics Redundancy' }
  - { id: e3, type: NoteLink, from: ~note3, to: 'C: Engine Bell Alloy' }
diagrams:
  - { id: d1, name: Example SysML Requirement - Complex Hierarchy, kind: class, layoutProvenance: Synthesized }
