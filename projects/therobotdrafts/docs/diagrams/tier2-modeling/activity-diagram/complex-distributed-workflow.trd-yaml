# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Activity - Complex Distributed Workflow
elements:
  - { id: ~start1, type: StateStart, name: start }
  - { id: ~act2, type: Activity, name: Receive service request }
  - { id: ~act3, type: Activity, name: Authenticate caller }
  - { id: ~dec4, type: Decision, name: 'Authorized?' }
  - { id: ~act5, type: Activity, name: Return 401 Unauthorized }
