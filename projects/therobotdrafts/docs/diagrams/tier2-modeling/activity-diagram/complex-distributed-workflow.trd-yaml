  - { id: ~act7, type: Activity, name: Parse request payload }
  - { id: ~act8, type: Activity, name: Validate schema }
  - { id: ~act9, type: Activity, name: Run risk assessment }
  - { id: ~note10, type: Note, name: '<<call-behavior>>', documentation: '<<call-behavior>>\nInvokes nested activity:\n"RiskAssessment" (rake glyph).\nSee: risk-assessment.puml' }
  - { id: ~fork11, type: ForkJoin, name: fork }
  - { id: ~act12, type: Activity, name: Enrich data via Service A }
  - { id: ~act13, type: Activity, name: Enrich data via Service B }
  - { id: ~act14, type: Activity, name: Fetch user profile }
  - { id: ~join15, type: ForkJoin, name: join }
  - { id: ~act16, type: Activity, name: 'Publish "OrderPending" event' }
  - { id: ~note17, type: Note, name: '<<send-signal>>\nemits to message bus', documentation: '<<send-signal>>\nemits to message bus' }
  - { id: ~act18, type: Activity, name: Wait for inventory confirmation }
  - { id: ~note19, type: Note, name: '<<accept-event>>\nblocks until signal arrives', documentation: '<<accept-event>>\nblocks until signal arrives' }
  - { id: ~dec20, type: Decision, name: 'Inventory confirmed?' }
  - { id: ~dec21, type: Decision, name: 'All enrichments ready?' }
  - { id: ~act22, type: Activity, name: Compose full response }
  - { id: ~act23, type: Activity, name: Persist result }
  - { id: ~act24, type: Activity, name: 'Publish "OrderConfirmed" event' }
  - { id: ~note25, type: Note, name: '<<send-signal>>', documentation: '<<send-signal>>' }
  - { id: ~act26, type: Activity, name: Compose partial response }
  - { id: ~act27, type: Activity, name: Log timeout warning }
  - { id: ~act28, type: Activity, name: Compensate prior steps }
  - { id: ~act29, type: Activity, name: 'Publish "OrderFailed" event' }
  - { id: ~note30, type: Note, name: '<<send-signal>>', documentation: '<<send-signal>>' }
  - { id: ~act31, type: Activity, name: Record audit trail }
  - { id: ~end32, type: StateEnd, name: end }
