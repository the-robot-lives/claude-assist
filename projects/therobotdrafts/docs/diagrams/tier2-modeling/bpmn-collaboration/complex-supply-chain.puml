@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex BPMN collaboration — 4 pools, event-based gateways, data flow.
'   usecase:      Supply chain: Buyer, Supplier, Logistics, Bank with message races.
'   complexity:   complex
'   domain:       business-process
' ============================================================================
title Example BPMN Collaboration - Supply Chain

' PlantUML has no native BPMN. Shape mapping:
'   rectangle (pool)    = participant
'   rectangle (in pool) = task
'   circle thin         = start event
'   circle double       = intermediate (message/timer/signal)
'   circle thick        = end event
'   usecase diamond     = gateway
'   database            = data store
'   -->                 = sequence flow (within pool)
'   ..>                 = message flow (across pools)

database "Order Ledger" as Ledger

rectangle "**Buyer**" as P1 {
  usecase " " as B_start
  rectangle "Issue PO" as B1
  usecase "Wait For" as Eb1
  rectangle "Receive Shipment" as B2
  rectangle "Send Payment" as B3
  usecase " " as B_end
  B_start --> B1
  B1 --> Eb1
  Eb1 --> B2 : shipment arrives
  Eb1 --> B_end : 14d cancel
  B2 --> B3
  B3 --> B_end
}

rectangle "**Supplier**" as P2 {
  usecase " " as S_start
  rectangle "Acknowledge PO" as S1
  rectangle "Pick Goods" as S2
  usecase "Split (AND)" as S_and
  rectangle "Notify Logistics" as S3
  rectangle "Prepare Invoice" as S4
  usecase " " as S_end
  S_start --> S1
  S1 --> S2
  S2 --> S_and
  S_and --> S3
  S_and --> S4
  S3 --> S_end
  S4 --> S_end
}

rectangle "**Logistics**" as P3 {
  usecase " " as L_start
  rectangle "Schedule Pickup" as L1
  rectangle "Transport" as L2
  rectangle "Confirm Delivery" as L3
  usecase " " as L_end
  L_start --> L1
  L1 --> L2
  L2 --> L3
  L3 --> L_end
}

rectangle "**Bank**" as P4 {
  usecase " " as K_start
  rectangle "Receive Invoice" as K1
  rectangle "Settle Payment" as K2
  usecase " " as K_end
  K_start --> K1
  K1 --> K2
  K2 --> K_end
}

' --- Message flows (cross-pool, dashed) ----------------------------------
B1 ..> S1 : "Purchase Order"
S1 ..> B1 : "Ack"
S3 ..> L1 : "Pickup Request"
L3 ..> B2 : "Delivery Notice"
L3 ..> S1 : "Delivered"
S4 ..> K1 : "Invoice"
K2 ..> S_end : "Funds"

' --- Data flow ------------------------------------------------------------
B1 --> Ledger : write PO
L3 --> Ledger : write delivery
K2 --> Ledger : write settlement

note top of Eb1
  <b>Event-based gateway</b>
  Buyer waits for either shipment
  or a 14-day timeout — whichever
  fires first cancels the other.
end note

note right of S_and
  <b>Parallel (AND) gateway</b>
  Supplier notifies logistics and
  prepares invoice concurrently.
end note

note bottom of Ledger
  <b>Data store</b>
  Shared ledger persists cross-
  pool state; pools remain
  decoupled via message flows.
end note

@enduml
