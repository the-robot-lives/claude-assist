# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Collaboration - Black-box vs Expanded (Variant)
elements:
  - { id: BB1, type: Boundary, name: '**Buyer (black-box)**' }
  - { id: BB2, type: Boundary, name: '**Seller (black-box)**' }
  - { id: ~note1, type: Note, name: '<b>Black-box pool</b>', documentation: '<b>Black-box pool</b>\nInternal process hidden.\nUseful when the participant''s\ninternals are out of scope or\nowned by another team.' }
  - { id: EB1, type: Boundary, name: '**Buyer (expanded)**' }
  - { id: Bs, type: UseCase, name: Bs, parentId: EB1 }
  - { id: Bt1, type: Boundary, name: Submit Order, parentId: EB1 }
  - { id: Bt2, type: Boundary, name: Receive Goods, parentId: EB1 }
  - { id: Be, type: UseCase, name: Be, parentId: EB1 }
  - { id: EB2, type: Boundary, name: '**Seller (expanded)**' }
  - { id: Ss, type: UseCase, name: Ss, parentId: EB2 }
  - { id: St1, type: Boundary, name: Accept Order, parentId: EB2 }
  - { id: St2, type: Boundary, name: Ship Goods, parentId: EB2 }
  - { id: Se, type: UseCase, name: Se, parentId: EB2 }
  - { id: ~note2, type: Note, name: '<b>Expanded pool</b>', documentation: '<b>Expanded pool</b>\nInternal tasks visible.\nUse when you own/need to reason\nabout a participant''s internals.' }
  - { id: ~note3, type: Note, name: '<b>Abstraction trade-off</b>', documentation: '<b>Abstraction trade-off</b>\nBlack-box: lighter, focused on\nthe contract. Expanded: heavier,\nexposes sequence flow + events.\nMix freely in one collaboration.' }
edges:
  - { id: e1, type: Dependency, from: BB1, to: BB2, label: '"Order"' }
  - { id: e2, type: Dependency, from: BB2, to: BB1, label: '"Goods"' }
  - { id: e3, type: NoteLink, from: ~note1, to: BB1 }
  - { id: e4, type: DirectedAssociation, from: Bs, to: Bt1 }
  - { id: e5, type: DirectedAssociation, from: Bt1, to: Bt2 }
  - { id: e6, type: DirectedAssociation, from: Bt2, to: Be }
  - { id: e7, type: DirectedAssociation, from: Ss, to: St1 }
  - { id: e8, type: DirectedAssociation, from: St1, to: St2 }
  - { id: e9, type: DirectedAssociation, from: St2, to: Se }
  - { id: e10, type: Dependency, from: Bt1, to: St1, label: '"Order"' }
  - { id: e11, type: Dependency, from: St2, to: Bt2, label: '"Goods"' }
  - { id: e12, type: NoteLink, from: ~note2, to: EB1 }
  - { id: e13, type: NoteLink, from: ~note3, to: EB2 }
diagrams:
  - { id: d1, name: Example BPMN Collaboration - Black-box vs Expanded (Variant), kind: usecase, layoutProvenance: Synthesized }
