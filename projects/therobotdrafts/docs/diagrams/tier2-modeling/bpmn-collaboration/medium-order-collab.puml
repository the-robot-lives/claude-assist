@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Medium BPMN collaboration — 3 pools, internal processes, message-start event.
'   usecase:      Customer/Merchant/Bank order flow with payment authorization.
'   complexity:   medium
'   domain:       business-process
' ============================================================================
title Example BPMN Collaboration - Order (Customer/Merchant/Bank)

' Shape -> BPMN mapping (PlantUML has no native BPMN):
'   rectangle (pool)   = participant pool
'   rectangle (in pool)= task
'   circle thin        = start event
'   circle double      = intermediate event (message)
'   circle thick       = end event
'   usecase diamond    = gateway
'   -->                = sequence flow
'   ..>                = message flow (dashed)

rectangle "**Customer**" as P1 {
  usecase " " as C1s
  rectangle "Browse Catalog" as C1
  rectangle "Submit Order" as C2
  rectangle "Receive Confirmation" as C3
  usecase " " as C1e
  C1s --> C1
  C1 --> C2
  C2 --> C3
  C3 --> C1e
}

rectangle "**Merchant**" as P2 {
  usecase " " as M1s
  rectangle "Receive Order" as M1
  rectangle "Request Payment Auth" as M2
  usecase "Auth OK?" as X1
  rectangle "Prepare Shipment" as M3
  rectangle "Send Confirmation" as M4
  usecase " " as M1e
  M1s --> M1
  M1 --> M2
  M2 --> X1
  X1 --> M3 : (yes)
  X1 --> M1e : (no — cancel)
  M3 --> M4
  M4 --> M1e
}

rectangle "**Bank**" as P3 {
  usecase " " as B1s
  rectangle "Authorize Card" as B1
  rectangle "Reserve Funds" as B2
  usecase " " as B1e
  B1s --> B1
  B1 --> B2
  B2 --> B1e
}

' --- Message flows --------------------------------------------------------
C2 ..> M1 : "Order"
M2 ..> B1 : "Auth Request"
B2 ..> M2 : "Auth Decision"
M4 ..> C3 : "Confirmation"

note top of B1s
  <b>Message-start event</b>
  Bank's process begins when the
  auth-request message arrives.
end note

note right of X1
  <b>Exclusive gateway</b>
  Routes on the bank's decision.
end note

note bottom of P3
  <b>Third pool</b>
  Bank is a separate participant;
  message flows are the only legal
  edges across pool boundaries.
end note

@enduml
