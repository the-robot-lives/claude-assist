# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BPMN Collaboration - Supply Chain
elements:
  - { id: Ledger, type: Database, name: Order Ledger }
  - { id: P1, type: Boundary, name: '**Buyer**' }
  - { id: B_start, type: UseCase, name: B_start, parentId: P1 }
  - { id: B1, type: Boundary, name: Issue PO, parentId: P1 }
  - { id: Eb1, type: UseCase, name: Wait For, parentId: P1 }
  - { id: B2, type: Boundary, name: Receive Shipment, parentId: P1 }
  - { id: B3, type: Boundary, name: Send Payment, parentId: P1 }
  - { id: B_end, type: UseCase, name: B_end, parentId: P1 }
  - { id: P2, type: Boundary, name: '**Supplier**' }
  - { id: S_start, type: UseCase, name: S_start, parentId: P2 }
  - { id: S1, type: Boundary, name: Acknowledge PO, parentId: P2 }
  - { id: S2, type: Boundary, name: Pick Goods, parentId: P2 }
  - { id: S_and, type: UseCase, name: Split (AND), parentId: P2 }
  - { id: S3, type: Boundary, name: Notify Logistics, parentId: P2 }
  - { id: S4, type: Boundary, name: Prepare Invoice, parentId: P2 }
  - { id: S_end, type: UseCase, name: S_end, parentId: P2 }
  - { id: P3, type: Boundary, name: '**Logistics**' }
  - { id: L_start, type: UseCase, name: L_start, parentId: P3 }
  - { id: L1, type: Boundary, name: Schedule Pickup, parentId: P3 }
  - { id: L2, type: Boundary, name: Transport, parentId: P3 }
  - { id: L3, type: Boundary, name: Confirm Delivery, parentId: P3 }
  - { id: L_end, type: UseCase, name: L_end, parentId: P3 }
  - { id: P4, type: Boundary, name: '**Bank**' }
  - { id: K_start, type: UseCase, name: K_start, parentId: P4 }
  - { id: K1, type: Boundary, name: Receive Invoice, parentId: P4 }
  - { id: K2, type: Boundary, name: Settle Payment, parentId: P4 }
  - { id: K_end, type: UseCase, name: K_end, parentId: P4 }
  - { id: ~note1, type: Note, name: '<b>Event-based gateway</b>', documentation: '<b>Event-based gateway</b>\nBuyer waits for either shipment\nor a 14-day timeout — whichever\nfires first cancels the other.' }
  - { id: ~note2, type: Note, name: '<b>Parallel (AND) gateway</b>', documentation: '<b>Parallel (AND) gateway</b>\nSupplier notifies logistics and\nprepares invoice concurrently.' }
  - { id: ~note3, type: Note, name: '<b>Data store</b>', documentation: '<b>Data store</b>\nShared ledger persists cross-\npool state; pools remain\ndecoupled via message flows.' }
edges:
  - { id: e1, type: DirectedAssociation, from: B_start, to: B1 }
  - { id: e2, type: DirectedAssociation, from: B1, to: Eb1 }
  - { id: e3, type: DirectedAssociation, from: Eb1, to: B2, label: shipment arrives }
  - { id: e4, type: DirectedAssociation, from: Eb1, to: B_end, label: 14d cancel }
  - { id: e5, type: DirectedAssociation, from: B2, to: B3 }
  - { id: e6, type: DirectedAssociation, from: B3, to: B_end }
  - { id: e7, type: DirectedAssociation, from: S_start, to: S1 }
  - { id: e8, type: DirectedAssociation, from: S1, to: S2 }
  - { id: e9, type: DirectedAssociation, from: S2, to: S_and }
  - { id: e10, type: DirectedAssociation, from: S_and, to: S3 }
  - { id: e11, type: DirectedAssociation, from: S_and, to: S4 }
  - { id: e12, type: DirectedAssociation, from: S3, to: S_end }
  - { id: e13, type: DirectedAssociation, from: S4, to: S_end }
  - { id: e14, type: DirectedAssociation, from: L_start, to: L1 }
  - { id: e15, type: DirectedAssociation, from: L1, to: L2 }
  - { id: e16, type: DirectedAssociation, from: L2, to: L3 }
  - { id: e17, type: DirectedAssociation, from: L3, to: L_end }
  - { id: e18, type: DirectedAssociation, from: K_start, to: K1 }
  - { id: e19, type: DirectedAssociation, from: K1, to: K2 }
  - { id: e20, type: DirectedAssociation, from: K2, to: K_end }
  - { id: e21, type: Dependency, from: B1, to: S1, label: '"Purchase Order"' }
  - { id: e22, type: Dependency, from: S1, to: B1, label: '"Ack"' }
  - { id: e23, type: Dependency, from: S3, to: L1, label: '"Pickup Request"' }
  - { id: e24, type: Dependency, from: L3, to: B2, label: '"Delivery Notice"' }
  - { id: e25, type: Dependency, from: L3, to: S1, label: '"Delivered"' }
  - { id: e26, type: Dependency, from: S4, to: K1, label: '"Invoice"' }
  - { id: e27, type: Dependency, from: K2, to: S_end, label: '"Funds"' }
  - { id: e28, type: DirectedAssociation, from: B1, to: Ledger, label: write PO }
  - { id: e29, type: DirectedAssociation, from: L3, to: Ledger, label: write delivery }
  - { id: e30, type: DirectedAssociation, from: K2, to: Ledger, label: write settlement }
  - { id: e31, type: NoteLink, from: ~note1, to: Eb1 }
  - { id: e32, type: NoteLink, from: ~note2, to: S_and }
  - { id: e33, type: NoteLink, from: ~note3, to: Ledger }
diagrams:
  - { id: d1, name: Example BPMN Collaboration - Supply Chain, kind: usecase, layoutProvenance: Synthesized }
