# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Parametric - Complex Trim/CG Equations
elements:
  - { id: ~note1, type: Note, name: 'PARAMETRIC DIAGRAM NOTE:', documentation: 'PARAMETRIC DIAGRAM NOTE:\nEVERY edge here is a BINDING CONNECTOR (==)\nmeaning equality. The network is a system\nof simultaneous equations, not a flow graph.\nConstraint blocks evaluate the model''s\nvalue properties so they stay consistent.' }
  - { id: WeightSum, type: Class, name: WeightSum, members: [{ name: '{ W_total', isOperation: false, visibility: Public, defaultValue: 'W_fus + W_wing + W_tail + W_eng + W_fuel }', rawText: '{ W_total = W_fus + W_wing + W_tail + W_eng + W_fuel }' }] }
  - { id: MomentSum, type: Constraint, name: MomentSum, members: [{ name: '{ CG =', isOperation: true, visibility: Public, params: [{ name: 'W_fus*x_fus + W_wing*x_wing + W_tail*x_tail + W_eng*x_eng + W_fuel*x_fuel' }], rawText: '{ CG = (W_fus*x_fus + W_wing*x_wing + W_tail*x_tail + W_eng*x_eng + W_fuel*x_fuel) / W_total }' }] }
  - { id: LiftEq, type: Constraint, name: LiftEq, members: [{ name: '{ L', isOperation: false, visibility: Public, defaultValue: '0.5 * rho * V^2 * S * CL }', rawText: '{ L = 0.5 * rho * V^2 * S * CL }' }] }
  - { id: WeightEq, type: Constraint, name: WeightEq, members: [{ name: '{ L', isOperation: false, visibility: Public, defaultValue: 'W_total * g }', rawText: '{ L = W_total * g }' }] }
  - { id: PitchMoment, type: Constraint, name: PitchMoment, members: [{ name: '{ M_pitch', isOperation: false, visibility: Public, defaultValue: 'L * x_ac - W_total * g * CG + T * z_thrust }', rawText: '{ M_pitch = L * x_ac - W_total * g * CG + T * z_thrust }' }] }
  - { id: TrimCondition, type: Constraint, name: TrimCondition, members: [{ name: '{ M_pitch', isOperation: false, visibility: Public, defaultValue: '0 }', rawText: '{ M_pitch = 0 }' }] }
  - { id: FuelBurn, type: Constraint, name: FuelBurn, members: [{ name: '{ W_fuel', isOperation: false, visibility: Public, defaultValue: 'W_fuel_init - SFC * T * t }', rawText: '{ W_fuel = W_fuel_init - SFC * T * t }' }] }
  - { id: ThrustDrag, type: Constraint, name: ThrustDrag, members: [{ name: '{ T', isOperation: false, visibility: Public, defaultValue: 'D }', rawText: '{ T = D }' }] }
  - { id: DragEq, type: Constraint, name: DragEq, members: [{ name: '{ D', isOperation: false, visibility: Public, defaultValue: '0.5 * rho * V^2 * S * CD }', rawText: '{ D = 0.5 * rho * V^2 * S * CD }' }] }
  - { id: Binding context (inside an AircraftTrim block), type: Package, name: Binding context (inside an AircraftTrim block) }
  - { id: vW_total, type: Class, name: 'vW_total : Mass', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vCG, type: Class, name: 'vCG : Length', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vL, type: Class, name: 'vL : Force', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vD, type: Class, name: 'vD : Force', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vT, type: Class, name: 'vT : Force', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vV, type: Class, name: 'vV : Velocity', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vCL, type: Class, name: 'vCL : Real', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vCD, type: Class, name: 'vCD : Real', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vM_pitch, type: Class, name: 'vM_pitch : Torque', parentId: Binding context (inside an AircraftTrim block) }
  - { id: vW_fuel, type: Class, name: 'vW_fuel : Mass', parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cWS : WeightSum"  { }', type: Constraint, name: WeightSumInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cMS : MomentSum"  { }', type: Constraint, name: MomentSumInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cLE : LiftEq"  { }', type: Constraint, name: LiftEqInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cWE : WeightEq"  { }', type: Constraint, name: WeightEqInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cPM : PitchMoment"  { }', type: Constraint, name: PitchMomentInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cTC : TrimCondition"  { }', type: Constraint, name: TrimConditionInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cFB : FuelBurn"  { }', type: Constraint, name: FuelBurnInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cTD : ThrustDrag"  { }', type: Constraint, name: ThrustDragInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: '"cDE : DragEq"  { }', type: Constraint, name: DragEqInst, parentId: Binding context (inside an AircraftTrim block) }
  - { id: cWS, type: Class, name: cWS }
  - { id: cMS, type: Class, name: cMS }
  - { id: cLE, type: Class, name: cLE }
  - { id: cWE, type: Class, name: cWE }
  - { id: cPM, type: Class, name: cPM }
  - { id: cTC, type: Class, name: cTC }
  - { id: cFB, type: Class, name: cFB }
  - { id: cTD, type: Class, name: cTD }
  - { id: cDE, type: Class, name: cDE }
  - { id: ~note2, type: Note, name: TrimCondition (M_pitch = 0) binds the, documentation: 'TrimCondition (M_pitch = 0) binds the\npitch moment to zero, closing the loop.\nThe whole network is one coupled\nequation set the solver must satisfy.' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: WeightSum }
  - { id: e2, type: Association, from: vW_total, to: cWS }
  - { id: e3, type: Association, from: vCG, to: cMS }
  - { id: e4, type: Association, from: vW_total, to: cMS }
  - { id: e5, type: Association, from: vL, to: cLE }
  - { id: e6, type: Association, from: vV, to: cLE }
  - { id: e7, type: Association, from: vCL, to: cLE }
  - { id: e8, type: Association, from: vL, to: cWE }
  - { id: e9, type: Association, from: vW_total, to: cWE }
  - { id: e10, type: Association, from: vM_pitch, to: cPM }
  - { id: e11, type: Association, from: vL, to: cPM }
  - { id: e12, type: Association, from: vCG, to: cPM }
  - { id: e13, type: Association, from: vT, to: cPM }
  - { id: e14, type: Association, from: vM_pitch, to: cTC }
  - { id: e15, type: Association, from: vW_fuel, to: cFB }
  - { id: e16, type: Association, from: vT, to: cFB }
  - { id: e17, type: Association, from: vT, to: cTD }
  - { id: e18, type: Association, from: vD, to: cTD }
  - { id: e19, type: Association, from: vD, to: cDE }
  - { id: e20, type: Association, from: vV, to: cDE }
  - { id: e21, type: Association, from: vCD, to: cDE }
  - { id: e22, type: NoteLink, from: ~note2, to: cTC }
diagrams:
  - { id: d1, name: Example Parametric - Complex Trim/CG Equations, kind: class, layoutProvenance: Synthesized }
