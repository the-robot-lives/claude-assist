# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Parametric - Medium Circuit Equations
elements:
  - { id: ~note1, type: Note, name: 'PARAMETRIC DIAGRAM NOTE:', documentation: 'PARAMETRIC DIAGRAM NOTE:\nAll edges are BINDING CONNECTORS (==) =\nequality constraints. No flow occurs.\nTwo constraint blocks sharing a bound\nparameter form a coupled equation set.' }
  - { id: OhmsLaw, type: Class, name: OhmsLaw, members: [{ name: '{ V', isOperation: false, visibility: Public, defaultValue: 'I * R }', rawText: '{ V = I * R }' }] }
  - { id: PowerLaw, type: Constraint, name: PowerLaw, members: [{ name: '{ P', isOperation: false, visibility: Public, defaultValue: 'V * I }', rawText: '{ P = V * I }' }] }
  - { id: EnergyCost, type: Constraint, name: EnergyCost, members: [{ name: '{ cost', isOperation: false, visibility: Public, defaultValue: 'P * rate * t }', rawText: '{ cost = P * rate * t }' }] }
  - { id: Binding context (inside a ResistorCircuit block), type: Package, name: Binding context (inside a ResistorCircuit block) }
  - { id: vVal, type: Class, name: 'vVal : Voltage', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: iVal, type: Class, name: 'iVal : Current', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: rVal, type: Class, name: 'rVal : Resistance', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: pVal, type: Class, name: 'pVal : Power', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: '"ohm : OhmsLaw"  { }', type: Constraint, name: OhmsLawInst, parentId: Binding context (inside a ResistorCircuit block) }
  - { id: '"pow : PowerLaw"  { }', type: Constraint, name: PowerLawInst, parentId: Binding context (inside a ResistorCircuit block) }
  - { id: '"ec : EnergyCost"  { }', type: Constraint, name: EnergyCostInst, parentId: Binding context (inside a ResistorCircuit block) }
  - { id: rateVal, type: Class, name: 'rateVal : CostPerEnergy', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: tVal, type: Class, name: 'tVal : Duration', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: costVal, type: Class, name: 'costVal : Currency', parentId: Binding context (inside a ResistorCircuit block) }
  - { id: ohm, type: Class, name: ohm }
  - { id: pow, type: Class, name: pow }
  - { id: ec, type: Class, name: ec }
  - { id: ~note2, type: Note, name: 'P (in PowerLaw) and V,I are bound to the', documentation: 'P (in PowerLaw) and V,I are bound to the\nSAME value properties as Ohm''s law, so\nV couples the two constraint blocks:\nboth equations must hold simultaneously.' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: OhmsLaw }
  - { id: e2, type: Association, from: vVal, to: ohm }
  - { id: e3, type: Association, from: iVal, to: ohm }
  - { id: e4, type: Association, from: rVal, to: ohm }
  - { id: e5, type: Association, from: vVal, to: pow }
  - { id: e6, type: Association, from: iVal, to: pow }
  - { id: e7, type: Association, from: pVal, to: pow }
  - { id: e8, type: Association, from: pVal, to: ec }
  - { id: e9, type: Association, from: rateVal, to: ec }
  - { id: e10, type: Association, from: tVal, to: ec }
  - { id: e11, type: Association, from: costVal, to: ec }
  - { id: e12, type: NoteLink, from: ~note2, to: pow }
diagrams:
  - { id: d1, name: Example Parametric - Medium Circuit Equations, kind: class, layoutProvenance: Synthesized }
