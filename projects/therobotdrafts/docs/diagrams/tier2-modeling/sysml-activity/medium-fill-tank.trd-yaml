# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example SysML Activity - Fill Tank (Continuous)
elements:
  - { id: ~act1, type: Activity, name: Initialize Setpoint }
  - { id: ~act2, type: Activity, name: Arm Safety Interlock }
  - { id: ~act3, type: Activity, name: '<<controlOperator>' }
  - { id: ~act4, type: Activity, name: 'Stream Level Signal\n<<continuous>>\n{rate = 10 Hz}' }
  - { id: ~act5, type: Activity, name: Receive Level }
  - { id: ~act6, type: Activity, name: Compute Fill Rate }
  - { id: ~dec7, type: Decision, name: 'Level < Target?' }
  - { id: ~act8, type: Activity, name: Open Inlet Valve }
  - { id: ~act9, type: Activity, name: 'Pump Fluid\n<<continuous>>\n{rate = 5 L/s}' }
  - { id: ~act10, type: Activity, name: Close Inlet Valve }
  - { id: ~act11, type: Activity, name: 'Stream Level Signal\n<<continuous>>\n{rate = 10 Hz}' }
  - { id: ~act12, type: Activity, name: '<<controlOperator>' }
  - { id: ~act13, type: Activity, name: Report Status }
  - { id: ~end14, type: StateEnd, name: end }
  - { id: ~note15, type: Note, name: '<b>«controlOperator»</b>', documentation: '<b>«controlOperator»</b>\n----\nSysML-specific: an action that\nenables or disables another flow\nrather than producing data.\nNative UML has no equivalent.' }
  - { id: EnableFillLoop, type: Activity, name: EnableFillLoop }
edges:
  - { id: e1, type: Transition, from: ~act1, to: ~act2 }
  - { id: e2, type: Transition, from: ~act2, to: ~act3 }
  - { id: e3, type: Transition, from: ~act3, to: ~act4 }
  - { id: e4, type: Transition, from: ~act4, to: ~act5 }
  - { id: e5, type: Transition, from: ~act5, to: ~act6 }
  - { id: e6, type: Transition, from: ~act6, to: ~dec7 }
  - { id: e7, type: Transition, from: ~dec7, to: ~act8, label: yes }
  - { id: e8, type: Transition, from: ~act8, to: ~act9 }
  - { id: e9, type: Transition, from: ~dec7, to: ~act10, label: no }
  - { id: e10, type: Transition, from: ~act9, to: ~act11 }
  - { id: e11, type: Transition, from: ~act10, to: ~act11 }
  - { id: e12, type: Transition, from: ~act11, to: ~act12 }
  - { id: e13, type: Transition, from: ~act12, to: ~act13 }
  - { id: e14, type: Transition, from: ~act13, to: ~end14 }
  - { id: e15, type: NoteLink, from: ~note15, to: EnableFillLoop }
diagrams:
  - { id: d1, name: Example SysML Activity - Fill Tank (Continuous), kind: activity, layoutProvenance: Synthesized }
