# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example SysML Activity - Simple Control Flow
elements:
  - { id: ~start1, type: StateStart, name: start }
  - { id: ~act2, type: Activity, name: Read Setpoint }
  - { id: ~act3, type: Activity, name: Measure Process Variable }
  - { id: ~act4, type: Activity, name: Compute Error }
  - { id: ~dec5, type: Decision, name: 'Error > Threshold?' }
  - { id: ~act6, type: Activity, name: Actuate Valve }
  - { id: ~act7, type: Activity, name: Hold Position }
  - { id: ~act8, type: Activity, name: Log State }
  - { id: ~end9, type: StateEnd, name: end }
edges:
  - { id: e1, type: Transition, from: ~start1, to: ~act2 }
  - { id: e2, type: Transition, from: ~act2, to: ~act3 }
  - { id: e3, type: Transition, from: ~act3, to: ~act4 }
  - { id: e4, type: Transition, from: ~act4, to: ~dec5 }
  - { id: e5, type: Transition, from: ~dec5, to: ~act6, label: yes }
  - { id: e6, type: Transition, from: ~dec5, to: ~act7, label: no }
  - { id: e7, type: Transition, from: ~act6, to: ~act8 }
  - { id: e8, type: Transition, from: ~act7, to: ~act8 }
  - { id: e9, type: Transition, from: ~act8, to: ~end9 }
diagrams:
  - { id: d1, name: Example SysML Activity - Simple Control Flow, kind: activity, layoutProvenance: Synthesized }
