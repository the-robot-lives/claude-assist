# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Composite Structure Variant - Composite vs Class
elements:
  - { id: PaymentGateway, type: Class, name: PaymentGateway, stereotype: class, members: [{ name: apiKey, isOperation: false, visibility: Private, type: String, rawText: '- apiKey : String' }, { name: timeout, isOperation: false, visibility: Private, type: Duration, rawText: '- timeout : Duration' }, { name: charge, isOperation: true, visibility: Public, type: Result, params: [{ name: amount, type: Money }], rawText: '+ charge(amount : Money) : Result' }, { name: refund, isOperation: true, visibility: Public, type: Result, params: [{ name: txnId, type: String }], rawText: '+ refund(txnId : String) : Result' }, { name: getStatus, isOperation: true, visibility: Public, type: Status, params: [{ name: txnId, type: String }], rawText: '+ getStatus(txnId : String) : Status' }] }
  - { id: csGw, type: Boundary, name: PaymentGateway, stereotype: structuredClassifier }
  - { id: csApi, type: Component, name: 'api : ApiFacade', parentId: csGw }
  - { id: csAuth, type: Component, name: 'auth : Authorizer', parentId: csGw }
  - { id: csBank, type: Component, name: 'bank : BankGateway', parentId: csGw }
  - { id: csAudit, type: Component, name: 'audit : AuditLogger', parentId: csGw }
  - { id: csReq, type: Component, name: csReq, parentId: csGw }
  - { id: csRes, type: Component, name: csRes, parentId: csGw }
  - { id: ~note1, type: Note, name: '<b>CLASS DIAGRAM</b>', documentation: '<b>CLASS DIAGRAM</b>\n"What does it HAVE?"\nAttributes (state) + operations (behaviour).\nHides internal composition.' }
  - { id: ~note2, type: Note, name: '<b>COMPOSITE STRUCTURE</b>', documentation: '<b>COMPOSITE STRUCTURE</b>\n"What is it MADE OF?"\nParts (roles) + ports + connectors.\nReveals internal architecture.' }
  - { id: ~note3, type: Note, name: '<b>"What it has" vs "what it''s made of"</b>', documentation: '<b>"What it has" vs "what it''s made of"</b>\nThe class view lists the gateway''s attributes and methods — its contract.\nThe composite view decomposes the SAME classifier into collaborating parts\nand shows how requests flow from a boundary port through api -> auth ->\nbank -> audit.  Two diagrams, one type, two legitimate questions.' }
edges:
  - { id: e1, type: DirectedAssociation, from: csApi, to: csAuth, label: authorize }
  - { id: e2, type: DirectedAssociation, from: csAuth, to: csBank, label: settle }
  - { id: e3, type: DirectedAssociation, from: csBank, to: csAudit, label: record }
  - { id: e4, type: DirectedAssociation, from: csReq, to: csApi }
  - { id: e5, type: DirectedAssociation, from: csApi, to: csRes }
  - { id: e6, type: NoteLink, from: ~note1, to: PaymentGateway }
  - { id: e7, type: NoteLink, from: ~note2, to: csGw }
  - { id: e8, type: NoteLink, from: ~note3, to: PaymentGateway }
diagrams:
  - { id: d1, name: Example Composite Structure Variant - Composite vs Class, kind: component, layoutProvenance: Synthesized }
