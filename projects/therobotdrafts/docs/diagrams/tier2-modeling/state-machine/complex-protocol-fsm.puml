@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
' '   description:  16+ state communication protocol FSM with a composite state, history, choice, and multiple regions.
'   usecase:      Teach composite/nested states, submachine, history pseudostate, choice/junction, regions.
'   complexity:   complex
'   domain:       networking
' ============================================================================
title Example State Machine - Complex Protocol FSM

[*] --> Closed

state "Closed" as Closed
state "Listen" as Listen
state "SynSent" as SynSent

Closed --> Listen : open()
Closed --> SynSent : connect(remote)

' ---------------- COMPOSITE STATE -----------------------------------------
' A COMPOSITE STATE contains nested substates, shown inside a rounded-rect
' with its own [*] initial pseudostate. Entering the composite enters its
' initial substate unless a HISTORY pseudostate remembers a different one.
state "Established" as Established {
  [*] --> EstablishedSynRcvd

  state "EstablishedSynRcvd" as EstablishedSynRcvd
  state "EstablishedData" as EstablishedData
  state "EstablishedFinWait" as EstablishedFinWait

  EstablishedSynRcvd --> EstablishedData : ack_received[valid_seq]
  EstablishedData --> EstablishedFinWait : close()

  ' HISTORY PSEUDOSTATE (H): when re-entering the composite, control returns
  ' to the LAST ACTIVE substate rather than the composite's [*]. Shallow
  ' history remembers only the top-level substate of this composite.
  state "H" as History <<history>>
  [*] --> History : reenter

  ' MULTIPLE REGIONS within a composite run CONCURRENTLY, separated by a
  ' dashed line. Each region has its own initial pseudostate.
  --
  ' Second region: send-side of a full-duplex channel.
  [*] --> Sending
  state "Sending" as Sending {
    Sending : do / transmit_outbound_segment()
  }
}

Listen --> EstablishedSynRcvd : syn_received
SynSent --> Established : syn_ack_received

' CHOICE PSEUDOSTATE: a dynamic decision evaluated at the moment of arrival.
' Unlike a static junction, the guard is re-evaluated and the outgoing edge
' is selected based on runtime values.
EstablishedData --> Choose
state "Choose" as Choose <<choice>>
Choose --> EstablishedData : [more_data_pending]
Choose --> EstablishedFinWait : [no_more_data]

' JUNCTION PSEUDOSTATE: a static merge/split point — used to factor common
' transition chains. Mapped to a single point with multiple incoming/outgoing.
EstablishedFinWait --> Cleanup
state "Cleanup" as Cleanup <<junction>>
Cleanup --> Closed : teardown_complete

' Top-level terminal transitions.
Established --> Closed : reset
Listen --> Closed : close()
SynSent --> Closed : timeout[retries_exhausted]

state "Error" as Error
Closed --> Error : internal_fault
Error --> [*]

' TEACHING NOTES:
'   - Composite states reduce visual clutter by grouping related substates.
'   - History (H) lets a long-running session resume where it left off.
'   - Choice re-evaluates at runtime; junction is a static routing point.
'   - Concurrent regions (the --  separator) model parallel sub-behaviors
'     inside one composite state.
@enduml
