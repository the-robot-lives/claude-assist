# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example State Machine - Medium Order Lifecycle
elements:
  - { id: ~start1, type: StateStart, name: start }
  - { id: New, type: State, name: New }
  - { id: Paid, type: State, name: Paid }
  - { id: Picking, type: State, name: Picking, documentation: 'entry / reserve_stock()\ndo / pick_items_from_shelf()\nexit / release_unpicked_reservations()' }
  - { id: Shipped, type: State, name: Shipped }
  - { id: Delivered, type: State, name: Delivered }
  - { id: Cancelled, type: State, name: Cancelled }
  - { id: ~end2, type: StateEnd, name: end }
edges:
  - { id: e1, type: Transition, from: ~start1, to: New, label: create_order }
  - { id: e2, type: Transition, from: New, to: Paid, label: 'payment_received[amount >= total]' }
  - { id: e3, type: Transition, from: Paid, to: Picking, label: begin_picking }
  - { id: e4, type: Transition, from: Picking, to: Shipped, label: ship }
  - { id: e5, type: Transition, from: Shipped, to: Delivered, label: deliver_confirmed }
  - { id: e6, type: Transition, from: New, to: Cancelled, label: 'cancel[within_cancellation_window]' }
  - { id: e7, type: Transition, from: Paid, to: Cancelled, label: 'cancel[refund_approved]' }
  - { id: e8, type: Transition, from: Picking, to: Cancelled, label: 'cancel[items_not_yet_dispatched]' }
  - { id: e9, type: Transition, from: Delivered, to: ~end2 }
  - { id: e10, type: Transition, from: Cancelled, to: ~end2 }
diagrams:
  - { id: d1, name: Example State Machine - Medium Order Lifecycle, kind: state, layoutProvenance: Synthesized }
