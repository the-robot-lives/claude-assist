# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example State Machine - Complex Protocol FSM
elements:
  - { id: ~start1, type: StateStart, name: start }
  - { id: Closed, type: State, name: Closed }
  - { id: Listen, type: State, name: Listen }
  - { id: SynSent, type: State, name: SynSent }
  - { id: Established, type: State, name: Established }
  - { id: EstablishedSynRcvd, type: State, name: EstablishedSynRcvd, parentId: Established }
  - { id: EstablishedData, type: State, name: EstablishedData, parentId: Established }
  - { id: EstablishedFinWait, type: State, name: EstablishedFinWait, parentId: Established }
  - { id: History, type: State, name: H, parentId: Established, stereotype: history }
  - { id: Sending, type: State, name: Sending, parentId: Established, documentation: do / transmit_outbound_segment() }
  - { id: Choose, type: State, name: Choose }
  - { id: Cleanup, type: State, name: Cleanup, stereotype: junction }
  - { id: Error, type: State, name: Error }
  - { id: ~end2, type: StateEnd, name: end }
edges:
  - { id: e1, type: Transition, from: ~start1, to: Closed }
  - { id: e2, type: Transition, from: Closed, to: Listen, label: open() }
  - { id: e3, type: Transition, from: Closed, to: SynSent, label: connect(remote) }
  - { id: e4, type: Transition, from: ~start1, to: EstablishedSynRcvd }
  - { id: e5, type: Transition, from: EstablishedSynRcvd, to: EstablishedData, label: 'ack_received[valid_seq]' }
  - { id: e6, type: Transition, from: EstablishedData, to: EstablishedFinWait, label: close() }
  - { id: e7, type: Transition, from: ~start1, to: History, label: reenter }
  - { id: e8, type: Transition, from: ~start1, to: Sending }
  - { id: e9, type: Transition, from: Listen, to: EstablishedSynRcvd, label: syn_received }
  - { id: e10, type: Transition, from: SynSent, to: Established, label: syn_ack_received }
  - { id: e11, type: Transition, from: EstablishedData, to: Choose }
  - { id: e12, type: Transition, from: Choose, to: EstablishedData, label: '[more_data_pending]' }
  - { id: e13, type: Transition, from: Choose, to: EstablishedFinWait, label: '[no_more_data]' }
  - { id: e14, type: Transition, from: EstablishedFinWait, to: Cleanup }
  - { id: e15, type: Transition, from: Cleanup, to: Closed, label: teardown_complete }
  - { id: e16, type: Transition, from: Established, to: Closed, label: reset }
  - { id: e17, type: Transition, from: Listen, to: Closed, label: close() }
  - { id: e18, type: Transition, from: SynSent, to: Closed, label: 'timeout[retries_exhausted]' }
  - { id: e19, type: Transition, from: Closed, to: Error, label: internal_fault }
  - { id: e20, type: Transition, from: Error, to: ~end2 }
diagrams:
  - { id: d1, name: Example State Machine - Complex Protocol FSM, kind: state, layoutProvenance: Synthesized }
