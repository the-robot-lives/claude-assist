@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex BDD of a Spacecraft across subsystems with nested composition, multiple generalizations, ports, and value types with units and dimensions.
'   usecase:      Teach large BDD structure: subsystem packages, nested composition, ports on blocks, and value types with dimensions.
'   complexity:   complex
'   domain:       aerospace
' ============================================================================
title Example BDD - Complex Spacecraft

class "Spacecraft" <<block>> {
  dryMass : Mass
  wetMass : Mass
  totalDeltaV : Velocity
}

class "PropulsionSubsystem" <<block>> {
  thrust : Force
}

class "PowerSubsystem" <<block>> {
  busVoltage : Voltage
}

class "AvionicsSubsystem" <<block>> {
  clockFreq : Frequency
}

class "PayloadSubsystem" <<block>> {
  dataRate : DataRate
}

class "Thruster" <<block>> {
  isp : SpecificImpulse
  thrust : Force
}

class "FuelTank" <<block>> {
  volume : Volume
  propellantMass : Mass
}

class "SolarPanel" <<block>> {
  area : Area
  output : Power
}

class "Battery" <<block>> {
  capacity : Energy
}

class "FlightComputer" <<block>> {
  ram : DataSize
  cycleTime : Time
}

class "StarTracker" <<block>> {
  accuracy : Angle
}

class "Transceiver" <<block>> {
  bandwidth : DataRate
}

class "ScienceInstrument" <<block>> {
  resolution : Length
}

class "Propellant" <<block>> {
  density : Density
}

class "Mass" <<valueType>> {
  value : Real
  unit : "kg"
}

class "Velocity" <<valueType>> {
  value : Real
  unit : "m/s"
}

class "SpecificImpulse" <<valueType>> {
  value : Real
  unit : "s"
}

class "DataRate" <<valueType>> {
  value : Real
  unit : "Mbps"
}

class "Force" <<valueType>> {
  value : Real
  unit : "N"
}

class "Pressure" <<valueType>> {
  value : Real
  unit : "Pa"
}

"Spacecraft" *-- "1" "PropulsionSubsystem" : propulsion
"Spacecraft" *-- "1" "PowerSubsystem" : power
"Spacecraft" *-- "1" "AvionicsSubsystem" : avionics
"Spacecraft" *-- "1" "PayloadSubsystem" : payload

"PropulsionSubsystem" *-- "4" "Thruster" : thrusters
"PropulsionSubsystem" *-- "2" "FuelTank" : tanks
"FuelTank" --> "1" "Propellant" : contents

"PowerSubsystem" *-- "2" "SolarPanel" : panels
"PowerSubsystem" *-- "2" "Battery" : batteries

"AvionicsSubsystem" *-- "2" "FlightComputer" : computers
"AvionicsSubsystem" *-- "2" "StarTracker" : starTrackers

"PayloadSubsystem" *-- "1" "Transceiver" : comm
"PayloadSubsystem" *-- "2" "ScienceInstrument" : instruments

package "ThrustPort" {
  port "ThrustIface"
  port "CommandIface"
}

note right of "Spacecraft"
  12+ blocks across 4 subsystems.
  Nested composition (*) shows the
  whole-part hierarchy at multiple levels.
end note

note bottom of "Thruster"
  Ports declared on blocks define
  interaction points for the IBD wiring.
end note

@enduml
