# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BDD - Simple Vehicle
elements:
  - { id: Vehicle, type: Block, name: Vehicle, members: [{ name: mass, isOperation: false, visibility: Public, type: Mass, rawText: 'mass : Mass' }, { name: speed, isOperation: false, visibility: Public, type: Velocity, rawText: 'speed : Velocity' }, { name: wheelCount, isOperation: false, visibility: Public, type: Integer, rawText: 'wheelCount : Integer' }] }
  - { id: Wheel, type: Block, name: Wheel, members: [{ name: diameter, isOperation: false, visibility: Public, type: Length, rawText: 'diameter : Length' }, { name: pressure, isOperation: false, visibility: Public, type: Pressure, rawText: 'pressure : Pressure' }] }
  - { id: Engine, type: Block, name: Engine, members: [{ name: power, isOperation: false, visibility: Public, type: Power, rawText: 'power : Power' }, { name: displacement, isOperation: false, visibility: Public, type: Volume, rawText: 'displacement : Volume' }] }
  - { id: Mass, type: ValueType, name: Mass, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"kg"', rawText: 'unit : "kg"' }] }
  - { id: ~note1, type: Note, name: «block» = SysML unit of structure., documentation: '«block» = SysML unit of structure.\nComposition (*) = whole owns the part\n(part dies with the whole).' }
edges:
  - { id: e1, type: Composition, from: Vehicle, to: Wheel, label: wheel, toMultiplicity: 4 }
  - { id: e2, type: Composition, from: Vehicle, to: Engine, label: engine, toMultiplicity: 1 }
  - { id: e3, type: NoteLink, from: ~note1, to: Vehicle }
diagrams:
  - { id: d1, name: Example BDD - Simple Vehicle, kind: class, layoutProvenance: Synthesized }
