# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BDD - Complex Spacecraft
elements:
  - { id: Spacecraft, type: Block, name: Spacecraft, members: [{ name: dryMass, isOperation: false, visibility: Public, type: Mass, rawText: 'dryMass : Mass' }, { name: wetMass, isOperation: false, visibility: Public, type: Mass, rawText: 'wetMass : Mass' }, { name: totalDeltaV, isOperation: false, visibility: Public, type: Velocity, rawText: 'totalDeltaV : Velocity' }] }
  - { id: PropulsionSubsystem, type: Block, name: PropulsionSubsystem, members: [{ name: thrust, isOperation: false, visibility: Public, type: Force, rawText: 'thrust : Force' }] }
  - { id: PowerSubsystem, type: Block, name: PowerSubsystem, members: [{ name: busVoltage, isOperation: false, visibility: Public, type: Voltage, rawText: 'busVoltage : Voltage' }] }
  - { id: AvionicsSubsystem, type: Block, name: AvionicsSubsystem, members: [{ name: clockFreq, isOperation: false, visibility: Public, type: Frequency, rawText: 'clockFreq : Frequency' }] }
  - { id: PayloadSubsystem, type: Block, name: PayloadSubsystem, members: [{ name: dataRate, isOperation: false, visibility: Public, type: DataRate, rawText: 'dataRate : DataRate' }] }
  - { id: Thruster, type: Block, name: Thruster, members: [{ name: isp, isOperation: false, visibility: Public, type: SpecificImpulse, rawText: 'isp : SpecificImpulse' }, { name: thrust, isOperation: false, visibility: Public, type: Force, rawText: 'thrust : Force' }] }
  - { id: FuelTank, type: Block, name: FuelTank, members: [{ name: volume, isOperation: false, visibility: Public, type: Volume, rawText: 'volume : Volume' }, { name: propellantMass, isOperation: false, visibility: Public, type: Mass, rawText: 'propellantMass : Mass' }] }
  - { id: SolarPanel, type: Block, name: SolarPanel, members: [{ name: area, isOperation: false, visibility: Public, type: Area, rawText: 'area : Area' }, { name: output, isOperation: false, visibility: Public, type: Power, rawText: 'output : Power' }] }
  - { id: Battery, type: Block, name: Battery, members: [{ name: capacity, isOperation: false, visibility: Public, type: Energy, rawText: 'capacity : Energy' }] }
  - { id: FlightComputer, type: Block, name: FlightComputer, members: [{ name: ram, isOperation: false, visibility: Public, type: DataSize, rawText: 'ram : DataSize' }, { name: cycleTime, isOperation: false, visibility: Public, type: Time, rawText: 'cycleTime : Time' }] }
  - { id: StarTracker, type: Block, name: StarTracker, members: [{ name: accuracy, isOperation: false, visibility: Public, type: Angle, rawText: 'accuracy : Angle' }] }
  - { id: Transceiver, type: Block, name: Transceiver, members: [{ name: bandwidth, isOperation: false, visibility: Public, type: DataRate, rawText: 'bandwidth : DataRate' }] }
  - { id: ScienceInstrument, type: Block, name: ScienceInstrument, members: [{ name: resolution, isOperation: false, visibility: Public, type: Length, rawText: 'resolution : Length' }] }
  - { id: Propellant, type: Block, name: Propellant, members: [{ name: density, isOperation: false, visibility: Public, type: Density, rawText: 'density : Density' }] }
  - { id: Mass, type: ValueType, name: Mass, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"kg"', rawText: 'unit : "kg"' }] }
  - { id: Velocity, type: ValueType, name: Velocity, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"m/s"', rawText: 'unit : "m/s"' }] }
  - { id: SpecificImpulse, type: ValueType, name: SpecificImpulse, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"s"', rawText: 'unit : "s"' }] }
  - { id: DataRate, type: ValueType, name: DataRate, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"Mbps"', rawText: 'unit : "Mbps"' }] }
  - { id: Force, type: ValueType, name: Force, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"N"', rawText: 'unit : "N"' }] }
  - { id: Pressure, type: ValueType, name: Pressure, members: [{ name: value, isOperation: false, visibility: Public, type: Real, rawText: 'value : Real' }, { name: unit, isOperation: false, visibility: Public, type: '"Pa"', rawText: 'unit : "Pa"' }] }
  - { id: ThrustPort, type: Package, name: ThrustPort }
  - { id: ~note1, type: Note, name: 12+ blocks across 4 subsystems., documentation: '12+ blocks across 4 subsystems.\nNested composition (*) shows the\nwhole-part hierarchy at multiple levels.' }
  - { id: ~note2, type: Note, name: Ports declared on blocks define, documentation: 'Ports declared on blocks define\ninteraction points for the IBD wiring.' }
edges:
  - { id: e1, type: Composition, from: Spacecraft, to: PropulsionSubsystem, label: propulsion, toMultiplicity: 1 }
  - { id: e2, type: Composition, from: Spacecraft, to: PowerSubsystem, label: power, toMultiplicity: 1 }
  - { id: e3, type: Composition, from: Spacecraft, to: AvionicsSubsystem, label: avionics, toMultiplicity: 1 }
  - { id: e4, type: Composition, from: Spacecraft, to: PayloadSubsystem, label: payload, toMultiplicity: 1 }
  - { id: e5, type: Composition, from: PropulsionSubsystem, to: Thruster, label: thrusters, toMultiplicity: 4 }
  - { id: e6, type: Composition, from: PropulsionSubsystem, to: FuelTank, label: tanks, toMultiplicity: 2 }
  - { id: e7, type: DirectedAssociation, from: FuelTank, to: Propellant, label: contents, toMultiplicity: 1 }
  - { id: e8, type: Composition, from: PowerSubsystem, to: SolarPanel, label: panels, toMultiplicity: 2 }
  - { id: e9, type: Composition, from: PowerSubsystem, to: Battery, label: batteries, toMultiplicity: 2 }
  - { id: e10, type: Composition, from: AvionicsSubsystem, to: FlightComputer, label: computers, toMultiplicity: 2 }
  - { id: e11, type: Composition, from: AvionicsSubsystem, to: StarTracker, label: starTrackers, toMultiplicity: 2 }
  - { id: e12, type: Composition, from: PayloadSubsystem, to: Transceiver, label: comm, toMultiplicity: 1 }
  - { id: e13, type: Composition, from: PayloadSubsystem, to: ScienceInstrument, label: instruments, toMultiplicity: 2 }
  - { id: e14, type: NoteLink, from: ~note1, to: Spacecraft }
  - { id: e15, type: NoteLink, from: ~note2, to: Thruster }
diagrams:
  - { id: d1, name: Example BDD - Complex Spacecraft, kind: class, layoutProvenance: Synthesized }
