# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example BDD - BDD vs UML Class
elements:
  - { id: SysML Block Definition Diagram, type: Package, name: SysML Block Definition Diagram }
  - { id: PumpingStation, type: Block, name: PumpingStation, parentId: SysML Block Definition Diagram, members: [{ name: flow in inletPressure, isOperation: false, visibility: Public, type: Pressure, rawText: 'flow in inletPressure : Pressure' }, { name: flow out outletFlow, isOperation: false, visibility: Public, type: FlowRate, rawText: 'flow out outletFlow : FlowRate' }, { name: part pump, isOperation: false, visibility: Public, type: Pump, rawText: 'part pump : Pump' }, { name: part valve, isOperation: false, visibility: Public, type: Valve, rawText: 'part valve : Valve' }, { name: setpoint, isOperation: false, visibility: Public, type: Pressure, rawText: 'setpoint : Pressure' }, { name: inletPressure, isOperation: false, visibility: Public, type: double, rawText: 'inletPressure : double' }, { name: outletFlow, isOperation: false, visibility: Public, type: double, rawText: 'outletFlow : double' }, { name: pump, isOperation: false, visibility: Public, type: Pump, rawText: 'pump : Pump' }, { name: valve, isOperation: false, visibility: Public, type: Valve, rawText: 'valve : Valve' }, { name: setpoint, isOperation: false, visibility: Public, type: double, rawText: 'setpoint : double' }] }
  - { id: Pump, type: Block, name: Pump, parentId: SysML Block Definition Diagram, members: [{ name: ratedFlow, isOperation: false, visibility: Public, type: FlowRate, rawText: 'ratedFlow : FlowRate' }, { name: ratedFlow, isOperation: false, visibility: Public, type: double, rawText: 'ratedFlow : double' }] }
  - { id: Valve, type: Block, name: Valve, parentId: SysML Block Definition Diagram, members: [{ name: aperture, isOperation: false, visibility: Public, type: Real, rawText: 'aperture : Real' }, { name: aperture, isOperation: false, visibility: Public, type: double, rawText: 'aperture : double' }] }
  - { id: Plain UML Class Diagram, type: Package, name: Plain UML Class Diagram }
  - { id: ~note1, type: Note, name: SysML-specific property kinds NOT in UML class d…, documentation: 'SysML-specific property kinds NOT in UML class diagrams:\n- value property (typed by a valueType, e.g. setpoint : Pressure)\n- part property (composition of a block, role:pump)\n- flow property (in/out direction with item type, e.g. inletPressure : Pressure)\nUML collapses all of these into plain typed attributes.' }
edges:
  - { id: e1, type: Composition, from: PumpingStation, to: Pump, label: pump, toMultiplicity: 1 }
  - { id: e2, type: Composition, from: PumpingStation, to: Valve, label: valve, toMultiplicity: 1 }
  - { id: e3, type: Composition, from: PumpingStation, to: Pump, toMultiplicity: 1 }
  - { id: e4, type: Composition, from: PumpingStation, to: Valve, toMultiplicity: 1 }
  - { id: e5, type: NoteLink, from: ~note1, to: PumpingStation }
diagrams:
  - { id: d1, name: Example BDD - BDD vs UML Class, kind: class, layoutProvenance: Synthesized }
