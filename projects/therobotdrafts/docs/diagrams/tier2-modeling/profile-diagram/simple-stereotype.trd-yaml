# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Profile Diagram - Simple Stereotype
elements:
  - { id: MicroserviceProfile, type: Package, name: MicroserviceProfile, stereotype: profile }
  - { id: Component, type: Class, name: Component, parentId: MicroserviceProfile, stereotype: '(M,#B4A7E5) metaclass' }
  - { id: Service, type: Class, name: Service, parentId: MicroserviceProfile, stereotype: '(S,#F2C9C9) stereotype', members: [{ name: endpoint, isOperation: false, visibility: Public, type: String, rawText: '+ endpoint : String' }] }
  - { id: ~note1, type: Note, name: '<b>Stereotype</b> «Service»', parentId: MicroserviceProfile, documentation: '<b>Stereotype</b> «Service»\nExtends metaclass Component.\nTagged value:\nendpoint : String\nApply as:\n«Service» (endpoint="/v1/charge")\non any Component.' }
  - { id: ~note2, type: Note, name: '<b>Reading the extension arrow</b>', documentation: '<b>Reading the extension arrow</b>\nStereotype ----triangle> Metaclass\n(filled head points to metaclass)\nmeans: "elements of type Component\nmay optionally carry «Service» and\nits tagged values."' }
edges:
  - { id: e1, type: Extend, from: Service, to: Component }
  - { id: e2, type: NoteLink, from: ~note1, to: Service }
  - { id: e3, type: NoteLink, from: ~note2, to: Component }
diagrams:
  - { id: d1, name: Example Profile Diagram - Simple Stereotype, kind: class, layoutProvenance: Synthesized }
