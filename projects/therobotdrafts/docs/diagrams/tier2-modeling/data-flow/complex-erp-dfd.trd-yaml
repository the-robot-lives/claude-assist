  - { id: e8, type: DirectedAssociation, from: P1, to: P2, label: order }
  - { id: e9, type: DirectedAssociation, from: D3, to: P2, label: credit profile }
  - { id: e10, type: DirectedAssociation, from: P2, to: P3, label: approved order }
  - { id: e11, type: DirectedAssociation, from: P3, to: D1, label: priced order }
  - { id: e12, type: DirectedAssociation, from: D1, to: P4, label: order lines }
  - { id: e13, type: DirectedAssociation, from: D2, to: P4, label: on-hand qty }
  - { id: e14, type: DirectedAssociation, from: P4, to: P5, label: availability }
  - { id: e15, type: DirectedAssociation, from: P5, to: D2, label: reservation }
  - { id: e16, type: DirectedAssociation, from: D1, to: P6, label: order }
  - { id: e17, type: DirectedAssociation, from: D2, to: P6, label: pick list }
  - { id: e18, type: DirectedAssociation, from: P6, to: P7, label: packed shipment }
  - { id: e19, type: DirectedAssociation, from: P7, to: D5, label: shipment record }
  - { id: e20, type: DirectedAssociation, from: P7, to: Cust, label: delivery }
  - { id: e21, type: DirectedAssociation, from: D5, to: P8, label: shipment }
  - { id: e22, type: DirectedAssociation, from: P8, to: D4, label: invoice }
  - { id: e23, type: DirectedAssociation, from: D4, to: P9, label: invoice }
  - { id: e24, type: DirectedAssociation, from: P9, to: D4, label: payment applied }
  - { id: e25, type: DirectedAssociation, from: P9, to: Bank, label: deposit }
  - { id: e26, type: DirectedAssociation, from: D2, to: P10, label: low stock }
  - { id: e27, type: DirectedAssociation, from: P11, to: D2, label: restock }
  - { id: e28, type: DirectedAssociation, from: D1, to: P12, label: orders }
  - { id: e29, type: DirectedAssociation, from: D4, to: P12, label: invoices }
  - { id: e30, type: DirectedAssociation, from: P12, to: D6, label: ledger entry }
  - { id: e31, type: DirectedAssociation, from: D6, to: P13, label: metrics }
  - { id: e32, type: DirectedAssociation, from: P61, to: D7, label: pick ticket }
  - { id: e33, type: DirectedAssociation, from: D2b, to: P61, label: stock location }
  - { id: e34, type: DirectedAssociation, from: D7, to: P62, label: pick ticket }
  - { id: e35, type: DirectedAssociation, from: P62, to: P63, label: picked items }
  - { id: e36, type: DirectedAssociation, from: Clerk, to: P62, label: manual pick }
  - { id: e37, type: DirectedAssociation, from: P63, to: P64, label: packed parcel }
  - { id: e38, type: DirectedAssociation, from: P64, to: P7b, label: packed shipment }
  - { id: e39, type: NoteLink, from: ~note1, to: P6 }
  - { id: e40, type: NoteLink, from: ~note2, to: D2 }
diagrams:
