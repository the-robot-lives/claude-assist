# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Data Flow Diagram - Simple Order (Yourdon)
elements:
  - { id: Customer, type: Boundary, name: Customer, stereotype: externalEntity }
  - { id: P1, type: UseCase, name: 1\nProcess\nOrder, stereotype: process }
  - { id: D1, type: Component, name: Orders\n(D1), stereotype: dataStore }
  - { id: ~note1, type: Note, name: '**DFD element legend (Yourdon)**', documentation: '**DFD element legend (Yourdon)**\ncircle  = Process (number it: 1, 2, 1.1, 1.2 ...)\nstorage = Data Store (number it: D1, D2 ...)\nsquare  = External Entity (source/sink)\n--\nRule: arrows carry DATA (nouns), not control.\nRule: no direct entity-to-entity or store-to-store flows.\n--\nLeveling: this is the CONTEXT level. Exploding process "1"\ninto 1.1, 1.2 ... yields a Level-1 DFD with the SAME external\nflows crossing the boundary (input/output balance).' }
edges:
  - { id: e1, type: DirectedAssociation, from: Customer, to: P1, label: order }
  - { id: e2, type: DirectedAssociation, from: P1, to: D1, label: order record }
  - { id: e3, type: DirectedAssociation, from: P1, to: Customer, label: confirmation }
  - { id: e4, type: NoteLink, from: ~note1, to: P1 }
diagrams:
  - { id: d1, name: Data Flow Diagram - Simple Order (Yourdon), kind: usecase, layoutProvenance: Synthesized }
