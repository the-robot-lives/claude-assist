# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Requirements Traceability - Complex SysML Tree
elements:
  - { id: Operational Requirements, type: Package, name: Operational Requirements }
  - { id: OPS1, type: Boundary, name: OPS-1\nAuthors shall collaborate\non UML models in real time., parentId: Operational Requirements, stereotype: requirement }
  - { id: OPS2, type: Boundary, name: OPS-2\nAuthors shall deliver\ndiagrams to reviewers\nwithout VR hardware., parentId: Operational Requirements, stereotype: requirement }
  - { id: OPS3, type: Boundary, name: OPS-3\nThe tool shall be usable\nfor a 2-hour session without\nfatigue., parentId: Operational Requirements, stereotype: requirement }
  - { id: Functional Requirements, type: Package, name: Functional Requirements }
  - { id: FUN10, type: Boundary, name: FUN-10\nReal-time multi-user\nsynchronization of the\nscene graph., parentId: Functional Requirements, stereotype: requirement }
  - { id: FUN11, type: Boundary, name: FUN-11\nConflict resolution on\nconcurrent edits., parentId: Functional Requirements, stereotype: requirement }
  - { id: FUN20, type: Boundary, name: FUN-20\nExport diagrams to\nPNG/SVG/PDF., parentId: Functional Requirements, stereotype: requirement }
  - { id: FUN21, type: Boundary, name: FUN-21\nGenerate a read-only\nshareable web link., parentId: Functional Requirements, stereotype: requirement }
  - { id: FUN30, type: Boundary, name: FUN-30\nComfort-based locomotion\n(teleport + snap-turn)., parentId: Functional Requirements, stereotype: requirement }
  - { id: FUN31, type: Boundary, name: FUN-31\nConfigurable IPD and\nrender-scale for comfort., parentId: Functional Requirements, stereotype: requirement }
  - { id: Component Requirements, type: Package, name: Component Requirements }
  - { id: CMP100, type: Boundary, name: CMP-100\nCRDT engine shall converge\nin < 100ms p95., parentId: Component Requirements, stereotype: requirement }
  - { id: CMP101, type: Boundary, name: 'CMP-101\nPresence avatars shall\nupdate at >= 30Hz.', parentId: Component Requirements, stereotype: requirement }
  - { id: CMP200, type: Boundary, name: 'CMP-200\nRenderer shall export at\n>= 300 DPI.', parentId: Component Requirements, stereotype: requirement }
  - { id: CMP201, type: Boundary, name: CMP-201\nShare-link service shall\nauth in < 500ms., parentId: Component Requirements, stereotype: requirement }
  - { id: CMP300, type: Boundary, name: CMP-300\nFrame time shall stay\n< 11ms (90 FPS)., parentId: Component Requirements, stereotype: requirement }
  - { id: CMP301, type: Boundary, name: 'CMP-301\nDynamic foveation shall\nkeep GPU < 80% peak.', parentId: Component Requirements, stereotype: requirement }
  - { id: CRDT, type: Boundary, name: CRDT\nSync Engine, stereotype: component }
  - { id: Presence, type: Boundary, name: Presence\nService, stereotype: component }
  - { id: Exporter, type: Boundary, name: Export\nPipeline, stereotype: component }
  - { id: ShareLink, type: Boundary, name: Share-Link\nAPI, stereotype: component }
  - { id: Render, type: Boundary, name: Render\nPipeline, stereotype: component }
  - { id: TC1, type: Boundary, name: T-CRDT-Converge, stereotype: testcase }
  - { id: TC2, type: Boundary, name: T-Presence-Rate, stereotype: testcase }
  - { id: TC3, type: Boundary, name: T-Export-DPI, stereotype: testcase }
  - { id: TC4, type: Boundary, name: T-Share-Auth, stereotype: testcase }
  - { id: TC5, type: Boundary, name: T-Frame-Time, stereotype: testcase }
  - { id: TC6, type: Boundary, name: T-Foveation-Load, stereotype: testcase }
  - { id: Study, type: Artifact, name: User Study\n2026-Q1 }
  - { id: ~note1, type: Note, name: '**Rationale: why 100ms p95?**', documentation: '**Rationale: why 100ms p95?**\nBelow 100ms users perceive collaboration\nas "live"; above it, edits feel laggy and\nusers start overwriting each other.\nSource: User Study 2026-Q1 (<<trace>> link).' }
  - { id: ~note2, type: Note, name: '**Rationale: why < 11ms frame time?**', documentation: '**Rationale: why < 11ms frame time?**\n90 FPS headset refresh = 11.1ms budget.\nExceeding it causes reprojection artifacts\nand motion discomfort — directly serves OPS-3.' }
  - { id: ~note3, type: Note, name: '**Reading a deep tree**', documentation: '**Reading a deep tree**\nPick any leaf (e.g. CMP-100). Follow derive edges UP\nto find the operational need it ultimately serves.\nFollow satisfy/verify DOWN to find the code and tests\nthat implement and prove it. A broken chain anywhere\nis a coverage gap.' }
edges:
  - { id: e1, type: Derive, from: FUN10, to: OPS1, label: derive }
  - { id: e2, type: Derive, from: FUN11, to: OPS1, label: derive }
  - { id: e3, type: Derive, from: FUN20, to: OPS2, label: derive }
  - { id: e4, type: Derive, from: FUN21, to: OPS2, label: derive }
  - { id: e5, type: Derive, from: FUN30, to: OPS3, label: derive }
  - { id: e6, type: Derive, from: FUN31, to: OPS3, label: derive }
  - { id: e7, type: Derive, from: CMP100, to: FUN10, label: derive }
  - { id: e8, type: Derive, from: CMP101, to: FUN10, label: derive }
  - { id: e9, type: Refine, from: CMP200, to: FUN20, label: refine }
  - { id: e10, type: Derive, from: CMP201, to: FUN21, label: derive }
  - { id: e11, type: Derive, from: CMP300, to: FUN30, label: derive }
  - { id: e12, type: Refine, from: CMP301, to: FUN31, label: refine }
  - { id: e13, type: Satisfy, from: CRDT, to: CMP100, label: satisfy }
  - { id: e14, type: Satisfy, from: Presence, to: CMP101, label: satisfy }
  - { id: e15, type: Satisfy, from: Exporter, to: CMP200, label: satisfy }
  - { id: e16, type: Satisfy, from: ShareLink, to: CMP201, label: satisfy }
  - { id: e17, type: Satisfy, from: Render, to: CMP300, label: satisfy }
  - { id: e18, type: Satisfy, from: Render, to: CMP301, label: satisfy }
  - { id: e19, type: Verify, from: TC1, to: CMP100, label: verify }
  - { id: e20, type: Verify, from: TC2, to: CMP101, label: verify }
  - { id: e21, type: Verify, from: TC3, to: CMP200, label: verify }
  - { id: e22, type: Verify, from: TC4, to: CMP201, label: verify }
  - { id: e23, type: Verify, from: TC5, to: CMP300, label: verify }
  - { id: e24, type: Verify, from: TC6, to: CMP301, label: verify }
  - { id: e25, type: Trace, from: OPS3, to: Study, label: trace }
  - { id: e26, type: NoteLink, from: ~note1, to: CMP100 }
  - { id: e27, type: NoteLink, from: ~note2, to: CMP300 }
  - { id: e28, type: NoteLink, from: ~note3, to: OPS1 }
diagrams:
  - { id: d1, name: Requirements Traceability - Complex SysML Tree, kind: class, layoutProvenance: Synthesized }
