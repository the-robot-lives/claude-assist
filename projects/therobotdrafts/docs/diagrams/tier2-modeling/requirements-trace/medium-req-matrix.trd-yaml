# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Requirements Traceability - Medium with Matrix
elements:
  - { id: Stakeholder Requirements, type: Package, name: Stakeholder Requirements }
  - { id: STK01, type: Boundary, name: STK-01\nUsers shall author\nUML diagrams in VR., parentId: Stakeholder Requirements, stereotype: requirement }
  - { id: 'links."   as STK02', type: Boundary, name: '"STK-02\nDiagrams shall be\nshareable', parentId: Stakeholder Requirements, stereotype: requirement }
  - { id: System Requirements, type: Package, name: System Requirements }
  - { id: SYS10, type: Boundary, name: SYS-10\nProvide a 3D node\neditor canvas., parentId: System Requirements, stereotype: requirement }
  - { id: SYS11, type: Boundary, name: SYS-11\nSupport drag-link between\nnodes., parentId: System Requirements, stereotype: requirement }
  - { id: SYS20, type: Boundary, name: SYS-20\nGenerate a share URL per\ndiagram., parentId: System Requirements, stereotype: requirement }
  - { id: SYS21, type: Boundary, name: 'SYS-21\nPermissions: viewer vs\neditor roles.', parentId: System Requirements, stereotype: requirement }
  - { id: STK02, type: Class, name: STK02 }
  - { id: NodeEditor, type: Boundary, name: Node Editor\nComponent, stereotype: component }
  - { id: ShareSvc, type: Boundary, name: Sharing\nService, stereotype: component }
  - { id: T101, type: Boundary, name: T-101 Canvas\nrender test, stereotype: testcase }
  - { id: T102, type: Boundary, name: T-102 Link\ndrag test, stereotype: testcase }
  - { id: T201, type: Boundary, name: T-201 Share\nURL test, stereotype: testcase }
  - { id: T202, type: Boundary, name: T-202 Roles\npermission test, stereotype: testcase }
  - { id: ~note1, type: Note, name: '**Traceability Matrix (req x test)**', documentation: '**Traceability Matrix (req x test)**\nX = verify edge exists\n--\n| Requirement | T-101 | T-102 | T-201 | T-202 |\n|-------------|:-----:|:-----:|:-----:|:-----:|\n| SYS-10      |  X    |       |       |       |\n| SYS-11      |       |  X    |       |       |\n| SYS-20      |       |       |  X    |       |\n| SYS-21      |       |       |       |  X    |\n--\nGaps: a row with no X = unverified requirement.\nA requirement with no incoming satisfy = unsatisfied.' }
  - { id: ~note2, type: Note, name: '**deriveReqt chain**', documentation: '**deriveReqt chain**\nSTK-01 (the need)\n^-- <<derive>> -- SYS-10\n^-- <<derive>> -- SYS-11\nEach system requirement traces back to\nthe stakeholder requirement it serves.' }
edges:
  - { id: e1, type: Derive, from: SYS10, to: STK01, label: derive }
  - { id: e2, type: Derive, from: SYS11, to: STK01, label: derive }
  - { id: e3, type: Derive, from: SYS20, to: STK02, label: derive }
  - { id: e4, type: Derive, from: SYS21, to: STK02, label: derive }
  - { id: e5, type: Satisfy, from: NodeEditor, to: SYS10, label: satisfy }
  - { id: e6, type: Satisfy, from: NodeEditor, to: SYS11, label: satisfy }
  - { id: e7, type: Satisfy, from: ShareSvc, to: SYS20, label: satisfy }
  - { id: e8, type: Satisfy, from: ShareSvc, to: SYS21, label: satisfy }
  - { id: e9, type: Verify, from: T101, to: SYS10, label: verify }
  - { id: e10, type: Verify, from: T102, to: SYS11, label: verify }
  - { id: e11, type: Verify, from: T201, to: SYS20, label: verify }
  - { id: e12, type: Verify, from: T202, to: SYS21, label: verify }
  - { id: e13, type: NoteLink, from: ~note1, to: SYS21 }
  - { id: e14, type: NoteLink, from: ~note2, to: STK01 }
diagrams:
  - { id: d1, name: Requirements Traceability - Medium with Matrix, kind: class, layoutProvenance: Synthesized }
