# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Package Diagram - Enterprise System (Multiple Bounded Contexts)
elements:
  - { id: IdentityContext, type: Package, name: IdentityContext }
  - { id: Auth, type: Package, name: Auth, parentId: IdentityContext }
  - { id: Authenticator, type: Interface, name: Authenticator, parentId: Auth }
  - { id: OauthProvider, type: Class, name: OauthProvider, parentId: Auth }
  - { id: Accounts, type: Package, name: Accounts, parentId: IdentityContext }
  - { id: User, type: Class, name: User, parentId: Accounts }
  - { id: Tenant, type: Class, name: Tenant, parentId: Accounts }
  - { id: SharedKernel, type: Package, name: SharedKernel, parentId: IdentityContext }
  - { id: AuditableEntity, type: Class, name: AuditableEntity, parentId: SharedKernel }
  - { id: SalesContext, type: Package, name: SalesContext }
  - { id: Crm, type: Package, name: Crm, parentId: SalesContext }
  - { id: Lead, type: Class, name: Lead, parentId: Crm }
  - { id: Opportunity, type: Class, name: Opportunity, parentId: Crm }
  - { id: Quotes, type: Package, name: Quotes, parentId: SalesContext }
  - { id: Quote, type: Class, name: Quote, parentId: Quotes }
  - { id: QuoteLine, type: Class, name: QuoteLine, parentId: Quotes }
  - { id: FulfillmentContext, type: Package, name: FulfillmentContext }
  - { id: Orders, type: Package, name: Orders, parentId: FulfillmentContext }
  - { id: SalesOrder, type: Class, name: SalesOrder, parentId: Orders }
  - { id: OrderItem, type: Class, name: OrderItem, parentId: Orders }
  - { id: Shipping, type: Package, name: Shipping, parentId: FulfillmentContext }
  - { id: Shipment, type: Class, name: Shipment, parentId: Shipping }
  - { id: Carrier, type: Class, name: Carrier, parentId: Shipping }
  - { id: BillingContext, type: Package, name: BillingContext }
  - { id: Invoicing, type: Package, name: Invoicing, parentId: BillingContext }
  - { id: Invoice, type: Class, name: Invoice, parentId: Invoicing }
  - { id: Payments, type: Package, name: Payments, parentId: BillingContext }
  - { id: PaymentProcessor, type: Class, name: PaymentProcessor, parentId: Payments }
  - { id: Refund, type: Class, name: Refund, parentId: Payments }
  - { id: ReportingContext, type: Package, name: ReportingContext }
  - { id: Analytics, type: Package, name: Analytics, parentId: ReportingContext }
  - { id: RevenueReport, type: Class, name: RevenueReport, parentId: Analytics }
  - { id: Export, type: Package, name: Export, parentId: ReportingContext }
  - { id: CsvExporter, type: Class, name: CsvExporter, parentId: Export }
  - { id: ReportPackage, type: Package, name: ReportPackage, stereotype: abstract }
  - { id: IReportSource, type: Interface, name: IReportSource, parentId: ReportPackage }
  - { id: SharedKernel.AuditableEntity, type: Class, name: SharedKernel.AuditableEntity }
  - { id: ~note1, type: Note, name: '<b>Transitive chain:</b>', documentation: '<b>Transitive chain:</b>\nShipping --> Orders --> Quotes --> Crm\nKeep these shallow to avoid hidden coupling.' }
edges:
  - { id: e1, type: Dependency, from: Quotes, to: Crm, label: access }
  - { id: e2, type: Dependency, from: Orders, to: Quotes, label: import }
  - { id: e3, type: Dependency, from: Shipping, to: Orders, label: access }
  - { id: e4, type: Dependency, from: Invoicing, to: Orders, label: access }
  - { id: e5, type: Dependency, from: Payments, to: Invoicing, label: import }
  - { id: e6, type: Dependency, from: SalesContext, to: Auth, label: access }
  - { id: e7, type: Dependency, from: FulfillmentContext, to: Auth, label: access }
  - { id: e8, type: Dependency, from: BillingContext, to: Auth, label: access }
  - { id: e9, type: Dependency, from: ReportingContext, to: Auth, label: access }
  - { id: e10, type: Generalization, from: Analytics, to: ReportPackage, label: specializes }
  - { id: e11, type: Generalization, from: Export, to: ReportPackage, label: specializes }
  - { id: e12, type: Generalization, from: SalesOrder, to: SharedKernel.AuditableEntity }
  - { id: e13, type: Generalization, from: Invoice, to: SharedKernel.AuditableEntity }
  - { id: e14, type: NoteLink, from: ~note1, to: ReportingContext }
diagrams:
  - { id: d1, name: Example Package Diagram - Enterprise System (Multiple Bounded Contexts), kind: class, layoutProvenance: Synthesized }
