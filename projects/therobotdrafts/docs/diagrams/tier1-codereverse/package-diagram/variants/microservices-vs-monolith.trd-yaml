# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: 'Example Package Diagram - Variant: Monolith vs Microservices Packaging'
elements:
  - { id: MonolithFrame, type: Boundary, name: 'Monolith: single deployable unit' }
  - { id: ShopMonolith, type: Package, name: ShopMonolith, parentId: MonolithFrame }
  - { id: Catalog, type: Package, name: Catalog, parentId: ShopMonolith }
  - { id: ProductCatalog, type: Class, name: ProductCatalog, parentId: Catalog }
  - { id: Cart, type: Package, name: Cart, parentId: ShopMonolith }
  - { id: ShoppingCart, type: Class, name: ShoppingCart, parentId: Cart }
  - { id: Orders, type: Package, name: Orders, parentId: ShopMonolith }
  - { id: OrderService, type: Class, name: OrderService, parentId: Orders, stereotype: microservice }
  - { id: Payments, type: Package, name: Payments, parentId: ShopMonolith }
  - { id: Checkout, type: Class, name: Checkout, parentId: Payments }
  - { id: ServicesFrame, type: Boundary, name: 'Microservices: many deployable units' }
  - { id: CatalogService, type: Package, name: CatalogService, parentId: ServicesFrame, stereotype: microservice }
  - { id: CatalogApi, type: Interface, name: CatalogApi, parentId: CatalogService }
  - { id: CartService, type: Package, name: CartService, parentId: ServicesFrame, stereotype: microservice }
  - { id: CartApi, type: Interface, name: CartApi, parentId: CartService }
  - { id: OrderProcessor, type: Class, name: OrderProcessor, parentId: OrderService }
  - { id: OrderApi, type: Interface, name: OrderApi, parentId: OrderService }
  - { id: PaymentService, type: Package, name: PaymentService, parentId: ServicesFrame, stereotype: microservice }
  - { id: PaymentGateway, type: Class, name: PaymentGateway, parentId: PaymentService }
  - { id: PaymentApi, type: Interface, name: PaymentApi, parentId: PaymentService }
  - { id: ~note1, type: Note, name: '<b>Monolith trade-offs</b>', documentation: '<b>Monolith trade-offs</b>\n+ Single deployment, simple local calls\n+ Easy code reuse and refactoring\n- Must redeploy everything on any change\n- Harder to scale pieces independently' }
  - { id: ~note2, type: Note, name: '<b>Microservice trade-offs</b>', documentation: '<b>Microservice trade-offs</b>\n+ Independent deploy & scale per service\n+ Clear team/service ownership boundaries\n- Network latency + partial-failure handling\n- Operational complexity (discovery, tracing)' }
edges:
  - { id: e1, type: Dependency, from: Catalog, to: Cart, label: in-process }
  - { id: e2, type: Dependency, from: Cart, to: Orders, label: in-process }
  - { id: e3, type: Dependency, from: Orders, to: Payments, label: in-process }
  - { id: e4, type: Dependency, from: CatalogApi, to: CartApi, label: HTTPS / REST }
  - { id: e5, type: Dependency, from: CartApi, to: OrderApi, label: async event }
  - { id: e6, type: Dependency, from: OrderApi, to: PaymentApi, label: gRPC }
  - { id: e7, type: NoteLink, from: ~note1, to: MonolithFrame }
  - { id: e8, type: NoteLink, from: ~note2, to: ServicesFrame }
diagrams:
  - { id: d1, name: 'Example Package Diagram - Variant: Monolith vs Microservices Packaging', kind: class, layoutProvenance: Synthesized }
