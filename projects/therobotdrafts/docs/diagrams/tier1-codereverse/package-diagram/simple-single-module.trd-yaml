# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Package Diagram - Simple Single Module
elements:
  - { id: LibrarySystem, type: Package, name: LibrarySystem }
  - { id: Catalog, type: Package, name: Catalog, parentId: LibrarySystem }
  - { id: BookItem, type: Class, name: BookItem, parentId: Catalog }
  - { id: MediaItem, type: Class, name: MediaItem, parentId: Catalog }
  - { id: Membership, type: Package, name: Membership, parentId: LibrarySystem }
  - { id: Member, type: Class, name: Member, parentId: Membership }
  - { id: Loan, type: Class, name: Loan, parentId: Membership }
  - { id: Search, type: Package, name: Search, parentId: LibrarySystem }
  - { id: CatalogIndex, type: Class, name: CatalogIndex, parentId: Search }
  - { id: Notification, type: Package, name: Notification, parentId: LibrarySystem }
  - { id: EmailGateway, type: Class, name: EmailGateway, parentId: Notification }
edges:
  - { id: e1, type: Dependency, from: Membership, to: Catalog, label: uses }
  - { id: e2, type: Dependency, from: Search, to: Catalog, label: indexes }
  - { id: e3, type: Dependency, from: Membership, to: Notification, label: notifies }
diagrams:
  - { id: d1, name: Example Package Diagram - Simple Single Module, kind: class, layoutProvenance: Synthesized }
