# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: 'Example Deployment Diagram - Variant: Containers vs VMs'
elements:
  - { id: vms, type: Boundary, name: 'Approach A: Bare VMs (one VM per service)' }
  - { id: vmWeb, type: DeploymentNode, name: 'VM: Web', parentId: vms, stereotype: device }
  - { id: osW, type: Artifact, name: Debian 12, parentId: vmWeb, stereotype: executionEnvironment }
  - { id: webW, type: Artifact, name: web-2.0.0.jar, parentId: vmWeb, stereotype: deploy }
  - { id: vmApi, type: DeploymentNode, name: 'VM: API', parentId: vms, stereotype: device }
  - { id: osA, type: Artifact, name: Debian 12, parentId: vmApi, stereotype: executionEnvironment }
  - { id: apiA, type: Artifact, name: api-2.0.0.jar, parentId: vmApi, stereotype: deploy }
  - { id: vmWorker, type: DeploymentNode, name: 'VM: Worker', parentId: vms, stereotype: device }
  - { id: osK, type: Artifact, name: Debian 12, parentId: vmWorker, stereotype: executionEnvironment }
  - { id: workerA, type: Artifact, name: worker-2.0.0.jar, parentId: vmWorker, stereotype: deploy }
  - { id: ctr, type: Boundary, name: 'Approach B: Containers on one host' }
  - { id: host, type: DeploymentNode, name: Host Machine, parentId: ctr, stereotype: device }
  - { id: hostos, type: Artifact, name: Ubuntu 22.04, parentId: host, stereotype: executionEnvironment }
  - { id: runtime, type: Artifact, name: containerd 1.7, parentId: host, stereotype: executionEnvironment, members: [{ name: 'artifact "web:2.0.0\n', isOperation: true, visibility: Public, params: [{ name: container }], rawText: 'artifact "web:2.0.0\n(container)" as webC <<deploy>>' }, { name: 'artifact "api:2.0.0\n', isOperation: true, visibility: Public, params: [{ name: container }], rawText: 'artifact "api:2.0.0\n(container)" as apiC <<deploy>>' }, { name: 'artifact "worker:2.0.0\n', isOperation: true, visibility: Public, params: [{ name: container }], rawText: 'artifact "worker:2.0.0\n(container)" as workerC <<deploy>>' }] }
  - { id: webC, type: Component, name: webC }
  - { id: apiC, type: Component, name: apiC }
  - { id: workerC, type: Component, name: workerC }
  - { id: ~note1, type: Note, name: BARE VMs, documentation: 'BARE VMs\n--------\n+ Strong isolation (separate kernels)\n+ Simple networking (each VM = 1 IP)\n- Heavy: 3 full OS images to patch\n- Slow to start / scale (minutes)\n- One artifact per VM by design' }
  - { id: ~note2, type: Note, name: CONTAINERS ON A HOST, documentation: 'CONTAINERS ON A HOST\n--------------------\n+ Lightweight (shared kernel)\n+ Fast start / scale (seconds)\n+ Dense packing (many per host)\n- Weaker isolation (shared kernel)\n- Host kernel exploit = all containers\n- Needs a runtime (containerd / Docker)\nModeling rule: container = artifact,\nNOT a node — it has no own kernel.' }
edges:
  - { id: e1, type: DirectedAssociation, from: webW, to: apiA, label: HTTP (intra-VPC) }
  - { id: e2, type: DirectedAssociation, from: apiA, to: workerA, label: AMQP }
  - { id: e3, type: DirectedAssociation, from: webC, to: apiC, label: HTTP (loopback) }
  - { id: e4, type: DirectedAssociation, from: apiC, to: workerC, label: AMQP }
  - { id: e5, type: NoteLink, from: ~note1, to: vms }
  - { id: e6, type: NoteLink, from: ~note2, to: ctr }
diagrams:
  - { id: d1, name: 'Example Deployment Diagram - Variant: Containers vs VMs', kind: component, layoutProvenance: Synthesized }
