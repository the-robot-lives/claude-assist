# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Deployment Diagram - Medium Cloud Cluster
elements:
  - { id: net, type: Cloud, name: Internet }
  - { id: user, type: Actor, name: End User, parentId: net }
  - { id: lb, type: DeploymentNode, name: Load Balancer, stereotype: device }
  - { id: lbos, type: Artifact, name: Ubuntu 22.04, parentId: lb, stereotype: executionEnvironment }
  - { id: haproxy, type: Artifact, name: HAProxy 2.8, parentId: lb, stereotype: deploy }
  - { id: app1, type: DeploymentNode, name: App Node 1, stereotype: device }
  - { id: b1, type: Artifact, name: UML-IDE Backend\n1.0.0.jar, parentId: app1, stereotype: deploy }
  - { id: app2, type: DeploymentNode, name: App Node 2, stereotype: device }
  - { id: b2, type: Artifact, name: UML-IDE Backend\n1.0.0.jar, parentId: app2, stereotype: deploy }
  - { id: app3, type: DeploymentNode, name: App Node 3, stereotype: device }
  - { id: b3, type: Artifact, name: UML-IDE Backend\n1.0.0.jar, parentId: app3, stereotype: deploy }
  - { id: cache, type: Database, name: Redis Cache, stereotype: database }
  - { id: redis, type: Artifact, name: redis-server\n7.2, parentId: cache, stereotype: deploy }
  - { id: db, type: Database, name: PostgreSQL, stereotype: database }
  - { id: schema, type: Artifact, name: UML-IDE Schema\n1.0.0.sql, parentId: db, stereotype: deploy }
  - { id: ~note1, type: Note, name: 'Shared cache: all three app nodes', documentation: 'Shared cache: all three app nodes\nread/write the SAME keys.\nCache invalidation must be\ncluster-aware.' }
edges:
  - { id: e1, type: DirectedAssociation, from: user, to: lb, label: HTTPS }
  - { id: e2, type: DirectedAssociation, from: lb, to: app1, label: HTTP (round-robin) }
  - { id: e3, type: DirectedAssociation, from: lb, to: app2, label: HTTP (round-robin) }
  - { id: e4, type: DirectedAssociation, from: lb, to: app3, label: HTTP (round-robin) }
  - { id: e5, type: DirectedAssociation, from: app1, to: cache, label: 'TCP/Redis :6379' }
  - { id: e6, type: DirectedAssociation, from: app2, to: cache, label: 'TCP/Redis :6379' }
  - { id: e7, type: DirectedAssociation, from: app3, to: cache, label: 'TCP/Redis :6379' }
  - { id: e8, type: DirectedAssociation, from: app1, to: db, label: 'JDBC :5432' }
  - { id: e9, type: DirectedAssociation, from: app2, to: db, label: 'JDBC :5432' }
  - { id: e10, type: DirectedAssociation, from: app3, to: db, label: 'JDBC :5432' }
  - { id: e11, type: NoteLink, from: ~note1, to: cache }
diagrams:
  - { id: d1, name: Example Deployment Diagram - Medium Cloud Cluster, kind: component, layoutProvenance: Synthesized }
