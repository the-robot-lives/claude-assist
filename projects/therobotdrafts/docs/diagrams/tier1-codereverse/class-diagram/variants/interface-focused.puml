@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Demonstrates the Interface Segregation Principle, multiple-interface implementation, and API boundary design
'   usecase:      Educational example showing how interfaces define contracts and how classes realize multiple contracts
'   complexity:   medium
'   domain:       System Architecture
' ============================================================================
title Example Class Diagram - Interface-Focused System Contracts

' ============================================================
' This variant focuses on INTERFACES as first-class citizens.
' Interfaces define WHAT a system promises to do; classes define
' HOW it does it. Small, focused interfaces (ISP) let clients
' depend only on the surface area they actually need.
' ============================================================

' ============================================================
' CORE INTERFACES - small, focused contracts.
' Each interface addresses one capability. This is the Interface
' Segregation Principle: prefer many narrow interfaces over one
' fat interface, so clients aren't forced to depend on members
' they never call.
' ============================================================

' Anything that can be authenticated (login, token refresh)
interface IAuthenticatable {
  +authenticate(credentials: Credentials): AuthResult
  +refreshToken(token: Token): Token
  +logout(): void
}

' Anything that can be authorized (permission checks, roles)
interface IAuthorizable {
  +hasPermission(permission: String): Boolean
  +hasRole(role: String): Boolean
  +grantRole(role: String): void
  +revokeRole(role: String): void
}

' Anything whose state can be persisted (save/load lifecycle)
interface IPersistable {
  +save(): PersistResult
  +load(id: UUID): Boolean
  +delete(): Boolean
}

' Anything that can be serialized for transport/storage
interface ISerializable {
  +serialize(): String
  +deserialize(data: String): void
}

' Anything that emits lifecycle events for observers to react to
interface IObservable {
  +subscribe(observer: IObserver): void
  +unsubscribe(observer: IObserver): void
  +notify(event: DomainEvent): void
}

' Observer counterpart to IObservable (the subscriber side)
interface IObserver {
  +onEvent(event: DomainEvent): void
}

' ============================================================
' A SINGLE CLASS IMPLEMENTING MULTIPLE INTERFACES.
' UserAccount realizes FOUR contracts: it can be authenticated,
' authorized, persisted, and serialized. This is perfectly legal
' in UML and in most languages (Java/C#/TypeScript). Each
' realization arrow (..|>) connects the class to one interface.
' ============================================================
class UserAccount {
  -userId: UUID
  -username: String
  -emailHash: String
  -roles: Set<String>
  -permissions: Set<String>
  -state: AccountState
  -observers: List<IObserver>
  +authenticate(credentials: Credentials): AuthResult
  +refreshToken(token: Token): Token
  +logout(): void
  +hasPermission(permission: String): Boolean
  +hasRole(role: String): Boolean
  +grantRole(role: String): void
  +revokeRole(role: String): void
  +save(): PersistResult
  +load(id: UUID): Boolean
  +delete(): Boolean
  +serialize(): String
  +deserialize(data: String): void
  +subscribe(observer: IObserver): void
  +unsubscribe(observer: IObserver): void
  +notify(event: DomainEvent): void
}

' ============================================================
' ApiClient implements a DIFFERENT mix of interfaces.
' It is authenticatable and serializable, but NOT authorizable
' (it has no roles) and NOT persistable in the same sense.
' This selective implementation is exactly what ISP enables.
' ============================================================
class ApiClient {
  -clientId: UUID
  -apiKey: String
  -token: Token
  -endpoints: Map<String, URL>
  +authenticate(credentials: Credentials): AuthResult
  +refreshToken(token: Token): Token
  +logout(): void
  +serialize(): String
  +deserialize(data: String): void
  +request(endpoint: String, payload: Payload): Response
}

' ============================================================
' AuditLog implements a THIRD combination.
' It is persistable, serializable, and observable - but not
' authenticatable or authorizable (it's an internal component).
' ============================================================
class AuditLog {
  -logId: UUID
  -entries: List<AuditEntry>
  -observers: List<IObserver>
  +save(): PersistResult
  +load(id: UUID): Boolean
  +delete(): Boolean
  +serialize(): String
  +deserialize(data: String): void
  +subscribe(observer: IObserver): void
  +unsubscribe(observer: IObserver): void
  +notify(event: DomainEvent): void
  +append(entry: AuditEntry): void
}

' ============================================================
' CONCRETE OBSERVER - implements only the IObserver contract.
' Demonstrates a class realizing a SINGLE interface.
' ============================================================
class NotificationDispatcher {
  -channels: List<NotificationChannel>
  +onEvent(event: DomainEvent): void
  +dispatch(notification: Notification): void
}

' ============================================================
' SUPPORTING VALUE OBJECTS (no interface, structural only)
' ============================================================
class Credentials {
  -identifier: String
  -secret: String
  -mfaCode: String
}

class DomainEvent {
  -eventId: UUID
  -eventType: String
  -payload: Map<String, Object>
  -timestamp: DateTime
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- Multiple realization: UserAccount implements four contracts ---
UserAccount ..|> IAuthenticatable
UserAccount ..|> IAuthorizable
UserAccount ..|> IPersistable
UserAccount ..|> ISerializable
UserAccount ..|> IObservable

' --- Selective realization: ApiClient implements two contracts ---
ApiClient ..|> IAuthenticatable
ApiClient ..|> ISerializable

' --- AuditLog implements three contracts (different mix) ---
AuditLog ..|> IPersistable
AuditLog ..|> ISerializable
AuditLog ..|> IObservable

' --- NotificationDispatcher implements the single observer contract ---
NotificationDispatcher ..|> IObserver

' --- Association: observable subjects keep observer references ---
' IObservable classes subscribe IObserver instances at runtime.
UserAccount "1" --> "*" IObserver : notifies
AuditLog "1" --> "*" IObserver : notifies

' --- Dependency: authenticate() consumes Credentials ---
UserAccount ..> Credentials : verifies
ApiClient ..> Credentials : verifies

' --- Dependency: notify() emits DomainEvent objects ---
UserAccount ..> DomainEvent : emits
AuditLog ..> DomainEvent : emits

' --- Association: NotificationDispatcher routes to channels ---
NotificationDispatcher "1" --> "*" NotificationChannel : sends via

' Placeholder so the channel reference resolves visually
class NotificationChannel << (S,#Aquamarine) stereotype >> {
  +send(notification: Notification): Boolean
}

@enduml
