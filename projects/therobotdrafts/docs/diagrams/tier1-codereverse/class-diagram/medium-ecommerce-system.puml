@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Demonstrates multiple relationship types, interface realization, composition, and aggregation in an e-commerce domain
'   usecase:      Educational example showing interface contracts, composition vs aggregation, and association links
'   complexity:   medium
'   domain:       E-Commerce
' ============================================================================
title Example Class Diagram - Medium E-Commerce System

' ============================================================
' INTERFACE - defines a contract that payment providers fulfill.
' Interfaces have no implementation; they declare operations only.
' Classes implement (realize) interfaces using the ..|> arrow.
' ============================================================
interface IPaymentGateway {
  +processPayment(amount: Decimal, card: PaymentMethod): PaymentResult
  +refund(transactionId: String): RefundResult
  +verifyPayment(transactionId: String): Boolean
}

' ============================================================
' ABSTRACT BASE - defines shared shape that payment gateways
' extend. Abstract classes cannot be instantiated directly.
' Concrete subclasses provide the implementation via --|> (inheritance).
' ============================================================
abstract class BasePaymentGateway {
  #merchantId: String
  #apiKey: String
  #sandboxMode: Boolean
  +logTransaction(tx: PaymentTransaction): void
  {abstract} +processPayment(amount: Decimal, card: PaymentMethod): PaymentResult
}

' StripeGateway inherits from BasePaymentGateway (solid triangle --|>)
' and realizes the IPaymentGateway contract (dashed triangle ..|>)
class StripeGateway {
  -webhookSecret: String
  +processPayment(amount: Decimal, card: PaymentMethod): PaymentResult
  +refund(transactionId: String): RefundResult
  +verifyPayment(transactionId: String): Boolean
}

' PayPalGateway - second implementation of the same interface
class PayPalGateway {
  -partnerId: String
  +processPayment(amount: Decimal, card: PaymentMethod): PaymentResult
  +refund(transactionId: String): RefundResult
  +verifyPayment(transactionId: String): Boolean
}

' ============================================================
' Customer - the entity that places orders.
' --> is a directed ASSOCIATION (Customer knows about its Orders).
' ============================================================
class Customer {
  -customerId: String
  -email: String
  -displayName: String
  -shippingAddresses: List<Address>
  +placeOrder(items: List<CartItem>): Order
  +cancelOrder(orderId: String): Boolean
  +getOrderHistory(): List<Order>
}

' ============================================================
' Product - the catalog item being sold.
' Inventory AGGREGATES Product (hollow diamond o--): Inventory
' references Products but does not own their lifecycle.
' ============================================================
class Product {
  -sku: String
  -name: String
  -price: Decimal
  -description: String
  +updatePrice(newPrice: Decimal): void
  +getAvailability(): Integer
}

' Inventory manages stock levels; aggregates (not owns) Products
class Inventory {
  -warehouseId: String
  -stockLevels: Map<Product, Integer>
  +reserveStock(product: Product, qty: Integer): Boolean
  +releaseStock(product: Product, qty: Integer): void
  +reorder(product: Product): void
}

' ============================================================
' COMPOSITION - Order COMPOSES OrderItem (filled diamond *--).
' This means OrderItems cannot exist without their parent Order;
' deleting the Order deletes its OrderItems (lifecycle ownership).
' ============================================================
class Order {
  -orderId: String
  -status: OrderStatus
  -placedAt: DateTime
  -total: Decimal
  +addItem(item: OrderItem): void
  +calculateTotal(): Decimal
  +checkout(payment: IPaymentGateway): PaymentResult
  +ship(service: ShippingService): TrackingInfo
}

' OrderItem is a VALUE OBJECT composed inside Order.
' No identity of its own; exists only within an Order.
class OrderItem {
  -product: Product
  -quantity: Integer
  -unitPrice: Decimal
  +lineTotal(): Decimal
}

' ============================================================
' Payment - the record of a completed transaction.
' Order has a DEPENDENCY (dashed arrow ..>) on IPaymentGateway
' because checkout() uses the gateway without owning it.
' ============================================================
class Payment {
  -paymentId: String
  -amount: Decimal
  -method: PaymentMethod
  -processedAt: DateTime
  +isSuccessful(): Boolean
  +getReceipt(): Receipt
}

' ShippingService - handles fulfillment logistics
class ShippingService {
  -carrier: String
  -apiEndpoint: String
  +createShipment(order: Order): Shipment
  +trackShipment(trackingId: String): TrackingInfo
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' Realization: concrete gateways implement the interface contract
StripeGateway ..|> IPaymentGateway
PayPalGateway ..|> IPaymentGateway

' Inheritance: gateways extend the abstract base
StripeGateway --|> BasePaymentGateway
PayPalGateway --|> BasePaymentGateway
BasePaymentGateway ..|> IPaymentGateway

' Association: a Customer owns multiple Orders (directed)
Customer "1" --> "*" Order : places

' Composition: Order owns its OrderItems (lifecycle bound)
Order "1" *-- "*" OrderItem : contains

' Aggregation: Inventory references Products (no ownership)
Inventory "1" o-- "*" Product : stocks

' Association: OrderItem references a Product
OrderItem "*" --> "1" Product : references

' Dependency: Order uses IPaymentGateway at checkout (transient)
Order ..> IPaymentGateway : uses at checkout

' Association: a successful checkout produces a Payment
Order "1" --> "0..1" Payment : produces

' Association: Order collaborates with ShippingService for fulfillment
Order ..> ShippingService : ships via

@enduml
