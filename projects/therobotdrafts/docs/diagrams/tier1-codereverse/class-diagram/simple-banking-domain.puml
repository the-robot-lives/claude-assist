@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Demonstrates basic UML class relationships, inheritance, and associations
'   usecase:      Educational example showing fundamental UML class concepts
'   complexity:   simple
'   domain:       Banking
' ============================================================================
title Example Class Diagram - Simple Banking Domain

' Customer class - represents bank customers
class Customer {
  -customerId: String
  -name: String
  -email: String
  -phone: String
  +register(): void
  +updateProfile(name: String, email: String): void
  +getAccounts(): List<Account>
}

' Account class - base class for different account types
abstract class Account {
  -accountNumber: String
  -balance: Decimal
  -owner: Customer
  +deposit(amount: Decimal): Boolean
  +withdraw(amount: Decimal): Boolean
  +getBalance(): Decimal
  +isValidWithdrawal(amount: Decimal): Boolean
}

' SavingsAccount inherits from Account
class SavingsAccount {
  -interestRate: Decimal
  -minimumBalance: Decimal
  +applyInterest(): void
  +calculateInterest(): Decimal
}

' CheckingAccount inherits from Account
class CheckingAccount {
  -overdraftLimit: Decimal
  -monthlyFee: Decimal
  +setOverdraftLimit(limit: Decimal): void
  +processMonthlyFee(): void
}

' Transaction represents account activities
class Transaction {
  -transactionId: String
  -amount: Decimal
  -timestamp: DateTime
  -type: TransactionType
  +getDescription(): String
  +isValid(): Boolean
}

' Relationship definitions
Customer "1" --> "*" Account : owns
Account "1" --> "*" Transaction : contains
SavingsAccount --|> Account : extends
CheckingAccount --|> Account : extends

@enduml