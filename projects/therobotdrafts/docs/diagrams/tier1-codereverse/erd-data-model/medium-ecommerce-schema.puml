@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Demonstrates PK/FK, one-to-many, many-to-many via join table, identifying vs non-identifying relationships, NOT NULL and unique column markers
'   usecase:      Educational example showing intermediate ERD techniques on a six-table e-commerce schema
'   complexity:   medium
'   domain:       E-Commerce
' ============================================================================
title Example ERD - Medium E-Commerce Schema

' ============================================================
' COLUMN ANNOTATION CONVENTION
'   *         = primary key column
'   <<PK>>    = primary key (explicit tag)
'   <<FK>>    = foreign key column
'   <<UK>>    = unique constraint (alternate key)
'   NN        = NOT NULL (no nulls allowed)
'   NULL      = nullable column
'   The double-dash -- separates the key block from data columns.
' ============================================================

' ------------------------------------------------------------
' CUSTOMER - the person who places orders.
' email is marked <<UK>> NN: unique and not null (a natural key).
' ------------------------------------------------------------
entity "Customer" as customer {
  * customer_id : BIGINT <<PK>>
  --
  email : VARCHAR(255) <<UK>> NN
  display_name : VARCHAR(100) NN
  phone : VARCHAR(30) NULL
}

' ------------------------------------------------------------
' ADDRESS - shipping/billing addresses owned by a Customer.
' The FK customer_id is NOT NULL (every address belongs to
' someone). One Customer has many Addresses.
' ------------------------------------------------------------
entity "Address" as address {
  * address_id : BIGINT <<PK>>
  --
  customer_id : BIGINT <<FK>> NN
  street_line : VARCHAR(200) NN
  city : VARCHAR(100) NN
  postal_code : VARCHAR(20) NN
  country_code : CHAR(2) NN
}

' ------------------------------------------------------------
' CATEGORY - product taxonomy. Products belong to categories.
' ------------------------------------------------------------
entity "Category" as category {
  * category_id : INT <<PK>>
  --
  name : VARCHAR(80) <<UK>> NN
  parent_category_id : INT <<FK>> NULL
}

' ------------------------------------------------------------
' PRODUCT - a sellable catalog item.
' sku is a UNIQUE natural key (not the PK, but still unique).
' category_id is a nullable FK (a product may be uncategorized).
' ------------------------------------------------------------
entity "Product" as product {
  * product_id : BIGINT <<PK>>
  --
  sku : VARCHAR(40) <<UK>> NN
  name : VARCHAR(200) NN
  price : DECIMAL(10,2) NN
  category_id : BIGINT <<FK>> NULL
}

' ------------------------------------------------------------
' ORDER_HEADER - a customer's purchase order (header level).
' The FK customer_id references the ordering customer.
' The FK shipping_address_id references the delivery address.
' Two FKs point at different sides of the same Customer concept.
' ------------------------------------------------------------
entity "OrderHeader" as order_header {
  * order_id : BIGINT <<PK>>
  --
  customer_id : BIGINT <<FK>> NN
  shipping_address_id : BIGINT <<FK>> NN
  order_date : TIMESTAMP NN
  status : VARCHAR(20) NN
}

' ------------------------------------------------------------
' ORDER_ITEM - a line within an order (the join/detail child).
' This table resolves the many-to-many between Order and Product:
' an order contains many products, and a product appears on many
' orders. The pair (order_id, product_id) could itself be a
' composite alternate key.
' ------------------------------------------------------------
entity "OrderItem" as order_item {
  * order_item_id : BIGINT <<PK>>
  --
  order_id : BIGINT <<FK>> NN
  product_id : BIGINT <<FK>> NN
  quantity : INT NN
  unit_price : DECIMAL(10,2) NN
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' ---- One-to-many (non-identifying) ----
' A Customer owns multiple Addresses. NON-IDENTIFYING: Address
' has its own surrogate PK (address_id), so it can theoretically
' be reparented. Drawn with a solid line + crow's-foot.
customer ||--o{ address : "lives at"

' ---- One-to-many (self-referencing) ----
' Category can have a parent Category (tree structure).
' Self-loop: the same entity on both ends.
category ||--o{ category : "has subcategory"

' ---- One-to-many: Category to Product ----
category ||--o{ product : "classifies"

' ---- Identifying relationship (dashed line) ----
' OrderItem's existence DEPENDS on its parent Order: if the
' Order is deleted, its line items vanish. This is an
' IDENTIFYING relationship. PlantUML draws it with the same
' crow's-foot, but the FK column (order_id) is part of the
' child's logical identity. The .|.. notation (dashed) signals
' weak/identifying in some tools; here we use ||--|{ to show
' "one-to-one-or-many" (an order must have at least one item
' to be meaningful).
order_header ||--|{ order_item : "contains"

' ---- Many-to-many resolved by join table ----
' The conceptual many-to-many between OrderHeader and Product
' is materialized by OrderItem. We show BOTH sides explicitly:
order_header ||--o{ order_item : "has lines"
product ||--o{ order_item : "appears in"

' ---- One-to-many: Customer to OrderHeader ----
customer ||--o{ order_header : "places"

' ---- One-to-one: OrderHeader to shipping Address ----
' Each order ships to exactly one address. ||--|| would be
' strict one-to-one; here we use ||--o{ because an Address can
' serve many orders over time (reuse).
order_header }o--|| address : "ships to"

' ============================================================
' KEY TAKEAWAYS
'   1. MANY-TO-MANY is always implemented as a JOIN TABLE
'      (OrderItem) with two FKs - one per parent. Never draw a
'      direct M:N line in a physical model.
'   2. IDENTIFYING vs NON-IDENTIFYING:
'        - Non-identifying: child has its own PK; FK is just
'          a reference. Child can survive parent deletion.
'        - Identifying: child's PK includes the parent FK;
'          child cannot exist without the parent.
'   3. <<UK>> marks UNIQUE columns (natural/alternate keys).
'   4. NN / NULL documents nullability.
'   5. Self-referencing FKs (parent_category_id) model trees.
' ============================================================

@enduml
