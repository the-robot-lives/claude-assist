# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: 'Example ERD - Crow''s-Foot vs IE vs Simple Multiplicity'
elements:
  - { id: cust_a, type: Table, name: Customer, members: [{ name: '* customer_id', isOperation: false, visibility: Public, type: 'BIGINT <<PK>>', rawText: '* customer_id : BIGINT <<PK>>' }, { name: 'email : VARCHAR', isOperation: true, visibility: Public, params: [{ name: 255 }], rawText: 'email : VARCHAR(255) NN' }, { name: 'name : VARCHAR', isOperation: true, visibility: Public, params: [{ name: 100 }], rawText: 'name : VARCHAR(100) NN' }] }
  - { id: ord_a, type: Table, name: Order, members: [{ name: '* order_id', isOperation: false, visibility: Public, type: 'BIGINT <<PK>>', rawText: '* order_id : BIGINT <<PK>>' }, { name: customer_id, isOperation: false, visibility: Public, type: 'BIGINT <<FK>> NN', rawText: 'customer_id : BIGINT <<FK>> NN' }, { name: order_date, isOperation: false, visibility: Public, type: TIMESTAMP NN, rawText: 'order_date : TIMESTAMP NN' }] }
  - { id: cust_b, type: Table, name: Customer, members: [{ name: '* customer_id', isOperation: false, visibility: Public, type: 'BIGINT <<PK>>', rawText: '* customer_id : BIGINT <<PK>>' }, { name: 'email : VARCHAR', isOperation: true, visibility: Public, params: [{ name: 255 }], rawText: 'email : VARCHAR(255) NN' }, { name: 'name : VARCHAR', isOperation: true, visibility: Public, params: [{ name: 100 }], rawText: 'name : VARCHAR(100) NN' }] }
  - { id: ord_b, type: Table, name: Order, members: [{ name: '* order_id', isOperation: false, visibility: Public, type: 'BIGINT <<PK>>', rawText: '* order_id : BIGINT <<PK>>' }, { name: customer_id, isOperation: false, visibility: Public, type: 'BIGINT <<FK>> NN', rawText: 'customer_id : BIGINT <<FK>> NN' }, { name: order_date, isOperation: false, visibility: Public, type: TIMESTAMP NN, rawText: 'order_date : TIMESTAMP NN' }] }
  - { id: cust_c, type: Table, name: Customer, members: [{ name: '* customer_id', isOperation: false, visibility: Public, type: 'BIGINT <<PK>>', rawText: '* customer_id : BIGINT <<PK>>' }, { name: 'email : VARCHAR', isOperation: true, visibility: Public, params: [{ name: 255 }], rawText: 'email : VARCHAR(255) NN' }, { name: 'name : VARCHAR', isOperation: true, visibility: Public, params: [{ name: 100 }], rawText: 'name : VARCHAR(100) NN' }] }
  - { id: ord_c, type: Table, name: Order, members: [{ name: '* order_id', isOperation: false, visibility: Public, type: 'BIGINT <<PK>>', rawText: '* order_id : BIGINT <<PK>>' }, { name: customer_id, isOperation: false, visibility: Public, type: 'BIGINT <<FK>> NN', rawText: 'customer_id : BIGINT <<FK>> NN' }, { name: order_date, isOperation: false, visibility: Public, type: TIMESTAMP NN, rawText: 'order_date : TIMESTAMP NN' }] }
  - { id: ~note1, type: Note, name: '<b>Style 1: IE Crow''s-Foot</b>', documentation: '<b>Style 1: IE Crow''s-Foot</b>\nThe symbol at each endpoint encodes\ncardinality directly.\n|| = one      o{ = zero-or-many\nThis is the most common style in\nmodern database tools.' }
  - { id: ~note2, type: Note, name: '<b>Style 2: Chen / Look-Across</b>', documentation: '<b>Style 2: Chen / Look-Across</b>\nCardinality numbers sit ON the line.\nRead by looking across to the opposite\nentity''s end. Often uses 1 / N / M or\n(0,n) / (1,1) style labels.\nCommon in academic textbooks.' }
  - { id: ~note3, type: Note, name: '<b>Style 3: Simple UML Multiplicity</b>', documentation: '<b>Style 3: Simple UML Multiplicity</b>\nMinimal labels: 1, 0..1, *, 1..*\nBorrowed from UML class diagrams.\nLightweight; no endpoint symbols.\nGood for quick whiteboard sketches.' }
  - { id: ComparisonNote, type: Class, name: ComparisonNote }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: cust_a }
  - { id: e2, type: NoteLink, from: ~note2, to: cust_b }
  - { id: e3, type: Association, from: cust_b, to: ord_b, label: '"places (Chen)"', fromMultiplicity: 1, toMultiplicity: 0..N }
  - { id: e4, type: NoteLink, from: ~note3, to: cust_c }
  - { id: e5, type: Association, from: cust_c, to: ord_c, label: '"places (UML)"', fromMultiplicity: 1, toMultiplicity: '*' }
  - { id: e6, type: Dependency, from: ord_a, to: ComparisonNote }
  - { id: e7, type: Dependency, from: ComparisonNote, to: ord_b }
diagrams:
  - { id: d1, name: 'Example ERD - Crow''s-Foot vs IE vs Simple Multiplicity', kind: class, layoutProvenance: Synthesized }
