@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Demonstrates composite primary keys, multiple FKs per table, lookup/reference tables, inheritance-ish subtype patterns, audit columns, and complex cardinality across a 16-table HR/Payroll schema
'   usecase:      Educational example showing advanced physical data-modeling techniques found in real enterprise ERP systems
'   complexity:   complex
'   domain:       Enterprise HR / Payroll
' ============================================================================
title Example ERD - Complex Enterprise Database

' ============================================================
' COLUMN ANNOTATION CONVENTION
'   *         = member of the primary key (composite PK = multiple *)
'   <<PK>>    = primary key tag
'   <<FK>>    = foreign key
'   <<UK>>    = unique / alternate key
'   <<LK>>    = lookup / reference table
'   NN        = NOT NULL
'   NULL      = nullable
'   AUDIT     = audit-tracking column (created_by / updated_at etc.)
' ============================================================

' ============================================================
' LOOKUP / REFERENCE TABLES
' Small enumerated tables that constrain a column to a fixed
' set of codes (status, type, etc.). Marked <<LK>>. These are
' the backbone of a normalized enterprise schema: instead of
' a VARCHAR status that could be anything, you point a FK at
' a lookup so only valid codes are allowed.
' ============================================================

entity "EmploymentStatus" as emp_status <<LK>> {
  * status_code : VARCHAR(20) <<PK>>
  --
  label : VARCHAR(60) NN
  is_active : BOOLEAN NN
}

entity "DepartmentType" as dept_type <<LK>> {
  * dept_type_code : VARCHAR(20) <<PK>>
  --
  label : VARCHAR(60) NN
}

entity "PayFrequency" as pay_freq <<LK>> {
  * frequency_code : CHAR(2) <<PK>>
  --
  label : VARCHAR(40) NN
  periods_per_year : INT NN
}

entity "Country" as country <<LK>> {
  * iso_code : CHAR(2) <<PK>>
  --
  name : VARCHAR(100) NN
  currency_code : CHAR(3) NN
}

' ============================================================
' ORGANIZATIONAL STRUCTURE
' ============================================================

' Department - an org unit. Uses a SURROGATE PK (department_id)
' but also carries cost_center as a UNIQUE natural key.
entity "Department" as department {
  * department_id : INT <<PK>>
  --
  name : VARCHAR(120) NN
  cost_center : VARCHAR(20) <<UK>> NN
  dept_type_code : VARCHAR(20) <<FK>> NN
  parent_dept_id : INT <<FK>> NULL
  budget_annual : DECIMAL(14,2) NULL
  created_at : TIMESTAMP AUDIT NN
  updated_at : TIMESTAMP AUDIT NN
}

' ============================================================
' PERSON / EMPLOYEE INHERITANCE PATTERN
' There is no true "inheritance" in a relational DB. The common
' pattern is a BASE TABLE (Person) holding shared attributes,
' plus SUBTYPE TABLES (SalariedEmployee, HourlyEmployee) that
' share the same PK and add subtype-specific columns.
' This is called "table-per-subclass" or "class table inheritance".
' ============================================================

entity "Person" as person {
  * person_id : BIGINT <<PK>>
  --
  tax_id_hash : CHAR(64) <<UK>> NN
  first_name : VARCHAR(80) NN
  last_name : VARCHAR(80) NN
  birth_date : DATE NULL
  country_code : CHAR(2) <<FK>> NN
  created_at : TIMESTAMP AUDIT NN
  updated_at : TIMESTAMP AUDIT NN
}

entity "Employee" as employee {
  * person_id : BIGINT <<PK, FK>>
  --
  employee_number : VARCHAR(20) <<UK>> NN
  department_id : INT <<FK>> NN
  status_code : VARCHAR(20) <<FK>> NN
  hire_date : DATE NN
  termination_date : DATE NULL
  frequency_code : CHAR(2) <<FK>> NN
}

' SalariedEmployee - subtype sharing Employee's PK (1:1 with Employee)
entity "SalariedEmployee" as salaried {
  * person_id : BIGINT <<PK, FK>>
  --
  annual_salary : DECIMAL(12,2) NN
  bonus_target_pct : DECIMAL(5,2) NULL
}

' HourlyEmployee - the other subtype, same shared PK
entity "HourlyEmployee" as hourly {
  * person_id : BIGINT <<PK, FK>>
  --
  hourly_rate : DECIMAL(8,2) NN
  standard_hours : DECIMAL(4,1) NULL
}

' ============================================================
' ADDRESS (composite-indexed, multi-type)
' ============================================================

entity "Address" as address {
  * address_id : BIGINT <<PK>>
  --
  person_id : BIGINT <<FK>> NN
  address_type : VARCHAR(15) NN
  street_line : VARCHAR(200) NN
  city : VARCHAR(100) NN
  postal_code : VARCHAR(20) NN
  country_code : CHAR(2) <<FK>> NN
}

' ============================================================
' PAYROLL TRANSACTIONS
' PayrollRun is a batch; Paycheck belongs to one run + one employee.
' PaycheckDeduction is a child with a COMPOSITE PK.
' ============================================================

entity "PayrollRun" as payroll_run {
  * payroll_run_id : BIGINT <<PK>>
  --
  run_date : DATE NN
  period_start : DATE NN
  period_end : DATE NN
  frequency_code : CHAR(2) <<FK>> NN
  status : VARCHAR(20) NN
}

entity "Paycheck" as paycheck {
  * paycheck_id : BIGINT <<PK>>
  --
  payroll_run_id : BIGINT <<FK>> NN
  person_id : BIGINT <<FK>> NN
  gross_amount : DECIMAL(12,2) NN
  net_amount : DECIMAL(12,2) NN
  issued_at : TIMESTAMP NN
}

' COMPOSITE PRIMARY KEY example: the PK spans TWO columns.
' (deduction_id alone could be a surrogate PK, but here we show
'  the composite pattern: paycheck_id + deduction_code together
'  uniquely identify a deduction line and encode the parent link.)
entity "PaycheckDeduction" as deduction {
  * paycheck_id : BIGINT <<PK, FK>>
  * deduction_code : VARCHAR(20) <<PK>>
  --
  amount : DECIMAL(10,2) NN
  tax_flag : BOOLEAN NN
}

' ============================================================
' TIME / LEAVE TRACKING
' TimeSheet has a composite FK to (employee, period).
' TimeEntry is a detail child with its own surrogate PK.
' ============================================================

entity "TimeSheet" as timesheet {
  * timesheet_id : BIGINT <<PK>>
  --
  person_id : BIGINT <<FK>> NN
  period_start : DATE NN
  period_end : DATE NN
  approved_by : BIGINT <<FK>> NULL
  status : VARCHAR(20) NN
}

entity "TimeEntry" as time_entry {
  * time_entry_id : BIGINT <<PK>>
  --
  timesheet_id : BIGINT <<FK>> NN
  work_date : DATE NN
  hours : DECIMAL(4,2) NN
  department_id : INT <<FK>> NULL
}

' ============================================================
' PROJECT BILLING (cross-references employees + departments)
' ============================================================

entity "Project" as project {
  * project_id : BIGINT <<PK>>
  --
  name : VARCHAR(150) NN
  owning_dept_id : INT <<FK>> NN
  start_date : DATE NN
  end_date : DATE NULL
  budget : DECIMAL(14,2) NULL
}

' ProjectAssignment resolves a many-to-many between Project and
' Employee, with a role column on the link.
entity "ProjectAssignment" as assignment {
  * project_id : BIGINT <<PK, FK>>
  * person_id : BIGINT <<PK, FK>>
  --
  role : VARCHAR(40) NN
  allocation_pct : DECIMAL(5,2) NN
}

' ============================================================
' AUDIT LOG (generic change-tracking table)
' ============================================================

entity "AuditLog" as audit_log {
  * audit_id : BIGINT <<PK>>
  --
  table_name : VARCHAR(60) NN
  row_pk : VARCHAR(40) NN
  action : VARCHAR(10) NN
  changed_by : BIGINT NN
  changed_at : TIMESTAMP NN
  old_value : TEXT NULL
  new_value : TEXT NULL
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' ---- Lookup references ----
emp_status ||--o{ employee : "constrains"
dept_type ||--o{ department : "classifies"
pay_freq ||--o{ employee : "paid every"
pay_freq ||--o{ payroll_run : "schedule"
country ||--o{ person : "nationality"
country ||--o{ address : "located in"

' ---- Department hierarchy (self-reference) ----
department ||--o{ department : "parent of"
dept_type ||--o{ department : "type of"

' ---- Person -> Employee (1:0..1 subtype discriminator) ----
' A Person MAY be an Employee. One-to-zero-or-one.
person ||--o| employee : "is employed as"

' ---- Employee subtypes (1:0..1 each; discriminator pattern) ----
' Exactly one subtype row exists per Employee (salaried OR hourly).
' ||--o| = one-to-zero-or-one.
employee ||--o| salaried : "salaried detail"
employee ||--o| hourly : "hourly detail"

' ---- Department employs Employees ----
department ||--o{ employee : "employs"

' ---- Person addresses ----
person ||--o{ address : "resides at"

' ---- Payroll ----
payroll_run ||--o{ paycheck : "produces"
employee ||--o{ paycheck : "earns"

' PaycheckDeduction: COMPOSITE FK to Paycheck.
' The child's PK includes the parent PK column (identifying).
paycheck ||--|{ deduction : "itemized as"

' ---- Time tracking ----
employee ||--o{ timesheet : "submits"
timesheet ||--o{ time_entry : "contains"
time_entry }o--|| department : "charged to (optional)"
employee ||--o{ timesheet : "approves"

' ---- Project billing ----
department ||--o{ project : "owns"
project ||--o{ assignment : "staffed by"
employee ||--o{ assignment : "assigned to"

' ============================================================
' KEY TAKEAWAYS
'   1. COMPOSITE PK: mark every participating column with *.
'      The same column can be both PK and FK (<<PK, FK>>).
'   2. LOOKUP TABLES (<<LK>>) replace free-text codes with
'      FK-constrained value sets. Always normalize enumerated
'      columns in an enterprise schema.
'   3. INHERITANCE PATTERN: base table (Person) + subtype tables
'      (SalariedEmployee, HourlyEmployee) sharing the same PK,
'      linked 1:0..1. A discriminator column or convention
'      determines which subtype row exists.
'   4. AUDIT COLUMNS: created_at / updated_at / changed_by appear
'      on transactional tables. Some schemas centralize change
'      history in a generic AuditLog table (row_pk as VARCHAR).
'   5. IDENTIFYING relationships (||--|{) bind a child's identity
'      to its parent (PaycheckDeduction cannot exist without its
'      Paycheck). The child PK includes the parent PK.
'   6. ||--o| (one-to-zero-or-one) models optional subtype rows
'      and optional 1:1 extensions.
' ============================================================

@enduml
