@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Same capability at business layer vs application layer.
'   usecase:      Contrasting what the business does vs what apps support it.
'   complexity:   medium
'   domain:       enterprise-architecture / business
' ============================================================================
title Example ArchiMate Business - Variant Business vs Application

note "TOP = Business layer (YELLOW) — what the business does\nBOTTOM = Application layer (BLUE) — what apps support it\nBusiness realizes business service; App realizes business process." as Legend

' ===== BUSINESS =====
package "Business Layer (What the business does)" #FFFDE7 {
  rectangle "<<business actor>>\nApplicant" as BA #FFF9C4
  rectangle "<<business role>>\nLoan Officer" as BR #FFF9C4
  rectangle "<<business process>>\nAssess\nApplication" as BP #FFF59D
  rectangle "<<business service>>\nLoan\nApproval" as BS #FFF176
  rectangle "<<business object>>\nLoan\nApplication" as BO #FFFDE7

  BA -[#444]-> BS : <<triggers>>
  BR -[#444]-> BP : <<assignment>>
  BP -[#444]-> BS : <<realization>>
  BP -[#444]-> BO : <<access>>
}

' ===== APPLICATION =====
package "Application Layer (What apps support it)" #E3F2FD {
  rectangle "<<app component>>\nLOS\nFrontend" as AC1 #BBDEFB
  rectangle "<<app component>>\nDecision\nEngine" as AC2 #BBDEFB
  rectangle "<<app component>>\nCredit\nService" as AC3 #BBDEFB
  rectangle "<<app service>>\nScore\nApplicant" as AS1 #90CAF9
  rectangle "<<data object>>\nCredit\nReport" as DO #E3F2FD

  AC1 -[#444]-> AC2 : <<serving>>
  AC2 -[#444]-> AC3 : <<serving>>
  AC3 -[#444]-> AS1 : <<realization>>
  AC3 -[#444]-> DO : <<access>>
}

' --- Cross-layer: apps realize the business process ---
AC1 .[#888].> BP : <<realization>>
AC2 .[#888].> BP : <<realization>>

@enduml
