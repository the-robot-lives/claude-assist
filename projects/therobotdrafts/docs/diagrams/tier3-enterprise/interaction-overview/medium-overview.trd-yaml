# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Interaction Overview - Medium Order Fulfillment
elements:
  - { id: ~start1, type: StateStart, name: start }
  - { id: ~fork2, type: ForkJoin, name: fork }
  - { id: ~join3, type: ForkJoin, name: join }
  - { id: ~dec4, type: Decision, name: 'Payment approved?' }
  - { id: ~dec5, type: Decision, name: 'Stock available?' }
  - { id: ~end6, type: StateEnd, name: end }
edges:
  - { id: e1, type: Transition, from: ~start1, to: ~fork2 }
  - { id: e2, type: Transition, from: ~fork2, to: ~join3 }
  - { id: e3, type: Transition, from: ~fork2, to: ~join3 }
  - { id: e4, type: Transition, from: ~join3, to: ~dec4 }
  - { id: e5, type: Transition, from: ~dec4, to: ~dec5, label: yes }
  - { id: e6, type: Transition, from: ~dec5, to: ~end6 }
  - { id: e7, type: Transition, from: ~dec5, to: ~end6 }
  - { id: e8, type: Transition, from: ~dec4, to: ~end6 }
diagrams:
  - { id: d1, name: Example Interaction Overview - Medium Order Fulfillment, kind: activity, layoutProvenance: Synthesized }
