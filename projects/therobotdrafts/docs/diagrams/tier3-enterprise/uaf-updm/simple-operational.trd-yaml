# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example UAF/UPDM - Simple Operational Viewpoint
elements:
  - { id: O_OA, type: Package, name: Operational Row x OperationalActivities Col }
  - { id: UC1, type: UseCase, name: Conduct Surveillance, parentId: O_OA }
  - { id: O_R, type: Package, name: Operational Row x Resources Col }
  - { id: A1, type: Actor, name: Sensor Operator, parentId: O_R }
  - { id: O_I, type: Package, name: Operational Row x Information Col }
  - { id: T1, type: Boundary, name: Track Report, parentId: O_I }
edges:
  - { id: e1, type: DirectedAssociation, from: A1, to: UC1, label: performs (needline) }
  - { id: e2, type: DirectedAssociation, from: UC1, to: T1, label: produces (info) }
  - { id: e3, type: DirectedAssociation, from: T1, to: A1, label: consumed (info) }
diagrams:
  - { id: d1, name: Example UAF/UPDM - Simple Operational Viewpoint, kind: usecase, layoutProvenance: Synthesized }
