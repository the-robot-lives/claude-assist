# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example UAF/UPDM - Medium Systems View (CV-1 / SV-1)
elements:
  - { id: S_C, type: Package, name: Strategic x Capabilities }
  - { id: V1, type: Boundary, name: 'Vision: Persistent ISR', parentId: S_C }
  - { id: C1, type: Boundary, name: 'Capability: Detect Threat', parentId: S_C }
  - { id: C2, type: Boundary, name: 'Capability: Report Fast', parentId: S_C }
  - { id: SY_R, type: Package, name: Systems x Resources }
  - { id: N1, type: DeploymentNode, name: Radar System, parentId: SY_R }
  - { id: N2, type: DeploymentNode, name: C2 Node, parentId: SY_R }
  - { id: DB1, type: Database, name: Track DB, parentId: SY_R }
edges:
  - { id: e1, type: DirectedAssociation, from: V1, to: C1, label: demands }
  - { id: e2, type: DirectedAssociation, from: V1, to: C2, label: demands }
  - { id: e3, type: Dependency, from: C1, to: N1, label: '"realized-by (needline)"' }
  - { id: e4, type: Dependency, from: C2, to: N2, label: '"realized-by (needline)"' }
  - { id: e5, type: DirectedAssociation, from: N1, to: N2, label: track data }
  - { id: e6, type: DirectedAssociation, from: N2, to: DB1, label: persist }
  - { id: e7, type: DirectedAssociation, from: DB1, to: N2, label: query }
diagrams:
  - { id: d1, name: Example UAF/UPDM - Medium Systems View (CV-1 / SV-1), kind: component, layoutProvenance: Synthesized }
