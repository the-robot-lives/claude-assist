@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  CRUD app landscape — 6 components serving business processes.
'   usecase:      Teaching composition, serving, realization, access.
'   complexity:   medium
'   domain:       enterprise-architecture / application
' ============================================================================
title Example ArchiMate Application - Medium CRUD Apps

note "Application = BLUE.\nNote: Business Process (yellow, top) is realized by apps.\nComponent=darker blue | Service=blue | Data=light blue" as Legend

' --- Business (note only, for realization source) ---
rectangle "<<business process>>\nManage\nCatalog" as BP #FFF59D

' --- App components ---
rectangle "<<app component>>\nCatalog\nUI" as AC1 #BBDEFB
package "<<app component>>\nCatalog Service" as AC2 #BBDEFB {
  rectangle "<<app service>>\nList\nItems" #90CAF9 as S1
  rectangle "<<app service>>\nCreate\nItem" #90CAF9 as S2
  rectangle "<<app service>>\nUpdate\nItem" #90CAF9 as S3
  rectangle "<<app service>>\nDelete\nItem" #90CAF9 as S4
}
rectangle "<<app component>>\nSearch\nEngine" as AC3 #BBDEFB
rectangle "<<app component>>\nImage\nService" as AC4 #BBDEFB

' --- Data objects ---
rectangle "<<data object>>\nProduct" as DO1 #E3F2FD
rectangle "<<data object>>\nImage" as DO2 #E3F2FD
rectangle "<<data object>>\nIndex" as DO3 #E3F2FD

AC1 -[#444]-> AC2 : <<serving>>
AC2 *-- S1 : <<composition>>
AC2 *-- S2 : <<composition>>
AC2 *-- S3 : <<composition>>
AC2 *-- S4 : <<composition>>
AC2 -[#444]-> AC3 : <<serving>>
AC2 -[#444]-> AC4 : <<serving>>

S1 -[#444]-> DO1 : <<access>>
S2 -[#444]-> DO1 : <<access>>
S3 -[#444]-> DO1 : <<access>>
S4 -[#444]-> DO1 : <<access>>
AC4 -[#444]-> DO2 : <<access>>
AC3 -[#444]-> DO3 : <<access>>

AC2 .[#888].> BP : <<realization>>

@enduml
