@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Enterprise application landscape — 14 components, 3 domains.
'   usecase:      Teaching cross-domain serving, realization, access, interfaces.
'   complexity:   complex
'   domain:       enterprise-architecture / application
' ============================================================================
title Example ArchiMate Application - Complex Enterprise Apps

note "Application = BLUE. Grouped by domain.\nComponent | Service | Interface | Data Object" as Legend

' ===== Sales domain =====
package "Sales Domain" #E3F2FD {
  rectangle "<<app component>>\nCRM\nApp" as A1 #BBDEFB
  rectangle "<<app service>>\nLead\nMgmt" as A1S #90CAF9
  rectangle "<<app component>>\nPricing\nEngine" as A2 #BBDEFB
  rectangle "<<application interface>>\nREST API" as AI1 #E3F2FD
  rectangle "<<data object>>\nCustomer" as D1 #E3F2FD
  rectangle "<<data object>>\nPrice List" as D2 #E3F2FD
}

' ===== Operations domain =====
package "Operations Domain" #E8F5E9 {
  rectangle "<<app component>>\nERP" as B1 #BBDEFB
  rectangle "<<app component>>\nInventory\nService" as B2 #BBDEFB
  rectangle "<<app service>>\nStock\nQuery" as B2S #90CAF9
  rectangle "<<data object>>\nStock Level" as D3 #E3F2FD
}

' ===== Analytics domain =====
package "Analytics Domain" #FFF3E0 {
  rectangle "<<app component>>\nBI\nDashboard" as C1 #BBDEFB
  rectangle "<<app component>>\nETL\nPipeline" as C2 #BBDEFB
  rectangle "<<app service>>\nSales\nReport" as C1S #90CAF9
  rectangle "<<application interface>>\nOData\nFeed" as AI2 #E3F2FD
  rectangle "<<data object>>\nData Mart" as D4 #E3F2FD
}

' ===== External =====
rectangle "<<app component>>\nPayment\nGateway" as EXT #D7CCC8

A1 -[#444]-> A1S : <<realization>>
A1 -[#444]-> AI1 : <<assignment>>
A1 -[#444]-> D1 : <<access>>
A2 -[#444]-> D2 : <<access>>
A1 -[#444]-> A2 : <<serving>>

B1 -[#444]-> B2 : <<composition>>
B2 -[#444]-> B2S : <<realization>>
B2 -[#444]-> D3 : <<access>>
B1 -[#444]-> D2 : <<access>>

C2 -[#444]-> D1 : <<access>>
C2 -[#444]-> D3 : <<access>>
C2 -[#444]-> D4 : <<access>>
C1 -[#444]-> C1S : <<realization>>
C1 -[#444]-> C2 : <<serving>>
C1 -[#444]-> AI2 : <<assignment>>

AI1 -[#444]-> A2 : <<serving>>
EXT -[#444]-> A1 : <<serving>>
B2S -[#444]-> A1 : <<serving>>

A1 -[#444]-> EXT : <<used by>>

@enduml
