' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex multi-screen wireframe (login, dashboard, detail, settings) with
'                 navigation edges between them and many widgets per screen.
'   usecase:      Teach a UI flow across multiple screens with navigation edges.
'   complexity:   complex
'   domain:       wireframe / ui-mockup
' ============================================================================
title Example Wireframe - Complex App Screens (flow)

note as TopNote
  Four screens with navigation edges between them.
  Each screen is a rectangle container holding widget lines.
  Arrows between screens = navigation. Labels = triggers.
end note

' ---- Screen 1: Login ----
rectangle "Screen: Login" as SC1 {
  rectangle "+Logo+" as W1a
  rectangle "[ username __ ]" as W1b
  rectangle "[ password __ ]" as W1c
  rectangle "[ Sign In ]" as W1d
  rectangle "\"Forgot password?\"" as W1e
}

' ---- Screen 2: Dashboard ----
rectangle "Screen: Dashboard" as SC2 {
  rectangle "/ Nav: Home | Orders | Settings /" as W2a
  rectangle "+ Header: Welcome +" as W2b
  rectangle "Card: Revenue | Card: Orders | Card: Users" as W2c
  rectangle "[Table: recent orders]" as W2d
  rectangle "[ Row -> tap for detail ]" as W2e
}

' ---- Screen 3: Detail ----
rectangle "Screen: Order Detail" as SC3 {
  rectangle "<- Back" as W3a
  rectangle "+ Order #1001 +" as W3b
  rectangle "Customer: Acme Corp" as W3c
  rectangle "Status: [Dropdown: Shipped]" as W3d
  rectangle "Line items table" as W3e
  rectangle "[ Edit ] [ Refund ]" as W3f
}

' ---- Screen 4: Settings ----
rectangle "Screen: Settings" as SC4 {
  rectangle "/ Nav: Home | Orders | Settings /" as W4a
  rectangle "(X) Enable 2FA" as W4b
  rectangle "( ) Email digest" as W4c
  rectangle "Theme: [Light v]" as W4d
  rectangle "[ Save ]" as W4e
}

' Navigation edges.
W1d --> W2a : "on Sign In"
W2e --> W3a : "tap row"
W3a --> W2a : "Back"
W2a --> W4a : "tap Settings"
W4a --> W2a : "tap Home"
