# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Timing Diagram - Complex System Startup
elements:
  - { id: P, type: Lifeline, name: Power }
  - { id: B, type: Lifeline, name: Boot }
  - { id: V, type: Lifeline, name: Voltage }
  - { id: SE, type: Lifeline, name: Sensor }
  - { id: W, type: Lifeline, name: Watchdog }
edges:
  - { id: t0, type: Transition, from: P, to: P, label: '@0 is Off' }
  - { id: t1, type: Transition, from: B, to: B, label: '@0 is Reset' }
  - { id: t2, type: Transition, from: SE, to: SE, label: '@0 is Cold' }
  - { id: t3, type: Transition, from: W, to: W, label: '@0 is Halt' }
  - { id: t4, type: Transition, from: P, to: P, label: '@1 is On' }
  - { id: t5, type: Transition, from: B, to: B, label: '@2 is ROM' }
  - { id: t6, type: Transition, from: B, to: B, label: '@3 is Bootloader' }
  - { id: t7, type: Transition, from: B, to: B, label: '@4 is OS' }
  - { id: t8, type: Transition, from: B, to: B, label: '@5 is App' }
  - { id: t9, type: Transition, from: SE, to: SE, label: '@6 is Init' }
  - { id: t10, type: Transition, from: SE, to: SE, label: '@6 is Calibrated' }
  - { id: t11, type: Transition, from: W, to: W, label: '@6 is Idle' }
  - { id: t12, type: Transition, from: W, to: W, label: '@9 is Armed' }
  - { id: t13, type: Transition, from: P, to: P, label: '@14 is Off' }
  - { id: t14, type: Transition, from: B, to: B, label: '@14 is Reset' }
  - { id: t15, type: Transition, from: SE, to: SE, label: '@14 is Cold' }
  - { id: t16, type: Transition, from: W, to: W, label: '@14 is Halt' }
diagrams:
  - { id: d1, name: Example Timing Diagram - Complex System Startup, kind: timing, layoutProvenance: Synthesized }
