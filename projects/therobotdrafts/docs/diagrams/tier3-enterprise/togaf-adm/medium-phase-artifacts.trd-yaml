# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example TOGAF ADM - Medium Phase Artifacts
elements:
  - { id: PB, type: Package, name: 'Phase B: Business Architecture' }
  - { id: BF, type: Boundary, name: 'Artifact: Business Footprint' }
  - { id: OM, type: Boundary, name: 'Artifact: Organization Map' }
  - { id: BPC, type: Boundary, name: 'Artifact: Business Process\nCatalog & Matrix' }
  - { id: PC, type: Package, name: 'Phase C: Information Systems' }
  - { id: DEC, type: Boundary, name: 'Artifact: Data Entity Catalog' }
  - { id: AP, type: Boundary, name: 'Artifact: Application Portfolio' }
  - { id: DDD, type: Boundary, name: 'Artifact: Data Dissemination\nDiagram' }
  - { id: PD, type: Package, name: 'Phase D: Technology Architecture' }
  - { id: TSC, type: Boundary, name: 'Artifact: Technology Standards\nCatalog' }
  - { id: PLD, type: Boundary, name: 'Artifact: Platform Decomposition' }
edges:
  - { id: e1, type: MessageReply, from: BPC, to: DEC, label: 'output: process-to-data' }
  - { id: e2, type: MessageReply, from: OM, to: AP, label: 'output: org-to-app' }
  - { id: e3, type: MessageReply, from: DEC, to: DDD, label: 'output: data model' }
  - { id: e4, type: MessageReply, from: DDD, to: TSC, label: 'output: data hosting needs' }
  - { id: e5, type: MessageReply, from: AP, to: PLD, label: 'output: app platform needs' }
  - { id: e6, type: MessageReply, from: BF, to: OM }
  - { id: e7, type: MessageReply, from: OM, to: BPC }
  - { id: e8, type: MessageReply, from: DEC, to: AP }
  - { id: e9, type: MessageReply, from: TSC, to: PLD }
diagrams:
  - { id: d1, name: Example TOGAF ADM - Medium Phase Artifacts, kind: sequence, layoutProvenance: Synthesized }
