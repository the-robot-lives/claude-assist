# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Whiteboard - Simple Brainstorm
elements:
  - { id: FRAME, type: Package, name: 'Whiteboard Frame: Onboarding Ideas' }
  - { id: S1, type: Note, name: 'Sticky: make signup 1-click', parentId: FRAME, documentation: 'Sticky: make signup 1-click' }
  - { id: S2, type: Note, name: 'Sticky: add social login', parentId: FRAME, documentation: 'Sticky: add social login' }
  - { id: C1, type: Component, name: 'Card: Conversion +15%', parentId: FRAME }
  - { id: B1, type: UseCase, name: Idea bubble, parentId: FRAME }
  - { id: CL, type: Cloud, name: Growth Cloud\n(maybe later) }
