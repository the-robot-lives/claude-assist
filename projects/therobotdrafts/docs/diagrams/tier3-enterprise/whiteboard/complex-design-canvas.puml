' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Full design canvas: frames, many stickies, cards, text, clouds, sketch shapes,
'                 async send/receive markers, mixed sketch + typed connectors.
'   usecase:      Teach a large mixed-fidelity design canvas.
'   complexity:   complex
'   domain:       whiteboard / sketch
' ============================================================================
title Example Whiteboard - Complex Design Canvas

' ---- Frame 1: Discovery ----
package "Frame: Discovery" as F1 {
  note "User wants speed" as N1
  note "Legacy is slow" as N2
  note "Budget tight" as N3
  card "Card: Interview 12 users" as C1
}

' ---- Frame 2: Ideation ----
package "Frame: Ideation" as F2 {
  note "Sticky: cache layer" as N4
  note "Sticky: async jobs" as N5
  note "Sticky: CDN edges" as N6
  usecase "Bubble: edge compute" as U1
  usecase "Bubble: job runner" as U2
}

' ---- Frame 3: Decisions ----
package "Frame: Decisions" as F3 {
  card "Decision: adopt CDN" as D1
  card "Decision: defer jobs" as D2
}

' ---- Clouds and sketch shapes ----
cloud "Big Idea Cloud:\nEdge-first" as CL1
cloud "Risk Cloud:\nCost overrun" as CL2

' Sketch shapes (diamond = decision bubble, circle = marker).
diamond "Decision?" as DM1
circle "Go" as GO1
circle "No-Go" as NO1

' ---- Async markers (send/receive) ----
' Represented as queues to show async handoff on a whiteboard.
queue "Async: send to cache team" as AQ1
queue "Async: receive from finance" as AQ2

' ---- Text annotations ----
note "Text: VOTE BY FRIDAY" as T1
note "Text: owner = @maya" as T2

' ---- Mixed connectors ----
' Sketch (freeform dotted) connectors:
N1 ..> C1
N2 ..> N4
N3 ..> D2

' Typed (solid) connectors:
C1 --> U1
N4 --> U1
N5 --> U2
N6 --> U1

U1 --> DM1
U2 --> DM1
DM1 --> GO1 : pick CDN
DM1 --> NO1 : defer jobs
GO1 --> D1
NO1 --> D2

' Cross-frame:
D1 --> AQ1 : send
AQ2 --> D2 : receive

CL1 --> U1 : inspires
CL2 ..> D2 : threatens

T1 ..> DM1
T2 ..> D1
