' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  A capsule decomposed into 2-3 sub-capsule parts wired by protocol-typed
'                 connectors, with boundary ports.
'   usecase:      Teach capsule structure diagram: sub-capsules, internal connectors, boundary ports.
'   complexity:   medium
'   domain:       rose-realtime / uml-rt
' ============================================================================
title Example Rose RealTime - Medium Capsule Structure

' Composite capsule "Controller" contains sub-capsule PARTS.
' Parts are wired by CONNECTORS whose ends are ports typed by PROTOCOLS.
' Boundary ports on the outer capsule are relayed (wired) to inner parts.

class "Controller\n<<capsule>>" as CTRL {
  structure: 3 parts
}

' ---- Protocols ----
class "CmdProtocol\n<<protocol>>" as PCMD {
  + in: start(), stop()
  + out: ack()
}
class "DataProtocol\n<<protocol>>" as PDATA {
  + in: send(bytes)
  + out: recv(bytes)
}
class "TimerProtocol\n<<protocol>>" as PTIMER {
  + in: arm(ms)
  + out: timeout()
}

' ---- Sub-capsule parts ----
class "InputHandler\n<<capsule part>>" as INH
class "Processor\n<<capsule part>>" as PROC
class "Timer\n<<capsule part>>" as TMR

' ---- Boundary ports on the Controller ----
rectangle "extIn: CmdProtocol" as BP_IN
rectangle "extOut: DataProtocol" as BP_OUT

' Internal ports on parts.
rectangle "in_cmd: CmdProtocol" as INH_PIN
rectangle "in_data: DataProtocol" as INH_PD
rectangle "proc_cmd: CmdProtocol" as PROC_PC
rectangle "proc_timer: TimerProtocol" as PROC_PT
rectangle "tmr_arm: TimerProtocol" as TMR_PA

' Boundary port relayed to inner part.
BP_IN --> INH_PIN : "connector (relay)"
INH_PD --> BP_OUT : "connector (relay)"

' Internal connectors between parts (protocol-typed).
INH_PIN ..> PCMD : typed by
PROC_PC ..> PCMD : typed by
INH_PD ..> PDATA : typed by
PROC_PT ..> PTIMER : typed by
TMR_PA ..> PTIMER : typed by

' Wiring: InputHandler forwards commands to Processor; Processor arms Timer.
INH_PIN --> PROC_PC : "connector (CmdProtocol)"
PROC_PT --> TMR_PA : "connector (TimerProtocol)"
TMR_PA ..> PROC_PC : "timeout() flows back"

' Parts belong to the composite.
CTRL *-- INH
CTRL *-- PROC
CTRL *-- TMR
