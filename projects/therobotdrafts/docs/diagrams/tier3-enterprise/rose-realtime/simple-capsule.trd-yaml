# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Rose RealTime - Simple Capsule
elements:
  - { id: P1, type: Class, name: SensorProtocol\n, stereotype: protocol, members: [{ name: 'in: readRequest', isOperation: true, visibility: Public, rawText: '+ in: readRequest()' }, { name: 'out: sample', isOperation: true, visibility: Public, params: [{ name: data }], rawText: '+ out: sample(data)' }] }
  - { id: CAP1, type: Class, name: SensorReader\n, stereotype: capsule, members: [{ name: behavior, isOperation: false, visibility: Public, type: state machine, rawText: 'behavior: state machine' }] }
  - { id: PT1, type: Boundary, name: 'p1: SensorProtocol' }
  - { id: PT2, type: Boundary, name: 'p2: SensorProtocol' }
  - { id: ~note1, type: Note, name: Ports carry SIGNALS governed by the Protocol., documentation: 'Ports carry SIGNALS governed by the Protocol.\nThe capsule has an executable state machine reacting to in-signals\nand emitting out-signals.' }
edges:
  - { id: e1, type: DirectedAssociation, from: CAP1, to: PT1, label: '"port"' }
  - { id: e2, type: DirectedAssociation, from: CAP1, to: PT2, label: '"port"' }
  - { id: e3, type: DirectedAssociation, from: PT1, to: P1, label: '"typed by"' }
  - { id: e4, type: DirectedAssociation, from: PT2, to: P1, label: '"typed by"' }
  - { id: e5, type: NoteLink, from: ~note1, to: CAP1 }
diagrams:
  - { id: d1, name: Example Rose RealTime - Simple Capsule, kind: class, layoutProvenance: Synthesized }
