# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Rose RealTime - Medium Capsule Structure
elements:
  - { id: CTRL, type: Class, name: Controller\n, stereotype: capsule, members: [{ name: structure, isOperation: false, visibility: Public, type: 3 parts, rawText: 'structure: 3 parts' }] }
  - { id: PCMD, type: Class, name: CmdProtocol\n, stereotype: protocol, members: [{ name: 'in: start', isOperation: true, visibility: Public, params: [{ name: '), stop(' }], rawText: '+ in: start(), stop()' }, { name: 'out: ack', isOperation: true, visibility: Public, rawText: '+ out: ack()' }] }
  - { id: PDATA, type: Class, name: DataProtocol\n, stereotype: protocol, members: [{ name: 'in: send', isOperation: true, visibility: Public, params: [{ name: bytes }], rawText: '+ in: send(bytes)' }, { name: 'out: recv', isOperation: true, visibility: Public, params: [{ name: bytes }], rawText: '+ out: recv(bytes)' }] }
  - { id: PTIMER, type: Class, name: TimerProtocol\n, stereotype: protocol, members: [{ name: 'in: arm', isOperation: true, visibility: Public, params: [{ name: ms }], rawText: '+ in: arm(ms)' }, { name: 'out: timeout', isOperation: true, visibility: Public, rawText: '+ out: timeout()' }] }
  - { id: INH, type: Class, name: InputHandler\n, stereotype: capsule part }
  - { id: PROC, type: Class, name: Processor\n, stereotype: capsule part }
  - { id: TMR, type: Class, name: Timer\n, stereotype: capsule part }
  - { id: BP_IN, type: Boundary, name: 'extIn: CmdProtocol' }
  - { id: BP_OUT, type: Boundary, name: 'extOut: DataProtocol' }
  - { id: INH_PIN, type: Boundary, name: 'in_cmd: CmdProtocol' }
  - { id: INH_PD, type: Boundary, name: 'in_data: DataProtocol' }
  - { id: PROC_PC, type: Boundary, name: 'proc_cmd: CmdProtocol' }
  - { id: PROC_PT, type: Boundary, name: 'proc_timer: TimerProtocol' }
  - { id: TMR_PA, type: Boundary, name: 'tmr_arm: TimerProtocol' }
edges:
  - { id: e1, type: DirectedAssociation, from: BP_IN, to: INH_PIN, label: '"connector (relay)"' }
  - { id: e2, type: DirectedAssociation, from: INH_PD, to: BP_OUT, label: '"connector (relay)"' }
  - { id: e3, type: Dependency, from: INH_PIN, to: PCMD, label: typed by }
  - { id: e4, type: Dependency, from: PROC_PC, to: PCMD, label: typed by }
  - { id: e5, type: Dependency, from: INH_PD, to: PDATA, label: typed by }
  - { id: e6, type: Dependency, from: PROC_PT, to: PTIMER, label: typed by }
  - { id: e7, type: Dependency, from: TMR_PA, to: PTIMER, label: typed by }
  - { id: e8, type: DirectedAssociation, from: INH_PIN, to: PROC_PC, label: '"connector (CmdProtocol)"' }
  - { id: e9, type: DirectedAssociation, from: PROC_PT, to: TMR_PA, label: '"connector (TimerProtocol)"' }
  - { id: e10, type: Dependency, from: TMR_PA, to: PROC_PC, label: '"timeout() flows back"' }
  - { id: e11, type: Composition, from: CTRL, to: INH }
  - { id: e12, type: Composition, from: CTRL, to: PROC }
  - { id: e13, type: Composition, from: CTRL, to: TMR }
diagrams:
  - { id: d1, name: Example Rose RealTime - Medium Capsule Structure, kind: class, layoutProvenance: Synthesized }
