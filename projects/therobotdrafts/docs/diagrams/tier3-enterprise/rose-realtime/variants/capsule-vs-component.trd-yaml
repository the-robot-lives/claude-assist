# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Rose RealTime - Capsule vs Component
elements:
  - { id: VARIANT, type: Class, name: VARIANT, members: [{ name: 'same "Scheduler" unit shown two ways.', isOperation: false, visibility: Public, rawText: 'same "Scheduler" unit shown two ways.' }] }
  - { id: RT_CAP, type: Class, name: Scheduler\n, stereotype: capsule, members: [{ name: behavior, isOperation: false, visibility: Public, type: state machine, rawText: 'behavior: state machine' }] }
  - { id: RT_P, type: Class, name: JobProtocol\n, stereotype: protocol, members: [{ name: 'in: submit', isOperation: true, visibility: Public, params: [{ name: 'job), cancel(id' }], rawText: '+ in: submit(job), cancel(id)' }, { name: 'out: completed', isOperation: true, visibility: Public, params: [{ name: result }], rawText: '+ out: completed(result)' }] }
  - { id: RT_PT, type: Class, name: TimerProtocol\n, stereotype: protocol, members: [{ name: 'in: arm', isOperation: true, visibility: Public, params: [{ name: ms }], rawText: '+ in: arm(ms)' }, { name: 'out: timeout', isOperation: true, visibility: Public, rawText: '+ out: timeout()' }] }
  - { id: RT_PORT1, type: Boundary, name: 'p_job: JobProtocol' }
  - { id: RT_PORT2, type: Boundary, name: 'p_timer: TimerProtocol' }
  - { id: UML_COMP, type: Component, name: Scheduler\n, stereotype: component }
  - { id: IJOB, type: Interface, name: IJobService\n+ submit(job)\n+ cancel(id) }
  - { id: ISINK, type: Interface, name: ICompletionSink\n+ onCompleted(result) }
  - { id: ITIMER, type: Interface, name: ITimer\n+ arm(ms) }
edges:
  - { id: e1, type: DirectedAssociation, from: RT_CAP, to: RT_PORT1, label: '"port"' }
  - { id: e2, type: DirectedAssociation, from: RT_CAP, to: RT_PORT2, label: '"port"' }
  - { id: e3, type: DirectedAssociation, from: RT_PORT1, to: RT_P, label: '"typed by"' }
  - { id: e4, type: DirectedAssociation, from: RT_PORT2, to: RT_PT, label: '"typed by"' }
diagrams:
  - { id: d1, name: Example Rose RealTime - Capsule vs Component, kind: class, layoutProvenance: Synthesized }
