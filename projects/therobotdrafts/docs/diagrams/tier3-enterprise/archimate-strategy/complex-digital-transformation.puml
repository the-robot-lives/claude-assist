@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Digital transformation — 14 strategy-layer elements.
'   usecase:      Teaching drivers, assessments, capabilities, outcomes.
'   complexity:   complex
'   domain:       enterprise-architecture / strategy
' ============================================================================
title Example ArchiMate Strategy - Complex Digital Transformation

note "Layer map:\nDriver(orange) | Assessment(pink) | Capability(light green)\nResource(grey) | Course of Action(yellow) | Outcome(blue)\nStakeholder(tan) | Value(blue-green)" as Legend

' --- Motivation: drivers & stakeholders ---
rectangle "<<driver>>\nMarket\nDisruption" as D1 #FFE0B2
rectangle "<<driver>>\nRegulatory\nPressure" as D2 #FFE0B2
rectangle "<<stakeholder>>\nBoard of\nDirectors" as S1 #D7CCC8
rectangle "<<stakeholder>>\nCustomers" as S2 #D7CCC8

' --- Assessment ---
rectangle "<<assessment>>\nLegacy Debt\nRisk" as A1 #F8BBD0
rectangle "<<assessment>>\nCloud\nOpportunity" as A2 #F8BBD0

' --- Capabilities ---
rectangle "<<capability>>\nDigital\nChannels" as CAP1 #E8F5E9
rectangle "<<capability>>\nData\nAnalytics" as CAP2 #E8F5E9
rectangle "<<capability>>\nCloud\nPlatform" as CAP3 #E8F5E9
rectangle "<<capability>>\nDevOps" as CAP4 #E8F5E9
rectangle "<<capability>>\nAPI\nEconomy" as CAP5 #E8F5E9

' --- Resources ---
rectangle "<<resource>>\nEngineering\nTalent" as R1 #F5F5F5
rectangle "<<resource>>\nData Lake" as R2 #F5F5F5

' --- Courses of action ---
rectangle "<<course of action>>\nCloud-First\nStrategy" as CA1 #FFF9C4
rectangle "<<course of action>>\nData-Driven\nCulture" as CA2 #FFF9C4

' --- Outcomes ---
rectangle "<<outcome>>\n30% Cost\nReduction" as O1 #E3F2FD
rectangle "<<outcome>>\n2x Time-to-Market" as O2 #E3F2FD
rectangle "<<value>>\nShareholder\nValue" as V1 #B2DFDB

D1 -[#444]-> A1 : <<association>>
D2 -[#444]-> A2 : <<association>>
S1 -[#444]-> D1 : <<association>>
S2 -[#444]-> D1 : <<association>>

A1 -[#444]-> CA1 : <<realization>>
A2 -[#444]-> CA1 : <<realization>>

CA1 -[#444]-> CAP3 : <<realization>>
CA1 -[#444]-> CAP4 : <<realization>>
CA2 -[#444]-> CAP2 : <<realization>>
CA2 -[#444]-> CAP5 : <<realization>>

CAP1 -[#444]-> CAP5 : <<used by>>
CAP2 -[#444]-> R2 : <<association>>
CAP3 -[#444]-> CAP4 : <<aggregation>>
CAP5 -[#444]-> CAP2 : <<used by>>

R1 -[#444]-> CAP4 : <<association>>
R1 -[#444]-> CAP1 : <<association>>

CAP3 -[#444]-> O1 : <<realization>>
CAP4 -[#444]-> O2 : <<realization>>
CAP2 -[#444]-> O2 : <<realization>>

O1 -[#444]-> V1 : <<realization>>
O2 -[#444]-> V1 : <<realization>>

@enduml
