@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Value stream — 6 capabilities composing a customer journey.
'   usecase:      Teaching value stream, outcome stages, course of action.
'   complexity:   medium
'   domain:       enterprise-architecture / strategy
' ============================================================================
title Example ArchiMate Strategy - Medium Value Stream

note "ArchiMate layer map:\nStrategy = light green  |  Outcome = light blue\nCourse of Action = pale yellow  |  Resource = grey" as Legend

' --- Capabilities in value-stream order ---
rectangle "<<capability>>\nAttract" as VS1 #E8F5E9
rectangle "<<capability>>\nEngage" as VS2 #E8F5E9
rectangle "<<capability>>\nQualify" as VS3 #E8F5E9
rectangle "<<capability>>\nConvert" as VS4 #E8F5E9
rectangle "<<capability>>\nDeliver" as VS5 #E8F5E9
rectangle "<<capability>>\nSupport" as VS6 #E8F5E9

' --- Course of action ---
rectangle "<<course of action>>\nOmnichannel\nGrowth Program" as COA #FFF9C4

' --- Outcome stages ---
rectangle "<<outcome>>\nAware" as O1 #E3F2FD
rectangle "<<outcome>>\nInterested" as O2 #E3F2FD
rectangle "<<outcome>>\nQualified" as O3 #E3F2FD
rectangle "<<outcome>>\nCustomer" as O4 #E3F2FD
rectangle "<<outcome>>\nRetained" as O5 #E3F2FD

' --- Resources ---
rectangle "<<resource>>\nCRM Platform" as RES #F5F5F5

COA -[#444]-> VS1 : <<realization>>
COA -[#444]-> VS4 : <<realization>>
COA -[#444]-> VS6 : <<realization>>

VS1 -[#444]-> VS2 : <<triggering>>
VS2 -[#444]-> VS3 : <<triggering>>
VS3 -[#444]-> VS4 : <<triggering>>
VS4 -[#444]-> VS5 : <<triggering>>
VS5 -[#444]-> VS6 : <<triggering>>

VS1 -[#444]-> O1 : <<realization>>
VS2 -[#444]-> O2 : <<realization>>
VS3 -[#444]-> O3 : <<realization>>
VS4 -[#444]-> O4 : <<realization>>
VS5 -[#444]-> O5 : <<realization>>

RES -[#444]-> VS2 : <<association>>
RES -[#444]-> VS3 : <<association>>
RES -[#444]-> VS5 : <<association>>

@enduml
