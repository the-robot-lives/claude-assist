# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example XSD - Simple Schema
elements:
  - { id: NS_COMMON, type: Package, name: 'common.xsd (ns: common)' }
  - { id: Money, type: Class, name: Money\n, parentId: NS_COMMON, stereotype: complexType, members: [{ name: amount, isOperation: false, visibility: Public, type: decimal, rawText: '+ amount: decimal' }, { name: currency, isOperation: false, visibility: Public, type: string, rawText: '+ currency: string' }] }
  - { id: NS_ORDERS, type: Package, name: 'orders.xsd (ns: orders)' }
  - { id: Order, type: Class, name: Order\n, parentId: NS_ORDERS, stereotype: complexType, members: [{ name: id, isOperation: false, visibility: Public, type: string, rawText: '+ id: string' }, { name: placedAt, isOperation: false, visibility: Public, type: dateTime, rawText: '+ placedAt: dateTime' }] }
  - { id: OrderItem, type: Class, name: OrderItem\n, parentId: NS_ORDERS, stereotype: complexType, members: [{ name: sku, isOperation: false, visibility: Public, type: string, rawText: '+ sku: string' }, { name: qty, isOperation: false, visibility: Public, type: int, rawText: '+ qty: int' }] }
edges:
  - { id: e1, type: Composition, from: Order, to: OrderItem, label: '"items (1..*)"' }
  - { id: e2, type: Composition, from: OrderItem, to: Money, label: '"price"' }
  - { id: e3, type: Dependency, from: NS_ORDERS, to: NS_COMMON, label: '"xs:import"' }
diagrams:
  - { id: d1, name: Example XSD - Simple Schema, kind: class, layoutProvenance: Synthesized }
