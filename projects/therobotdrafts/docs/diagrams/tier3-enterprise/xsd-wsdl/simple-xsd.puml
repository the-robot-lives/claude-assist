' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Simple XSD: 3-4 types/elements with containment and reference.
'   usecase:      Teach complexType, element, containment, and xs:import.
'   complexity:   simple
'   domain:       xsd / xml-schema
' ============================================================================
title Example XSD - Simple Schema

' Model XSD as class diagram:
'   complexType   -> class
'   element       -> field (composition arrow)
'   reference     -> association arrow
'   xs:import     -> dependency between namespaces (dashed)

' ---- Namespace: common (imported) ----
package "common.xsd (ns: common)" as NS_COMMON {
  class "Money\n<<complexType>>" as Money {
    + amount: decimal
    + currency: string
  }
}

' ---- Namespace: orders (target) ----
package "orders.xsd (ns: orders)" as NS_ORDERS {
  class "Order\n<<complexType>>" as Order {
    + id: string
    + placedAt: dateTime
  }
  class "OrderItem\n<<complexType>>" as OrderItem {
    + sku: string
    + qty: int
  }
}

' Containment: Order contains OrderItem elements (composition).
Order *-- OrderItem : "items (1..*)"

' Containment: OrderItem contains a Money (price) element.
OrderItem *-- Money : "price"

' xs:import dependency: orders imports common types.
NS_ORDERS ..> NS_COMMON : "xs:import"
