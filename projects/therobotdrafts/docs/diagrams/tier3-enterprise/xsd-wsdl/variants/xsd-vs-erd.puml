' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Same data modeled as an XSD (types/elements) vs an ERD (entities/tables).
'   usecase:      Teach schema (XSD, message-shaped) vs data model (ERD, storage-shaped).
'   complexity:   variant
'   domain:       xsd / data-modeling
' ============================================================================
title Example XSD vs ERD - Schema vs Data Model

note as TopNote
  VARIANT: same Order/OrderItem/Customer domain shown two ways.
  LEFT: XSD - types + elements, message-shaped, keyed by element refs.
       Optimized for wire serialization (XML), choice/sequence compositors.
  RIGHT: ERD - entities + tables, storage-shaped, keyed by primary/foreign keys.
       Optimized for persistence, normalization, joins.
  XSD answers "what goes on the wire?"; ERD answers "where does it live?".
end note

' ============ LEFT: XSD ============
package "XSD: order schema" as XSD {
  class "Order (complexType)\n+ id: string\n+ placedAt: dateTime" as XO
  class "OrderItem (complexType)\n+ sku: string\n+ qty: int" as XOI
  class "Customer (complexType)\n+ id: string\n+ email: string" as XC
}
XO *-- XOI : "element items (1..*)"
XO --> XC : "element customerRef"

' ============ RIGHT: ERD ============
package "ERD: order database" as ERD {
  entity "orders" as EO {
    * id : PK
    --
    placed_at : timestamp
    customer_id : FK
  }
  entity "order_items" as EOI {
    * id : PK
    --
    order_id : FK
    sku : varchar
    qty : int
  }
  entity "customers" as EC {
    * id : PK
    --
    email : varchar
  }
}
EO ||--|{ EOI : "has many"
EC ||--|{ EO : "places"
