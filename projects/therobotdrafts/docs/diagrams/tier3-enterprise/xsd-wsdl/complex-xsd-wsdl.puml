' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex XSD + WSDL: 12+ schema types plus a full WSDL (portType, operations,
'                 bindings, messages) and a service endpoint.
'   usecase:      Teach the full XSD+WSDL contract: schema types feed WSDL messages and operations.
'   complexity:   complex
'   domain:       xsd-wsdl / web-service-contract
' ============================================================================
title Example XSD/WSDL - Complex Schema + Service Contract

note as TopNote
  TOP: XSD schema types (12+) in a target namespace.
  BOTTOM: WSDL contract - portType (interface), operations, bindings, messages,
          and a service endpoint. Messages reference schema types.
  XSD defines the data; WSDL defines the operations over that data.
end note

' ---- XSD schema ----
package "orders.xsd (ns: ord)" as NS_ORD {
  class "Order\n<<complexType>>" as Order {
    + id: string
    + placedAt: dateTime
    + status: OrderStatus
  }
  class "OrderItem\n<<complexType>>" as OrderItem {
    + sku: string
    + qty: int
  }
  class "Customer\n<<complexType>>" as Customer {
    + id: string
    + email: string
  }
  class "Address\n<<complexType>>" as Address {
    + street: string
    + city: string
  }
  class "Money\n<<complexType>>" as Money {
    + amount: decimal
    + currency: string
  }
  class "OrderStatus\n<<simpleType enum>>" as OrderStatus {
    + PENDING
    + SHIPPED
    + DELIVERED
  }
  class "CreateOrderRequest\n<<complexType>>" as CreateOrderReq {
    + customerRef: string
  }
  class "CreateOrderResponse\n<<complexType>>" as CreateOrderRes {
    + orderId: string
  }
  class "GetOrderRequest\n<<complexType>>" as GetOrderReq {
    + orderId: string
  }
  class "CancelOrderRequest\n<<complexType>>" as CancelOrderReq {
    + orderId: string
  }
  class "Fault\n<<complexType>>" as Fault {
    + code: string
    + message: string
  }
  class "Shipment\n<<complexType>>" as Shipment {
    + carrier: string
    + trackingNo: string
  }
}

' Schema relationships.
Order *-- OrderItem : "items"
Order --> Customer : "ref"
Order --> OrderStatus : "status"
OrderItem *-- Money : "price"
Order --> Address : "shipping address"
Shipment --> Order : "fulfills"

' ---- WSDL: portType (interface) ----
package "OrderService (portType)" as PORT {
  class "createOrder\n<<operation>>" as OP_CREATE
  class "getOrder\n<<operation>>" as OP_GET
  class "cancelOrder\n<<operation>>" as OP_CANCEL
}

' ---- WSDL: messages reference schema types ----
CreateOrderReq ..> OP_CREATE : "input message"
OP_CREATE ..> CreateOrderRes : "output message"
OP_CREATE ..> Fault : "fault message"
GetOrderReq ..> OP_GET : "input message"
OP_GET ..> Order : "output message"
OP_GET ..> Fault : "fault message"
CancelOrderReq ..> OP_CANCEL : "input message"
OP_CANCEL ..> CreateOrderRes : "output message"
OP_CANCEL ..> Fault : "fault message"

' ---- WSDL: binding ----
rectangle "binding: OrderServiceSOAP\n(transport: HTTP, style: document/literal)" as BIND
PORT --> BIND : "wsdl:binding"

' ---- WSDL: service endpoint ----
rectangle "service: OrderServiceService\nendpoint: https://api.example.com/orders" as SVC
BIND --> SVC : "wsdl:service / port"
