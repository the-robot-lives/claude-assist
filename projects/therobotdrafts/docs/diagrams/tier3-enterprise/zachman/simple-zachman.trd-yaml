# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Zachman - Simple 6x6 (partially filled)
elements:
  - { id: PR, type: Package, name: Planner row }
  - { id: 'P_WHY { rectangle "Scope / Purpose" as P1 }', type: Package, name: Planner x Why }
  - { id: 'P_WHAT { rectangle "List of Things" as P2 }', type: Package, name: Planner x What }
  - { id: DR, type: Package, name: Designer row }
  - { id: 'D_WHAT { rectangle "Data Model (ERD)" as D1 }', type: Package, name: Designer x What }
  - { id: 'D_HOW { rectangle "System Function Model" as D2 }', type: Package, name: Designer x How }
  - { id: BR, type: Package, name: Builder row }
  - { id: 'B_HOW { rectangle "Program Spec" as B1 }', type: Package, name: Builder x How }
  - { id: P2, type: Lifeline, name: P2 }
  - { id: D1, type: Lifeline, name: D1 }
  - { id: D2, type: Lifeline, name: D2 }
  - { id: B1, type: Lifeline, name: B1 }
edges:
  - { id: e1, type: MessageReply, from: P2, to: D1, label: refines (down What column) }
  - { id: e2, type: MessageReply, from: D2, to: B1, label: refines (down How column) }
diagrams:
  - { id: d1, name: Example Zachman - Simple 6x6 (partially filled), kind: sequence, layoutProvenance: Synthesized }
