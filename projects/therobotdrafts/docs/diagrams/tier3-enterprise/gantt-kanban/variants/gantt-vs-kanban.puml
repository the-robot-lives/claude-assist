@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Same work shown as Gantt (timeline) and Kanban (flow/columns).
'   usecase:      Contrasting schedule-view (when) vs flow-view (status).
'   complexity:   medium
'   domain:       project-tracking / gantt-kanban
' ============================================================================
title Example Variant - Gantt vs Kanban (Same Work)

note "LEFT = Gantt view answers WHEN (time axis, dependencies).\nRIGHT = Kanban view answers WHERE IS IT NOW (columns by status).\nSame backlog, two lenses. Gantt = schedule; Kanban = flow." as Legend

' ===== GANTT (stylized timeline) =====
package "Gantt View (Schedule)" #E3F2FD {
  rectangle "Sprint 1\nW1 W2" as G1 #BBDEFB
  rectangle "Sprint 2\nW3 W4" as G2 #BBDEFB
  rectangle "Sprint 3\nW5 W6" as G3 #BBDEFB
  G1 -[hidden]right-> G2
  G2 -[hidden]right-> G3
  rectangle "Task A ===>" as GA #90CAF9
  rectangle "Task B   ===>" as GB #90CAF9
  rectangle "Task C       ===>" as GC #90CAF9
  GA -[hidden]down-> GB
  GB -[hidden]down-> GC
}

' ===== KANBAN (columns) =====
package "Kanban View (Flow)" #E8F5E9 {

  package "To Do" #FFF9C4 {
    rectangle "[TASK-D]\nPriority: High" as KD #FFF59D
    rectangle "[TASK-E]\nPriority: Med" as KE #FFF59D
  }

  package "Doing" #BBDEFB {
    rectangle "[TASK-B]\nOwner: Alice\n3 days left" as KB #90CAF9
    rectangle "[TASK-C]\nOwner: Bob\nBlocked" as KC #EF9A9A
  }

  package "Done" #C8E6C9 {
    rectangle "[TASK-A]\nClosed: W1" as KA #A5D6A7
  }
}

@enduml
