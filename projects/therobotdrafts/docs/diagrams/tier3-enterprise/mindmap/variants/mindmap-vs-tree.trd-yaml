# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Mind Map (Variant) - Mind Map vs Tree
elements:
  - { id: ~mm1, type: MindNode, name: TheRobotDrafts Platform }
  - { id: ~mm2, type: MindNode, name: Diagrams }
  - { id: ~mm3, type: MindNode, name: UML }
  - { id: ~mm4, type: MindNode, name: SysML }
  - { id: ~mm5, type: MindNode, name: Editor }
  - { id: ~mm6, type: MindNode, name: Collaboration }
  - { id: ~mm7, type: MindNode, name: Infrastructure }
  - { id: ~mm8, type: MindNode, name: 'Floating: tree variant rendered separately by the converter' }
edges:
  - { id: e1, type: DirectedAssociation, from: ~mm1, to: ~mm2 }
  - { id: e2, type: DirectedAssociation, from: ~mm2, to: ~mm3 }
  - { id: e3, type: DirectedAssociation, from: ~mm2, to: ~mm4 }
  - { id: e4, type: DirectedAssociation, from: ~mm1, to: ~mm5 }
  - { id: e5, type: DirectedAssociation, from: ~mm1, to: ~mm6 }
  - { id: e6, type: DirectedAssociation, from: ~mm1, to: ~mm7 }
diagrams:
  - { id: d1, name: Example Mind Map (Variant) - Mind Map vs Tree, kind: mindmap, layoutProvenance: Synthesized }
