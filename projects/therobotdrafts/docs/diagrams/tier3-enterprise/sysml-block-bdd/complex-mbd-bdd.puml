@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex SysML BDD - 12+ blocks across a model-based-design hierarchy with generalization, ports, value types w/ units and a requirement satisfaction link.
'   usecase:      Teach generalization, ports+interfaces, value types with units/dimensions, and requirement satisfaction.
'   complexity:   complex
'   domain:       Model-based design (autonomous rover)
' ============================================================================
title Example SysML Block BDD - Complex MBD Hierarchy

' Value types carry units and dimensions reusable across the model.
package "ValueTypes" {
  class MassKg <<(D,#FF7700) ValueType>> {
    = Real [kg]
  }
  class PowerW <<(D,#FF7700) ValueType>> {
    = Real [W]
  }
  class TorqueNm <<(D,#FF7700) ValueType>> {
    = Real [N*m]
  }
}

interface "IPower" {
  flow in  pwrIn  : PowerW
  flow out pwrOut : PowerW
}

interface "ICommand" {
  in  cmd   : Command
  out telemetry : Telemetry
}

block "Component" <<(B,#AAAAAA) abstract>>
block "Rover" {
  value totalMass : MassKg
}
block "Locomotion" {
  value peakTorque : TorqueNm
}
block "DriveTrain" {
  port cmd : ICommand
}
block "WheelAssembly" {
  port pwr : IPower
}
block "WheelMotor" {
  value stallTorque : TorqueNm
}
block "Wheel" {
  value diameter : Real [cm]
}
block "PowerSystem" {
  value capacity : PowerW
}
block "BatteryPack" {
  value voltage : Real [V]
}
block "PowerBus" {
  port bus : IPower
}
block "ComputeSystem" {
  port cmd : ICommand
}
block "Guidance" {
  value updateRate : Integer [Hz]
}
block "Perception" {
  value range : Real [m]
}

' Generalization: specialized blocks inherit from Component.
"Locomotion" --|> "Component"
"PowerSystem" --|> "Component"
"ComputeSystem" --|> "Component"

"Rover" *-- "Locomotion"
"Rover" *-- "PowerSystem"
"Rover" *-- "ComputeSystem"

"Locomotion" *-- "DriveTrain"
"DriveTrain" *-- "WheelAssembly"
"WheelAssembly" *-- "WheelMotor"
"WheelAssembly" *-- "Wheel"

"PowerSystem" *-- "BatteryPack"
"PowerSystem" *-- "PowerBus"

"ComputeSystem" *-- "Guidance"
"ComputeSystem" *-- "Perception"

' Requirement satisfaction: a block satisfies a requirement via «satisfy».
requirement "ReqSafeStop" {
  id "REQ-001"
  text "Rover must halt within 0.5 m of stop command."
}
"Guidance" ..> "ReqSafeStop" : <<satisfy>>

@enduml
