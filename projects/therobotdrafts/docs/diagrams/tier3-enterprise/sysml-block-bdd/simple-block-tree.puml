@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Simple SysML block definition diagram - a composition tree System->Subsystem->Component with value properties.
'   usecase:      Teach block composition hierarchy and value/part properties.
'   complexity:   simple
'   domain:       System decomposition
' ============================================================================
title Example SysML Block BDD - Simple Block Tree

' A SysML Block Definition Diagram (BDD) shows blocks and their relationships.
' Composition (black diamond) means the part lives and dies with the whole.

' The root system block holds value properties (typed slots with units).
package "DroneSystem" {

  block "Drone" {
    value mass : Real [kg]
    value batteryCapacity : Real [Wh]
  }

  block "FlightController" {
    value sampleRateHz : Integer [Hz]
  }

  block "MotorAssembly" {
    value thrustRating : Real [N]
  }

  block "Propeller" {
    value diameter : Real [cm]
  }
}

' Composition tree: Drone owns a controller and a motor assembly; the assembly owns a propeller.
"Drone" *-- "FlightController"
"Drone" *-- "MotorAssembly"
"MotorAssembly" *-- "Propeller"

@enduml
