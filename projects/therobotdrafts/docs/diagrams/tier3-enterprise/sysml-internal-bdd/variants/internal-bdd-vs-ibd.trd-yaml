# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Internal BDD - Internal BDD vs IBD
elements:
  - { id: TankBlock, type: Block, name: TankBlock, members: [{ name: out, isOperation: false, visibility: Public, type: 'FluidPort        ''<<flow>>', rawText: '+out : FluidPort        ''<<flow>>' }, { name: part supply, isOperation: false, visibility: Public, type: FluidStore, rawText: 'part supply : FluidStore' }] }
  - { id: PumpBlock, type: Block, name: PumpBlock, members: [{ name: in, isOperation: false, visibility: Public, type: 'FluidPort         ''<<flow>>', rawText: '+in : FluidPort         ''<<flow>>' }, { name: part intake, isOperation: false, visibility: Public, type: IntakeChamber, rawText: 'part intake : IntakeChamber' }, { name: part impeller, isOperation: false, visibility: Public, type: Impeller, rawText: 'part impeller : Impeller' }] }
  - { id: PumpStation (IBD), type: Block, name: PumpStation (IBD), members: [{ name: 'tankOut : FluidPort    ''<<flow>>', isOperation: true, visibility: Public, params: [{ name: delegated }], rawText: '+tankOut : FluidPort    ''<<flow>> (delegated)' }, { name: 'stationIn : FluidPort  ''<<flow>>', isOperation: true, visibility: Public, params: [{ name: delegated }], rawText: '+stationIn : FluidPort  ''<<flow>> (delegated)' }, { name: part, isOperation: false, visibility: Public, type: 'TankBlock        ''as tank', rawText: 'part : TankBlock        ''as tank' }, { name: part, isOperation: false, visibility: Public, type: 'PumpBlock        ''as pump', rawText: 'part : PumpBlock        ''as pump' }] }
  - { id: ~note1, type: Note, name: ONE block boundary. The tank and pump are, documentation: 'ONE block boundary. The tank and pump are\nPART USAGES inside PumpStation. Outer ports\ndelegate to the parts. The former\ncross-block flow is now an internal\nconnector. This is what a single-block IBD\nshows; the internal-BDD on the left is the\nbroader, multi-block definition-level view.' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: PumpStation (IBD) }
diagrams:
  - { id: d1, name: Example Internal BDD - Internal BDD vs IBD, kind: class, layoutProvenance: Synthesized }
