# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: 'Example Internal BDD - Interface Blocks & Port Kinds'
elements:
  - { id: IProcessor, type: Class, name: IProcessor, stereotype: interfaceBlock, members: [{ name: fluidIn, isOperation: false, visibility: Public, type: 'FluidFlow { direction', defaultValue: 'in }', rawText: '+fluidIn : FluidFlow { direction = in }' }, { name: fluidOut, isOperation: false, visibility: Public, type: 'FluidFlow { direction', defaultValue: 'out }', rawText: '+fluidOut : FluidFlow { direction = out }' }, { name: control, isOperation: false, visibility: Public, type: 'ControlSignal { direction', defaultValue: 'inout }', rawText: '+control : ControlSignal { direction = inout }' }] }
  - { id: SourceBlock, type: Block, name: SourceBlock, members: [{ name: outProxy, isOperation: false, visibility: Public, type: 'IProcessor   ''<<proxy>>', rawText: '+outProxy : IProcessor   ''<<proxy>>' }, { name: emitter, isOperation: false, visibility: Public, type: FluidStore, rawText: '+emitter : FluidStore' }] }
  - { id: ProcessorBlock, type: Block, name: ProcessorBlock, members: [{ name: inProxy, isOperation: false, visibility: Public, type: 'IProcessor    ''<<proxy>>', rawText: '+inProxy : IProcessor    ''<<proxy>>' }, { name: inFlow, isOperation: false, visibility: Public, type: 'FluidPort      ''<<flow>>', rawText: '+inFlow : FluidPort      ''<<flow>>' }, { name: outFlow, isOperation: false, visibility: Public, type: 'FluidPort     ''<<flow>>', rawText: '+outFlow : FluidPort     ''<<flow>>' }, { name: controller, isOperation: false, visibility: Public, type: 'FullController ''<<full>>', rawText: '+controller : FullController ''<<full>>' }, { name: part core, isOperation: false, visibility: Public, type: CoreUnit, rawText: 'part core : CoreUnit' }] }
  - { id: CoolerBlock, type: Block, name: CoolerBlock, members: [{ name: inFlow, isOperation: false, visibility: Public, type: 'FluidPort      ''<<flow>>', rawText: '+inFlow : FluidPort      ''<<flow>>' }, { name: sinkProxy, isOperation: false, visibility: Public, type: 'IProcessor  ''<<proxy>>', rawText: '+sinkProxy : IProcessor  ''<<proxy>>' }, { name: part radiator, isOperation: false, visibility: Public, type: Radiator, rawText: 'part radiator : Radiator' }] }
  - { id: ~note1, type: Note, name: INTERFACE BLOCK types multiple ports, documentation: 'INTERFACE BLOCK types multiple ports\nacross block boundaries.\nFlow properties declare direction:\nin   = received\nout  = sent\ninout = bidirectional' }
  - { id: ~note2, type: Note, name: ProcessorBlock.controller is a FULL PORT, documentation: 'ProcessorBlock.controller is a FULL PORT\n(part-typed, owns behavior). inProxy is a\nPROXY PORT delegating to core. inFlow and\noutFlow are FLOW PORTS carrying FluidFlow.' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: IProcessor }
  - { id: e2, type: NoteLink, from: ~note2, to: ProcessorBlock }
diagrams:
  - { id: d1, name: 'Example Internal BDD - Interface Blocks & Port Kinds', kind: class, layoutProvenance: Synthesized }
