# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Internal BDD - Simple Internal Flow
elements:
  - { id: TankBlock, type: Block, name: TankBlock, members: [{ name: out, isOperation: false, visibility: Public, type: FluidPort, rawText: '+out: FluidPort' }, { name: part supply, isOperation: false, visibility: Public, type: FluidStore, rawText: 'part supply : FluidStore' }] }
  - { id: PumpBlock, type: Block, name: PumpBlock, members: [{ name: in, isOperation: false, visibility: Public, type: FluidPort, rawText: '+in: FluidPort' }, { name: part intake, isOperation: false, visibility: Public, type: IntakeChamber, rawText: 'part intake : IntakeChamber' }] }
  - { id: ~note1, type: Note, name: 'TankBlock.out is a FLOW PORT (atomic,', documentation: 'TankBlock.out is a FLOW PORT (atomic,\ntype = FluidFlow). It exports the\nflow properties rate, pressure.' }
  - { id: ~note2, type: Note, name: PumpBlock.in is a FLOW PORT that, documentation: 'PumpBlock.in is a FLOW PORT that\nreceives FluidFlow. Direction of the\nedge encodes out->in flow.' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: TankBlock }
  - { id: e2, type: NoteLink, from: ~note2, to: PumpBlock }
diagrams:
  - { id: d1, name: Example Internal BDD - Simple Internal Flow, kind: class, layoutProvenance: Synthesized }
