# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Internal BDD - Multi-Block Internals
elements:
  - { id: IHotFluid, type: Class, name: IHotFluid, stereotype: interfaceBlock, members: [{ name: stream, isOperation: false, visibility: Public, type: 'FluidFlow { direction', defaultValue: 'out }', rawText: '+stream : FluidFlow { direction = out }' }, { name: return, isOperation: false, visibility: Public, type: 'FluidFlow { direction', defaultValue: 'in }', rawText: '+return : FluidFlow { direction = in }' }] }
  - { id: ICoolant, type: Class, name: ICoolant, stereotype: interfaceBlock, members: [{ name: supply, isOperation: false, visibility: Public, type: 'CoolantFlow { direction', defaultValue: 'in }', rawText: '+supply : CoolantFlow { direction = in }' }, { name: drain, isOperation: false, visibility: Public, type: 'CoolantFlow { direction', defaultValue: 'out }', rawText: '+drain : CoolantFlow { direction = out }' }] }
  - { id: PowerPlant, type: Block, name: PowerPlant, members: [{ name: hotOut, isOperation: false, visibility: Public, type: 'IHotFluid        ''<<proxy>>', rawText: '+hotOut : IHotFluid        ''<<proxy>>' }, { name: coldIn, isOperation: false, visibility: Public, type: 'ICoolant         ''<<proxy>>', rawText: '+coldIn : ICoolant         ''<<proxy>>' }, { name: gridTie, isOperation: false, visibility: Public, type: 'PowerLink       ''<<standard>>', rawText: '+gridTie : PowerLink       ''<<standard>>' }, { name: part reactor, isOperation: false, visibility: Public, type: ReactorCore, rawText: 'part reactor : ReactorCore' }, { name: part steamGen, isOperation: false, visibility: Public, type: SteamGenerator, rawText: 'part steamGen : SteamGenerator' }, { name: part turb1, isOperation: false, visibility: Public, type: Turbine, rawText: 'part turb1 : Turbine' }, { name: part turb2, isOperation: false, visibility: Public, type: Turbine, rawText: 'part turb2 : Turbine' }, { name: part condenser, isOperation: false, visibility: Public, type: Condenser, rawText: 'part condenser : Condenser' }, { name: part bus, isOperation: false, visibility: Public, type: PowerBus, rawText: 'part bus : PowerBus' }] }
  - { id: CoolingTower, type: Block, name: CoolingTower, members: [{ name: supply, isOperation: false, visibility: Public, type: 'CoolantFlow      ''<<flow>>', rawText: '+supply : CoolantFlow      ''<<flow>>' }, { name: drain, isOperation: false, visibility: Public, type: 'CoolantFlow       ''<<flow>>', rawText: '+drain : CoolantFlow       ''<<flow>>' }, { name: part basin, isOperation: false, visibility: Public, type: Basin, rawText: 'part basin : Basin' }, { name: part spray, isOperation: false, visibility: Public, type: SprayDeck, rawText: 'part spray : SprayDeck' }, { name: part fan, isOperation: false, visibility: Public, type: FanUnit, rawText: 'part fan : FanUnit' }] }
  - { id: Substation, type: Block, name: Substation, members: [{ name: tie, isOperation: false, visibility: Public, type: 'PowerLink           ''<<standard>>', rawText: '+tie : PowerLink           ''<<standard>>' }, { name: feeder, isOperation: false, visibility: Public, type: 'PowerLink        ''<<standard>>', rawText: '+feeder : PowerLink        ''<<standard>>' }, { name: part breaker, isOperation: false, visibility: Public, type: Breaker, rawText: 'part breaker : Breaker' }, { name: part xfmr, isOperation: false, visibility: Public, type: Transformer, rawText: 'part xfmr : Transformer' }, { name: part meter, isOperation: false, visibility: Public, type: MeterUnit, rawText: 'part meter : MeterUnit' }] }
  - { id: Grid, type: Block, name: Grid, members: [{ name: feeder, isOperation: false, visibility: Public, type: 'PowerLink        ''<<standard>>', rawText: '+feeder : PowerLink        ''<<standard>>' }, { name: part line, isOperation: false, visibility: Public, type: GridLine, rawText: 'part line : GridLine' }] }
  - { id: ~note1, type: Note, name: INTERFACE BLOCK typing the hotOut proxy, documentation: 'INTERFACE BLOCK typing the hotOut proxy\nport of PowerPlant. Declares flow\nproperties with direction out (stream)\nand in (return).' }
  - { id: ~note2, type: Note, name: 6 parts; outer ports hotOut / coldIn are, documentation: '6 parts; outer ports hotOut / coldIn are\nPROXY ports delegating to inner parts;\ngridTie is a STANDARD port delegating to\nthe PowerBus part. Internal connectors\ncarry typed item flows with NESTED flow\nproperties (EnergyFlow.phase.v / .f).' }
  - { id: ~note3, type: Note, name: Outer STANDARD ports tie and feeder, documentation: 'Outer STANDARD ports tie and feeder\ndelegate to inner parts breaker and xfmr.' }
edges:
  - { id: e1, type: NoteLink, from: ~note1, to: IHotFluid }
  - { id: e2, type: NoteLink, from: ~note2, to: PowerPlant }
  - { id: e3, type: NoteLink, from: ~note3, to: Substation }
diagrams:
  - { id: d1, name: Example Internal BDD - Multi-Block Internals, kind: class, layoutProvenance: Synthesized }
