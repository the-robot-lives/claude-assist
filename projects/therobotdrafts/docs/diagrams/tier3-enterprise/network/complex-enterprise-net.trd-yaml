  - { id: DB1, type: Database, name: DB Primary\n10.50.0.30, parentId: SVC }
  - { id: DB2, type: Database, name: DB Replica\n10.50.0.31, parentId: SVC }
  - { id: CACHE1, type: Boundary, name: Cache\n10.50.0.40, parentId: SVC }
edges:
