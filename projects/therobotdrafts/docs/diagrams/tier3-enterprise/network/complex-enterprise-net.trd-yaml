  - { id: CFW1, type: DeploymentNode, name: Core FW (Active)\n10.255.0.1 }
  - { id: CFW2, type: DeploymentNode, name: Core FW (Standby)\n10.255.0.2 }
  - { id: CS1, type: DeploymentNode, name: Core Switch-A\n10.255.1.1 }
