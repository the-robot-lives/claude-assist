  - { id: DMZ, type: Package, name: DMZ (VLAN 20) 172.16.20.0/24 }
  - { id: WAF1, type: DeploymentNode, name: WAF\n172.16.20.5, parentId: DMZ }
  - { id: WEB1, type: DeploymentNode, name: Web-01\n172.16.20.10, parentId: DMZ }
