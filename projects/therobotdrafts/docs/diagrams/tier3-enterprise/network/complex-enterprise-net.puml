' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Complex enterprise network: internet edge, DMZ, core, distribution, access
'                 layers, redundant links, and addressing across 12+ devices.
'   usecase:      Teach layered enterprise topology with redundancy and addressing.
'   complexity:   complex
'   domain:       network / topology
' ============================================================================
title Example Network - Complex Enterprise Topology

cloud "Internet" as INET

' ---- Edge layer (redundant ISPs) ----
node "ISP-A Edge\n203.0.113.2/30" as ISP_A
node "ISP-B Edge\n198.51.100.2/30" as ISP_B
node "Edge Router R1" as ER1
node "Edge Router R2" as ER2

' ---- DMZ ----
package "DMZ (VLAN 20) 172.16.20.0/24" as DMZ {
  node "WAF\n172.16.20.5" as WAF1
  node "Web-01\n172.16.20.10" as WEB1
  node "Web-02\n172.16.20.11" as WEB2
  node "VPN Gateway\n172.16.20.30" as VPN1
}

' ---- Core layer (redundant) ----
node "Core FW (Active)\n10.255.0.1" as CFW1
node "Core FW (Standby)\n10.255.0.2" as CFW2
node "Core Switch-A\n10.255.1.1" as CS1
node "Core Switch-B\n10.255.1.2" as CS2

' ---- Distribution layer ----
package "Distribution (VLAN 30) 10.30.0.0/16" as DIST {
  node "Dist Switch D1" as DS1
  node "Dist Switch D2" as DS2
}

' ---- Access layer ----
package "Access (VLAN 40) 10.40.0.0/16" as ACCESS {
  node "Access SW A1" as AS1
  node "Access SW A2" as AS2
}

' ---- Services ----
package "Services (VLAN 50) 10.50.0.0/24" as SVC {
  node "App Cluster\n10.50.0.10" as APP1
  database "DB Primary\n10.50.0.30" as DB1
  database "DB Replica\n10.50.0.31" as DB2
  queue "Cache\n10.50.0.40" as CACHE1
}

' ---- Edge connectivity ----
INET --> ISP_A : "Tier-1 transit"
INET --> ISP_B : "Tier-2 transit"
ISP_A --> ER1
ISP_B --> ER2
ER1 --> CFW1 : "HA link"
ER2 --> CFW2 : "HA link"

' Redundant core (HSRP/VRRP).
CFW1 --> CS1
CFW2 --> CS2
CFW1 ..> CFW2 : "HA sync"

' Core to distribution (redundant).
CS1 --> DS1 : "10G uplink"
CS1 --> DS2 : "10G uplink"
CS2 --> DS1 : "10G uplink"
CS2 --> DS2 : "10G uplink"

' Distribution to access.
DS1 --> AS1
DS2 --> AS2

' DMZ behind core FW.
CFW1 --> WAF1 : "allow 443"
WAF1 --> WEB1
WAF1 --> WEB2
CFW1 --> VPN1 : "allow UDP/1194"

' Access to services via distribution.
AS1 --> APP1
AS2 --> APP1
APP1 --> DB1 : "5432"
DB1 --> DB2 : "streaming replication"
APP1 --> CACHE1 : "6379"
