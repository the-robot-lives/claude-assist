' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Medium network: firewall, DMZ segment, internal LAN, switch, servers, VLANs.
'   usecase:      Teach segmented topology with DMZ and addressing/VLANs.
'   complexity:   medium
'   domain:       network / topology
' ============================================================================
title Example Network - Medium DMZ Topology

cloud "Internet" as INET

node "Edge Firewall\nFW-01" as FW1

' ---- DMZ segment ----
package "DMZ (VLAN 20) - 172.16.20.0/24" as DMZ {
  node "Web Server\n172.16.20.10" as WEB1
  node "Mail Relay\n172.16.20.11" as MAIL1
}

' ---- Internal LAN ----
package "Internal LAN (VLAN 10) - 10.0.0.0/24" as LAN {
  node "Core Switch\nSW-CORE" as SW1
  node "App Server\n10.0.0.20" as APP1
  database "DB Server\n10.0.0.30" as DB1
  node "Admin Host\n10.0.0.5" as ADM1
}

INET --> FW1 : "WAN 198.51.100.5/29"

' Firewall enforces DMZ vs LAN rules.
FW1 --> WEB1 : "allow 443 (DMZ in)"
FW1 --> MAIL1 : "allow 25 (DMZ in)"

' DMZ cannot initiate into LAN; LAN reaches DMZ for updates.
WEB1 ..> FW1 : "no inbound to LAN"
SW1 --> APP1 : "Gi1/0/10 access"
SW1 --> DB1 : "Gi1/0/11 access"
SW1 --> ADM1 : "Gi1/0/5 access"
APP1 --> DB1 : "5432 (internal)"

' Firewall to LAN switch (controlled).
FW1 --> SW1 : "inter-VLAN routing 10.0.0.1"
