' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Same topology logical (abstract segments + flows) vs physical (named devices, ports, cables).
'   usecase:      Teach the abstraction difference between logical and physical network diagrams.
'   complexity:   variant
'   domain:       network / topology
' ============================================================================
title Example Network - Logical vs Physical

note as TopNote
  VARIANT: same 3-tier app topology shown two ways.
  TOP: LOGICAL - abstract segments (internet/DMZ/app/data) and flows.
       Hides device names/ports; shows trust boundaries and traffic.
  BOTTOM: PHYSICAL - named devices, ports, cables, IPs.
       Needed for cabling, rack layout, on-site troubleshooting.
  Both views are needed; neither replaces the other.
end note

' ============ TOP: LOGICAL ============
cloud "Internet (logical)" as L_INET
package "DMZ segment" as L_DMZ { node "Web tier" as L_WEB }
package "App segment" as L_APP { node "App tier" as L_APPN }
package "Data segment" as L_DATA { database "DB tier" as L_DB }

L_INET --> L_DMZ : "HTTPS flow"
L_DMZ --> L_APP : "app calls"
L_APP --> L_DATA : "queries"

' ============ BOTTOM: PHYSICAL ============
cloud "Internet (physical)" as P_INET
node "FW-01\n203.0.113.1" as P_FW
node "SW-DMZ-01\n172.16.20.1" as P_SW_D
node "WEB-01\n172.16.20.10" as P_WEB
node "SW-APP-01\n10.0.0.1" as P_SW_A
node "APP-01\n10.0.0.20" as P_APP
database "DB-01\n10.0.0.30" as P_DB

P_INET --> P_FW : "eth0 (WAN)"
P_FW --> P_SW_D : "eth1 Gi1/0/1 (Cat6)"
P_SW_D --> P_WEB : "Gi1/0/2 (Cat6)"
P_FW --> P_SW_A : "eth2 Gi1/0/24 (fiber)"
P_SW_A --> P_APP : "Gi1/0/10 (Cat6)"
P_SW_A --> P_DB : "Gi1/0/11 (Cat6)"
P_APP --> P_DB : "TCP 5432"
