# .trd-yaml — TheRobotDrafts native model (IxModel serialization)
name: Example Network - Medium DMZ Topology
elements:
  - { id: INET, type: Cloud, name: Internet }
  - { id: FW1, type: DeploymentNode, name: Edge Firewall\nFW-01 }
  - { id: DMZ, type: Package, name: DMZ (VLAN 20) - 172.16.20.0/24 }
  - { id: WEB1, type: DeploymentNode, name: Web Server\n172.16.20.10, parentId: DMZ }
  - { id: MAIL1, type: DeploymentNode, name: Mail Relay\n172.16.20.11, parentId: DMZ }
  - { id: LAN, type: Package, name: Internal LAN (VLAN 10) - 10.0.0.0/24 }
  - { id: SW1, type: DeploymentNode, name: Core Switch\nSW-CORE, parentId: LAN }
  - { id: APP1, type: DeploymentNode, name: App Server\n10.0.0.20, parentId: LAN }
  - { id: DB1, type: Database, name: DB Server\n10.0.0.30, parentId: LAN }
  - { id: ADM1, type: DeploymentNode, name: Admin Host\n10.0.0.5, parentId: LAN }
edges:
  - { id: e1, type: DirectedAssociation, from: INET, to: FW1, label: '"WAN 198.51.100.5/29"' }
  - { id: e2, type: DirectedAssociation, from: FW1, to: WEB1, label: '"allow 443 (DMZ in)"' }
  - { id: e3, type: DirectedAssociation, from: FW1, to: MAIL1, label: '"allow 25 (DMZ in)"' }
  - { id: e4, type: Dependency, from: WEB1, to: FW1, label: '"no inbound to LAN"' }
  - { id: e5, type: DirectedAssociation, from: SW1, to: APP1, label: '"Gi1/0/10 access"' }
  - { id: e6, type: DirectedAssociation, from: SW1, to: DB1, label: '"Gi1/0/11 access"' }
  - { id: e7, type: DirectedAssociation, from: SW1, to: ADM1, label: '"Gi1/0/5 access"' }
  - { id: e8, type: DirectedAssociation, from: APP1, to: DB1, label: '"5432 (internal)"' }
  - { id: e9, type: DirectedAssociation, from: FW1, to: SW1, label: '"inter-VLAN routing 10.0.0.1"' }
diagrams:
  - { id: d1, name: Example Network - Medium DMZ Topology, kind: component, layoutProvenance: Synthesized }
