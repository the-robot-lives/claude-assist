@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Hybrid cloud — on-prem + cloud, 14 technology elements.
'   usecase:      Teaching nodes, networks, paths, artifacts, realization.
'   complexity:   complex
'   domain:       enterprise-architecture / technology
' ============================================================================
title Example ArchiMate Technology - Complex Hybrid Cloud

note "Technology = GREEN.\nOn-prem (left) | Cloud (right) | Path=VPN/ExpressRoute" as Legend

' ===== ON-PREM =====
package "On-Premises Datacenter" #E8F5E9 {
  rectangle "<<node>>\nBare Metal\nDB Host" as N1 #C8E6C9
  rectangle "<<node>>\nVM Host" as N2 #C8E6C9
  rectangle "<<device>>\nFirewall" as D1 #C8E6C9
  rectangle "<<device>>\nOn-Prem LB" as D2 #C8E6C9
  rectangle "<<system software>>\nPostgreSQL" as SW1 #A5D6A7
  rectangle "<<system software>>\nKVM" as SW2 #A5D6A7
  rectangle "<<system software>>\nLegacy App\nServer" as SW3 #A5D6A7
  rectangle "<<network>>\nCorp LAN" as NET1 #81C784
  rectangle "<<artifact>>\nLegacy.war" as ART1 #ECEFF1
}

' ===== CLOUD =====
package "Public Cloud" #E3F2FD {
  rectangle "<<node>>\nEKS\nCluster" as C1 #C8E6C9
  rectangle "<<node>>\nLambda\nFunctions" as C2 #C8E6C9
  rectangle "<<device>>\nCloud LB" as CD1 #C8E6C9
  rectangle "<<system software>>\nContainer\nRuntime" as CSW1 #A5D6A7
  rectangle "<<system software>>\nRDS Proxy" as CSW2 #A5D6A7
  rectangle "<<network>>\nCloud VPC" as NET2 #81C784
  rectangle "<<artifact>>\napi:v3.img" as ART2 #ECEFF1
}

' ===== BRIDGE =====
rectangle "<<communication path>>\nSite-to-Site\nVPN" as VPN #FFCC80
rectangle "<<system software>>\nCloud Sync\nAgent" as SYNC #A5D6A7

' --- on-prem wiring ---
D2 -[#444]-> N2 : <<serving>>
D1 -[#444]-> D2 : <<serving>>
N1 -[#444]-> SW1 : <<assignment>>
N2 -[#444]-> SW2 : <<assignment>>
N2 -[#444]-> SW3 : <<assignment>>
ART1 -[#444]-> SW3 : <<realization>>
N1 -[#444]-> NET1 : <<aggregation>>
N2 -[#444]-> NET1 : <<aggregation>>
D1 -[#444]-> NET1 : <<aggregation>>

' --- cloud wiring ---
CD1 -[#444]-> C1 : <<serving>>
C1 -[#444]-> CSW1 : <<assignment>>
C1 -[#444]-> CSW2 : <<assignment>>
C2 -[#444]-> CSW1 : <<used by>>
ART2 -[#444]-> CSW1 : <<realization>>
C1 -[#444]-> NET2 : <<aggregation>>
C2 -[#444]-> NET2 : <<aggregation>>

' --- bridge wiring ---
VPN -[#444]-> NET1 : <<association>>
VPN -[#444]-> NET2 : <<association>>
SYNC -[#444]-> N2 : <<assignment>>
SYNC -[#444]-> C1 : <<serving>>
CSW2 .[#888].> SW1 : <<realization (DB proxy)>>"

' --- realization of app services (cross-layer hint) ---
SW3 .[#aaa].> CSW1 : <<migration target>>"

@enduml
