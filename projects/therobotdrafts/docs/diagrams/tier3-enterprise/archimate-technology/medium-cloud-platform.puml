@startuml
' ============================================================================
' METADATA
'   author:       TheRobotDrafts Examples
'   description:  Cloud platform — servers, VMs, containers, paths, artifacts.
'   usecase:      Teaching node, system software, artifact, path, deployment.
'   complexity:   medium
'   domain:       enterprise-architecture / technology
' ============================================================================
title Example ArchiMate Technology - Medium Cloud Platform

note "Technology = GREEN.\nArtifact=grey | Path=dashed | Software=darker green" as Legend

rectangle "<<node>>\nK8s\nCluster" as N1 #C8E6C9
rectangle "<<node>>\nVM\n(bastion)" as N2 #C8E6C9
rectangle "<<device>>\nCloud LB" as D1 #C8E6C9
rectangle "<<system software>>\nContainer\nRuntime" as SW1 #A5D6A7
rectangle "<<system software>>\netcd" as SW2 #A5D6A7
rectangle "<<artifact>>\nDocker\nImage: api:v2" as ART #ECEFF1
rectangle "<<communication path>>\nTLS Tunnel" as PATH #81C784
rectangle "<<network>>\nVPC" as NET #81C784

D1 -[#444]-> N1 : <<serving>>
N1 -[#444]-> SW1 : <<assignment>>
N1 -[#444]-> SW2 : <<assignment>>
ART -[#444]-> SW1 : <<realization>>
N1 -[#444]-> NET : <<aggregation>>
N2 -[#444]-> NET : <<aggregation>>
N2 .[#888].> N1 : <<used by (via)>>
PATH -[#444]-> N2 : <<association>>
PATH -[#444]-> N1 : <<association>>

@enduml
