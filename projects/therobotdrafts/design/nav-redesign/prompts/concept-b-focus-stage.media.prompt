schema: "0.4"
id: trd-nav-concept-b-focus-stage
type: image
quality: high
service: gemini

prompt:
  text: >
    Professional macOS desktop application UI mockup for a 3D UML modeling tool,
    "focus stage" layout: native macOS menu bar at top, then an almost chromeless
    edge-to-edge dark 3D viewport of floating UML class slabs with glowing
    relationship lines; a floating translucent command palette bar centered near
    the top (spotlight-style search "Type a command..."); a small floating
    contextual toolbar hovering next to a selected 3D node with icons (connect,
    edit, delete); left and right screen edges show slim collapsed panel tabs that
    peek in (Library, Inspector) ready to slide out; bottom center a minimal pill
    dock with mode icons. Dark near-black theme, one warm amber accent, frosted
    glass floating surfaces, macOS Sonoma vibrancy, minimal flat design,
    professional creative tool. Clean legible UI labels.
  negative: "photograph, hands, people, watermark, blurry text, light theme, cluttered, dense panels"
  style: ui-mockup

output:
  formats:
    - format: png
      quality: 100
  dimensions:
    width: 1600
    height: 900
    aspect_ratio: "16:9"

tags: [trd, ui, nav-redesign, concept-b]
