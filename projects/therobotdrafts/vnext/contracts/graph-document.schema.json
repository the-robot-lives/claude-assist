{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://therobotdrafts.com/contracts/graph-document.schema.json",
  "title": "HoloGraph GraphDocument",
  "type": "object",
  "required": ["id", "slug", "title", "version", "updatedAt", "summary", "nodes", "edges"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "modelKind": {
      "type": "string",
      "enum": ["uml", "sysml", "bpmn", "archimate", "code"]
    },
    "view": {
      "type": "object",
      "properties": {
        "projection": {
          "type": "string",
          "enum": ["trd-3d-uml", "bubble-pack", "class-diagram", "component-diagram"]
        },
        "activeLayer": { "type": "integer" },
        "camera": {
          "type": "object",
          "required": ["target", "yaw", "pitch", "distance"],
          "properties": {
            "target": { "$ref": "#/$defs/vector3" },
            "yaw": { "type": "number" },
            "pitch": { "type": "number" },
            "distance": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "label", "kind", "description", "metrics"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["system", "package", "service", "class", "interface", "function", "database", "agent"]
        },
        "parentId": { "type": "string" },
        "packageName": { "type": "string" },
        "description": { "type": "string" },
        "stereotype": { "type": "string" },
        "uml": {
          "type": "object",
          "properties": {
            "elementType": { "type": "string" },
            "visibility": {
              "type": "string",
              "enum": ["public", "private", "protected", "package"]
            },
            "abstract": { "type": "boolean" },
            "attributes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "operations": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "trd3d": {
          "type": "object",
          "required": ["position"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": { "$ref": "#/$defs/vector3" },
            "dimensions": {
              "type": "object",
              "required": ["width", "height", "depth"],
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "depth": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "layer": { "type": "integer" },
            "shape": {
              "type": "string",
              "enum": ["slab", "package", "component", "cylinder", "sphere", "actor", "interface"]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["complexity", "churn", "risk"],
          "properties": {
            "complexity": { "type": "integer", "minimum": 0, "maximum": 100 },
            "churn": { "type": "integer", "minimum": 0, "maximum": 100 },
            "risk": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["stable", "draft", "review", "hot"]
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "sourceId", "targetId", "kind", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["contains", "calls", "depends_on", "publishes", "stores", "patches"]
        },
        "label": { "type": "string" },
        "uml": {
          "type": "object",
          "required": ["relationship"],
          "properties": {
            "relationship": {
              "type": "string",
              "enum": ["association", "dependency", "generalization", "realization", "composition", "aggregation", "deployment", "trace"]
            },
            "sourceMultiplicity": { "type": "string" },
            "targetMultiplicity": { "type": "string" },
            "dashed": { "type": "boolean" },
            "arrow": {
              "type": "string",
              "enum": ["open", "closed", "triangle", "diamond", "none"]
            }
          }
        },
        "trd3d": {
          "type": "object",
          "properties": {
            "waypoints": {
              "type": "array",
              "items": { "$ref": "#/$defs/vector3" },
              "minItems": 2
            },
            "layer": { "type": "number" }
          }
        }
      }
    },
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
