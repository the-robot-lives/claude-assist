{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefre.sh/contracts/otlp-receiver.schema.json",
  "title": "CodeFresh OTLP Receiver Contract",
  "x-codefresh-contract": "otlp-receiver",
  "x-codefresh-contract-version": "1.0.0",
  "oneOf": [
    {
      "type": "object",
      "required": ["resourceSpans"],
      "additionalProperties": true,
      "properties": {
        "resourceSpans": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceSpans" }
        }
      }
    },
    {
      "type": "object",
      "required": ["resourceLogs"],
      "additionalProperties": true,
      "properties": {
        "resourceLogs": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceLogs" }
        }
      }
    }
  ],
  "$defs": {
    "attribute": {
      "type": "object",
      "required": ["key", "value"],
      "additionalProperties": true,
      "properties": {
        "key": { "type": "string" },
        "value": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "resourceSpans": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "resource": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "attributes": {
              "type": "array",
              "items": { "$ref": "#/$defs/attribute" }
            }
          }
        },
        "scopeSpans": {
          "type": "array",
          "items": { "$ref": "#/$defs/scopeSpans" }
        },
        "instrumentationLibrarySpans": {
          "type": "array",
          "items": { "$ref": "#/$defs/scopeSpans" }
        }
      }
    },
    "scopeSpans": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/span" }
        }
      }
    },
    "span": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "traceId": { "type": "string" },
        "trace_id": { "type": "string" },
        "spanId": { "type": "string" },
        "span_id": { "type": "string" },
        "parentSpanId": { "type": "string" },
        "parent_span_id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": ["integer", "string"] },
        "startTimeUnixNano": { "type": ["string", "integer"] },
        "start_time_unix_nano": { "type": ["string", "integer"] },
        "endTimeUnixNano": { "type": ["string", "integer"] },
        "end_time_unix_nano": { "type": ["string", "integer"] },
        "status": {
          "type": "object",
          "additionalProperties": true
        },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        },
        "events": {
          "type": "array"
        }
      }
    },
    "resourceLogs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "resource": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "attributes": {
              "type": "array",
              "items": { "$ref": "#/$defs/attribute" }
            }
          }
        },
        "scopeLogs": {
          "type": "array",
          "items": { "$ref": "#/$defs/scopeLogs" }
        }
      }
    },
    "scopeLogs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "logRecords": {
          "type": "array",
          "items": { "$ref": "#/$defs/logRecord" }
        }
      }
    },
    "logRecord": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "traceId": { "type": "string" },
        "trace_id": { "type": "string" },
        "spanId": { "type": "string" },
        "span_id": { "type": "string" },
        "timeUnixNano": { "type": ["string", "integer"] },
        "timestamp": { "type": ["string", "integer"] },
        "severityNumber": { "type": "integer" },
        "severityText": { "type": "string" },
        "body": {},
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        }
      }
    }
  }
}
