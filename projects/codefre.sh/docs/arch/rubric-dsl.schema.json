{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefre.sh/contracts/rubric-dsl.schema.json",
  "title": "CodeFresh Rubric DSL Contract",
  "x-codefresh-contract": "rubric-dsl",
  "x-codefresh-contract-version": "1.0.0",
  "type": "object",
  "required": ["judge_prompt_version_id", "judge_model", "scale", "criteria", "n_samples"],
  "additionalProperties": true,
  "properties": {
    "judge_prompt_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "judge_model": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "$ref": "#/$defs/scale"
    },
    "criteria": {
      "$ref": "#/$defs/criteria"
    },
    "n_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 1
    }
  },
  "$defs": {
    "scale": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "additionalProperties": true,
          "properties": {
            "type": { "const": "continuous" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "additionalProperties": true,
          "properties": {
            "type": { "const": "discrete" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "additionalProperties": true,
          "properties": {
            "type": { "enum": ["ladder", "enum"] },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["label", "score"],
                "additionalProperties": true,
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "score": { "type": "number" }
                }
              }
            }
          }
        }
      ]
    },
    "criteria": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "weight"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "direction": { "type": "string", "enum": ["positive", "negative"], "default": "positive" },
              "judge_model": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
