{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefre.sh/contracts/yaml-script.schema.json",
  "title": "CodeFresh YAML Script Contract",
  "description": "Canonical JSON shape represented by the CodeFresh YAML script import/export format.",
  "x-codefresh-contract": "yaml-script",
  "x-codefresh-contract-version": "1.0.0",
  "type": "object",
  "required": ["script", "root", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "script": {
      "type": "object",
      "required": ["slug", "name"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": ["string", "null"]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "root": {
      "$ref": "#/$defs/nodeKey"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "nodeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "versionedRef": {
      "type": "object",
      "required": ["slug", "version"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["key", "kind"],
      "additionalProperties": true,
      "properties": {
        "key": {
          "$ref": "#/$defs/nodeKey"
        },
        "kind": {
          "type": "string",
          "enum": ["user_turn", "system", "assistant_turn", "terminal", "freeball_anchor"]
        },
        "prompt": {
          "anyOf": [
            { "$ref": "#/$defs/versionedRef" },
            { "type": "null" }
          ]
        },
        "tone": {
          "type": ["string", "null"]
        },
        "eval_tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "freeball_policy": {
          "type": "string",
          "enum": ["allow", "deny", "anchor"],
          "default": "allow"
        },
        "position": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean", "null"] },
          "default": {}
        },
        "metadata": {
          "type": "object",
          "default": {}
        },
        "expectations": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectation" },
          "default": []
        }
      }
    },
    "expectation": {
      "type": "object",
      "required": ["label", "weight", "direction", "scoring_method", "config"],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "weight": {
          "type": ["string", "number"],
          "pattern": "^(0(\\.\\d{1,3})?|1(\\.0{1,3})?)$"
        },
        "direction": {
          "type": "string",
          "enum": ["positive", "negative"]
        },
        "scoring_method": {
          "type": "string",
          "enum": ["lm_judge", "rubric", "regex", "semantic", "structural"]
        },
        "config": {
          "type": "object"
        },
        "rubric": {
          "anyOf": [
            { "$ref": "#/$defs/versionedRef" },
            { "type": "null" }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "match_method"],
      "additionalProperties": true,
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeKey"
        },
        "to": {
          "$ref": "#/$defs/nodeKey"
        },
        "match_method": {
          "type": "string",
          "enum": ["regex", "semantic", "lm_judge", "structural", "always", "freeball"]
        },
        "match_config": {
          "type": "object",
          "default": {}
        },
        "priority": {
          "type": "integer",
          "default": 0
        },
        "label": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
