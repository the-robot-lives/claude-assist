{
  "name": "tobornalp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate-css": "tsx src/scripts/generate-css.ts",
    "build": "npm run generate-css && next build",
    "start": "next start",
    "regen": "rm -rf .cache && npm run generate-css",
    "test": "tsx src/lib/auth-flow.test.ts",
    "test:e2e:types": "tsc --noEmit -p cypress/tsconfig.json",
    "test:e2e": "cypress run --e2e",
    "test:e2e:open": "cypress open --e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@headlessui/react": "^2.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@noizu/styleguide": "0.1.18",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-document-load": "^0.64.0",
    "@opentelemetry/instrumentation-fetch": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tailwindcss/postcss": "^4.3.1",
    "js-yaml": "^5.1.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "phoenix": "^1.8.8",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cypress": "^15.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.7",
    "postcss": "^8.5.15"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/**/*.ts"
    ]
  }
}
