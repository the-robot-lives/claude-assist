# Quiz Definition
# Generated by kb-quiz-generator from knowledge articles.
# Run via /quiz or the web quiz app.
#
# PURPOSE: Defines questions, correct answers, explanations, and grading rubrics
# for a topic assessment. Agents generate these from knowledge articles; you
# can also write them manually or request a specific style.
#
# QUESTION TYPES:
#   multiple_choice — one correct answer from a list
#   multi_select    — one or more correct answers (checkboxes)
#   fill_in_blank   — type the exact answer (with accepted alternates)
#   matching        — drag-and-drop pairs
#   ordering        — arrange steps in correct sequence
#   short_answer    — free-text graded by rubric (agent evaluates)
#   true_false      — binary choice with explanation

# ── Quiz Metadata ─────────────────────────────────────────────────────────────

quiz_id: ntfs-mounting-quiz
title: "NTFS Mounting on Linux"
description: "Test your knowledge of mounting NTFS drives with read/write support
  on Linux, including fstab syntax, ntfs-3g, and the kernel ntfs3 driver."

# Source articles this quiz was generated from.
source_articles:
  - computing/linux/mount-ntfs
  - computing/linux/fstab

# Complexity level — should match the article's complexity.
difficulty: intermediate

created: "2026-05-06"
updated: "2026-05-06"

# Optional: hard time limit. null = untimed.
time_limit_minutes: 15

# Minimum score to pass and receive credit toward a learning goal checkpoint.
passing_score: 75

# Whether to show explanations immediately after each question (practice mode)
# or only at the end (exam mode).
feedback_mode: immediate  # immediate | end

# Randomize question order each attempt.
shuffle_questions: true

# Randomize multiple-choice option order each attempt.
shuffle_options: true

# ── Questions ─────────────────────────────────────────────────────────────────

questions:

  # ── Multiple Choice ─────────────────────────────────────────────────────────
  - id: q1
    type: multiple_choice
    points: 10
    question: "Which package provides NTFS write support on Linux kernels older than 5.15?"
    options:
      - ntfs-utils
      - ntfs-3g
      - ntfs-fuse
      - ntfs-driver
    correct: ntfs-3g
    explanation: "ntfs-3g is the open-source FUSE-based NTFS driver that provides
      full read/write support on any kernel. The kernel's built-in ntfs driver
      (pre-5.15) was read-only. ntfs-utils and ntfs-driver do not exist as packages."

  # ── Multi-Select ─────────────────────────────────────────────────────────────
  - id: q2
    type: multi_select
    points: 15
    question: "Which of the following are valid ways to mount an NTFS drive with
      write support on Linux? (Select all that apply)"
    options:
      - "mount -t ntfs-3g /dev/sdb1 /mnt/data"
      - "mount -t ntfs /dev/sdb1 /mnt/data"
      - "mount -t ntfs3 /dev/sdb1 /mnt/data"
      - "mount -t ext4 /dev/sdb1 /mnt/data"
      - "ntfs-3g /dev/sdb1 /mnt/data"
    correct:
      - "mount -t ntfs-3g /dev/sdb1 /mnt/data"
      - "mount -t ntfs3 /dev/sdb1 /mnt/data"
      - "ntfs-3g /dev/sdb1 /mnt/data"
    explanation: |
      - `mount -t ntfs-3g` — correct; uses the FUSE driver
      - `mount -t ntfs3` — correct on Linux 5.15+; uses the in-kernel driver with write support
      - `ntfs-3g /dev/sdb1 /mnt/data` — correct; ntfs-3g can be called directly
      - `mount -t ntfs` — incorrect; the old ntfs driver is read-only
      - `mount -t ext4` — incorrect; ext4 cannot read NTFS filesystems

  # ── Fill in the Blank ────────────────────────────────────────────────────────
  - id: q3
    type: fill_in_blank
    points: 10
    question: "Complete the mount command: `mount -t _____ /dev/sdb1 /mnt/data`
      (use the FUSE-based NTFS driver)"
    correct: "ntfs-3g"
    accept_also:
      - "ntfs3g"
      - "NTFS-3G"
      - "NTFS3G"
    case_sensitive: false
    explanation: "ntfs-3g is specified as the filesystem type (-t) to invoke the
      FUSE-based ntfs-3g driver. The hyphen is conventional but not required by
      the tool."

  # ── Matching ──────────────────────────────────────────────────────────────────
  - id: q4
    type: matching
    points: 20
    question: "Match each NTFS mount option to its purpose:"
    pairs:
      - left: "ro"
        right: "Mount the filesystem read-only"
      - left: "uid=1000"
        right: "Map all files to this Unix user ID"
      - left: "umask=022"
        right: "Set default permissions (rw-r--r-- for files)"
      - left: "big_writes"
        right: "Enable large write buffers for better throughput"
      - left: "remove_hiberfile"
        right: "Force mount despite Windows hibernation state"
    explanation: "NTFS has no native Unix permission model. The uid/gid/umask
      options impose Unix-style ownership at mount time. remove_hiberfile is
      needed when Windows fast startup leaves the drive in a dirty state."

  # ── Ordering ──────────────────────────────────────────────────────────────────
  - id: q5
    type: ordering
    points: 15
    question: "Put these steps in the correct order to permanently mount an NTFS
      drive with write support on Ubuntu:"
    steps:
      - id: a
        text: "Install ntfs-3g with `apt install ntfs-3g`"
      - id: b
        text: "Identify the device name with `lsblk` or `blkid`"
      - id: c
        text: "Create the mount point directory"
      - id: d
        text: "Add an fstab entry with filesystem type ntfs-3g"
      - id: e
        text: "Run `mount -a` to test the fstab entry"
      - id: f
        text: "Verify write access with a test file"
    correct_order: [a, b, c, d, e, f]
    partial_credit: true  # award points for partially correct ordering
    explanation: "You must install the driver before mounting. Identifying the
      device before creating the mount point avoids confusion. Always test fstab
      with `mount -a` before rebooting to catch errors."

  # ── Short Answer ──────────────────────────────────────────────────────────────
  - id: q6
    type: short_answer
    points: 30
    question: "A colleague gets this error when trying to mount an NTFS drive:
      `Metadata kept in Windows cache, refused to mount.`
      Explain what caused this error and describe two ways to resolve it."
    # Rubric used by the agent to evaluate free-text answers
    rubric:
      key_points:
        - id: cause
          description: "Windows fast startup / hibernation left the drive dirty"
          points: 10
        - id: fix-windows
          description: "Boot into Windows, disable fast startup or run chkdsk /f"
          points: 10
        - id: fix-linux
          description: "Force mount with remove_hiberfile option (data loss risk noted)"
          points: 10
      scoring:
        full_marks: "Identifies the Windows hibernation/fast-startup cause AND
          describes both fix options with the data-loss caveat for remove_hiberfile"
        partial: "Correctly identifies the cause and at least one fix"
        minimal: "Vaguely references Windows or dirty filesystem without specific steps"
        zero: "Unrelated answer or blank"
      agent_instructions: "Evaluate the free-text response against key_points.
        Award partial points for partially correct explanations. Accept 'Windows
        fast startup', 'hibernation', or 'unclean unmount' as valid cause statements."

