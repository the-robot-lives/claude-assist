# Flashcard Deck — Anki-compatible format with spaced repetition metadata
# Generated by kb-flashcard-generator from knowledge articles.
# Edited manually to add or correct cards.
#
# PURPOSE: Stores flashcard content and SM-2 spaced repetition state so the
# agent can schedule reviews and update intervals after each session.
#
# SPACED REPETITION (SM-2 ALGORITHM):
#   After each review, the agent updates interval, repetitions, and ease_factor
#   based on how well you answered (0=blackout → 5=perfect).
#   Cards with ease_factor < 1.3 are flagged as "leeches" for special attention.
#
# CARD TYPES:
#   basic           — front/back flip
#   cloze           — fill-in-the-blank in the front text (marked with {{...}})
#   image-occlusion — (future) hide regions of a diagram
#
# DIFFICULTY LABELS (informational, doesn't affect SM-2):
#   easy | medium | hard

# ── Deck Metadata ─────────────────────────────────────────────────────────────

deck: computing-linux
description: "Linux system administration — filesystems, networking, process
  management, storage, and shell tooling"
tags:
  - computing
  - linux
  - sysadmin
domain: computing
subdomain: linux

created: "2026-05-01"
updated: "2026-05-06"

# Source articles this deck was generated from. Agent re-runs generation
# when an article's `updated` date is newer than the deck's `updated` date.
source_articles:
  - computing/linux/mount-ntfs
  - computing/linux/fstab
  - computing/linux/permissions
  - computing/linux/process-management

# Export settings (used by /export-flashcards command)
export:
  format: anki          # anki | supermemo | plain
  deck_name: "Linux::Sysadmin"  # Anki deck hierarchy (:: = nested deck)

# ── Stats (maintained by agent) ───────────────────────────────────────────────

stats:
  total_cards: 4
  due_today: 2
  new_cards: 1
  mature_cards: 1       # interval >= 21 days
  leech_cards: 0        # ease_factor < 1.3
  last_reviewed: "2026-05-05"
  average_retention: 87  # % correct over last 30 days

# ── Cards ─────────────────────────────────────────────────────────────────────

cards:

  # ── Basic card ──────────────────────────────────────────────────────────────
  - id: ntfs-mount-001
    type: basic
    front: "What package provides NTFS write support on Linux for kernels older than 5.15?"
    back: |
      **ntfs-3g** — a FUSE-based NTFS driver.

      Install:
      ```bash
      apt install ntfs-3g    # Debian/Ubuntu
      dnf install ntfs-3g    # Fedora
      ```

      Mount:
      ```bash
      mount -t ntfs-3g /dev/sdb1 /mnt/data
      ```
    tags: [ntfs, filesystems]
    difficulty: easy
    source_article: computing/linux/mount-ntfs
    # ── SM-2 state ────────────────────────────────────────────
    interval: 14             # days until next review
    repetitions: 3           # times answered correctly in a row
    ease_factor: 2.7         # multiplier applied to interval on correct answer
    next_review: "2026-05-19"
    last_review: "2026-05-05"
    last_quality: 4          # 0–5 quality rating from last review

  # ── Basic card with multi-line back ─────────────────────────────────────────
  - id: ntfs-mount-002
    type: basic
    front: "What mount option enables NTFS write support for ntfs-3g in /etc/fstab?"
    back: |
      Specify **ntfs-3g** as the filesystem type:

      ```
      /dev/sdb1  /mnt/data  ntfs-3g  defaults,uid=1000,gid=1000,umask=022  0  0
      ```

      Key options:
      - `uid` / `gid` — map all files to this user/group (NTFS has no Unix perms)
      - `umask=022` — owner rw, group/other r
      - `big_writes` — enable large write buffers for better throughput
      - `noatime` — skip access-time updates (faster on spinning disks)
    tags: [ntfs, mount, fstab]
    difficulty: medium
    source_article: computing/linux/mount-ntfs
    interval: 1
    repetitions: 0
    ease_factor: 2.5
    next_review: "2026-05-07"
    last_review: null
    last_quality: null

  # ── Cloze card ──────────────────────────────────────────────────────────────
  - id: fstab-fields-001
    type: cloze
    # {{...}} marks the hidden text. Multiple cloze deletions = multiple cards.
    front: "An fstab entry has 6 fields: device, mountpoint, fstype,
      {{options}}, {{dump}}, and {{pass}}."
    back: |
      Full field order:
      `<device>  <mountpoint>  <fstype>  <options>  <dump>  <pass>`

      - **options** — mount flags (defaults, noatime, ro, etc.)
      - **dump** — whether `dump` backup tool includes this fs (0=skip, 1=include)
      - **pass** — fsck order at boot (0=skip, 1=root, 2=others)
    tags: [fstab, mount, linux]
    difficulty: medium
    source_article: computing/linux/fstab
    interval: 6
    repetitions: 2
    ease_factor: 2.3
    next_review: "2026-05-11"
    last_review: "2026-05-05"
    last_quality: 3

  # ── Card flagged as leech ────────────────────────────────────────────────────
  - id: permissions-umask-001
    type: basic
    front: "What umask value produces default permissions of 644 for files and 755 for directories?"
    back: |
      **umask 022**

      Calculation:
      - Files start at 666 (no execute by default): 666 - 022 = **644**
      - Directories start at 777: 777 - 022 = **755**

      Common umasks:
      | umask | files | dirs |
      |-------|-------|------|
      | 022   | 644   | 755  |
      | 027   | 640   | 750  |
      | 077   | 600   | 700  |
    tags: [permissions, umask, linux]
    difficulty: hard
    source_article: computing/linux/permissions
    interval: 1
    repetitions: 0
    ease_factor: 1.2          # < 1.3 = leech; agent will surface for extra review
    next_review: "2026-05-07"
    last_review: "2026-05-05"
    last_quality: 1
    leech: true               # flagged by agent after repeated failures
    leech_notes: "User consistently confuses subtraction direction. Try a
      mnemonic or visual diagram next session."
