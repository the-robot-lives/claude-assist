# Simulation Scenario — Agent role-plays a broken/unconfigured system
# Generated by kb-simulation-author or written manually.
# Run via /simulate or the web quiz app in simulation mode.
#
# PURPOSE: The agent plays the role of a terminal in a broken or unconfigured
# system. You type commands; the agent returns realistic output and evaluates
# your diagnostic and remediation steps against the grading rubric.
#
# HOW IT WORKS:
#   1. Agent reads `environment.initial_state` and presents the scenario
#   2. You type commands as if at a real terminal
#   3. Agent returns output from `simulated_commands` if the command matches,
#      or generates plausible output for unlisted commands (with limits)
#   4. Agent tracks which grading steps you've completed
#   5. When you type `/done` or complete all required steps, agent scores you
#
# COMMAND MATCHING:
#   Exact match first → regex match → agent improvises (with plausible_range guardrails)
#
# SCORING:
#   Grading steps have required: true/false.
#   Required steps must be attempted. Optional steps earn bonus points.
#   Agent awards partial credit for correct-intent commands with wrong syntax.

# ── Scenario Metadata ─────────────────────────────────────────────────────────

scenario_id: zfs-pool-recovery
title: "Recover a Degraded ZFS Mirror Pool"
description: "A ZFS mirror pool has one failed drive. Diagnose the degraded state,
  identify the replacement drive, replace the failed device, and verify the pool
  resilvered successfully."
difficulty: intermediate
estimated_time_minutes: 20
created: "2026-05-06"

# Tags for indexing and search
tags: [zfs, storage, linux, sysadmin, troubleshooting]
domain: computing
subdomain: linux/storage

# Learning goals this simulation is a checkpoint for
related_goals: [learn-zfs]
related_articles:
  - computing/zfs/zfs-basics
  - computing/zfs/zfs-troubleshooting

# ── Simulated Environment ─────────────────────────────────────────────────────

environment:
  os: "Ubuntu 24.04 LTS"
  hostname: "nas-01"
  user: "admin"
  working_directory: "~"

  # Narrative description shown to the user at scenario start.
  # Written in second person to establish context.
  initial_state: |
    You are logged into nas-01, your home NAS server. A monitoring alert fired
    at 3am: "ZFS pool datapool is DEGRADED." You've just SSH'd in to investigate.

    The pool is a two-drive mirror (sda + sdb). Both drives are 2TB WD Reds.
    A replacement drive (/dev/sdc, also 2TB) is already installed in the empty
    bay you kept spare for exactly this situation.

    Data is still accessible — the mirror is degraded, not offline — but you're
    running without redundancy until this is fixed.

  # Commands the agent simulates deterministic responses for.
  # Key: exact command string (trimmed, lowercased for matching)
  # Value:
  #   output: literal string to return
  #   inherit: copy output from another command key
  #   dynamic: agent generates plausible output based on description
  simulated_commands:

    "zpool status":
      output: |
        pool: datapool
          state: DEGRADED
         status: One or more devices has been removed by the administrator.
         action: Online the device using 'zpool online' or replace the device
                 with 'zpool replace'.
           scan: scrub repaired 0B in 00:04:12 with 0 errors on Sun Apr 27 00:26:17 2026
         config:
                NAME        STATE     READ WRITE CKSUM
                datapool    DEGRADED     0     0     0
                  mirror-0  DEGRADED     0     0     0
                    sda     ONLINE       0     0     0
                    sdb     UNAVAIL      0     0     0  was /dev/sdb

        errors: No known data errors

    "zpool status datapool":
      inherit: "zpool status"

    "lsblk":
      output: |
        NAME   MAJ:MIN RM  SIZE RO TYPE MOUNTPOINTS
        sda      8:0    0    2T  0 disk
        ├─sda1   8:1    0    2T  0 part
        sdb      8:16   0    2T  0 disk
        sdc      8:32   0    2T  0 disk

    "fdisk -l":
      output: |
        Disk /dev/sda: 2 TiB, 2199023255552 bytes, 4294967296 sectors
        Disk model: WDC WD20EFRX
        ...
        Disk /dev/sdb: 2 TiB, 2199023255552 bytes, 4294967296 sectors
        Disk model: WDC WD20EFRX
        ...
        Disk /dev/sdc: 2 TiB, 2199023255552 bytes, 4294967296 sectors
        Disk model: WDC WD20EFRX

    "ls /dev/sd*":
      output: "/dev/sda  /dev/sda1  /dev/sdb  /dev/sdc"

    "zpool replace datapool sdb sdc":
      output: |
        (no output — command succeeds silently)
        # Note: after this command, subsequent `zpool status` calls show resilvering

    # Dynamic: after replace is run, zpool status changes
    # The agent tracks whether replace has been called and switches output accordingly.
    "zpool status [post-replace]":
      output: |
        pool: datapool
          state: DEGRADED
         status: One or more devices is currently being resilvered. The pool will
                 continue to function, possibly in a degraded state.
         action: Wait for the resilver to complete.
           scan: resilver in progress since Wed May  6 14:32:01 2026
                     2.71G scanned at 452M/s, 1.09G issued at 182M/s, 1.37T total
                     549M resilvered, 0.08% done, 02:08:00 to go
         config:
                NAME        STATE     READ WRITE CKSUM
                datapool    DEGRADED     0     0     0
                  mirror-0  DEGRADED     0     0     0
                    sda     ONLINE       0     0     0
                    sdc     REPLACING    0     0     0
                      sdb   UNAVAIL      0     0     0  was /dev/sdb
                      sdc   ONLINE       0     0     0

    "zpool iostat":
      output: |
                       capacity     operations     bandwidth
        pool        alloc   free   read  write   read  write
        ----------  -----  -----  -----  -----  -----  -----
        datapool     892G  1.11T      5     34  1.22M  8.55M

    "zpool scrub datapool":
      output: "(no output — scrub initiated)"

    "dmesg | grep sdb":
      output: |
        [412847.003211] ata2.00: exception Emask 0x0 SAct 0x7ff0003 SErr 0x0 action 0x6
        [412847.003218] ata2.00: irq_stat 0x40000008
        [412847.003221] ata2.00: failed command: READ FPDMA QUEUED
        [412847.003227] ata2.00: cmd 60/08:00:f0:3a:6f/00:00:13:00:00/40 tag 0 ncq dma 4096 in
        [412847.003231] ata2.00: status: { DRDY ERR }
        [412847.003233] ata2.00: error: { UNC }
        [412847.918821] ata2: EH complete
        [412847.918964] sd 1:0:0:0: [sdb] tag#0 FAILED Result: hostbyte=DID_OK driverbyte=DRIVER_OK
        [412847.918971] sd 1:0:0:0: [sdb] tag#0 Sense Key : Medium Error [current]

  # Commands the agent should refuse to simulate (safety guardrails).
  # If user types these, agent stays in character but warns about data loss.
  dangerous_commands:
    - "dd if=/dev/zero of=/dev/sda"
    - "zpool destroy datapool"
    - "rm -rf /"

  # How the agent handles commands not in simulated_commands.
  # Options: improvise | refuse | hint
  unknown_command_behavior: improvise
  improvise_guardrails: "Generate plausible output consistent with the scenario.
    If the command is clearly irrelevant (e.g., apt install vim), produce normal
    output. If it's a diagnostic command the scenario should support, generate
    realistic output."

# ── Grading ───────────────────────────────────────────────────────────────────

grading:
  total_points: 100
  pass_threshold: 60

  steps:

    - id: step-diagnose
      description: "Check pool status to identify the degraded drive"
      required: true
      points: 20
      # Agent checks whether any of these commands were run
      expected_commands:
        - "zpool status"
        - "zpool status datapool"
      partial_credit: false
      hint_after_minutes: 5  # agent offers a hint if stuck for this long

    - id: step-check-dmesg
      description: "Check dmesg or system logs to confirm drive failure cause"
      required: false         # optional — earns bonus points
      points: 10
      expected_commands:
        - "dmesg | grep sdb"
        - "journalctl -k | grep sdb"
        - "dmesg | tail -50"
      partial_credit: true

    - id: step-identify-replacement
      description: "Identify the available replacement drive"
      required: true
      points: 10
      expected_commands:
        - "lsblk"
        - "fdisk -l"
        - "ls /dev/sd*"
        - "blkid"
      partial_credit: false

    - id: step-replace-drive
      description: "Issue the zpool replace command"
      required: true
      points: 30
      expected_commands:
        - "zpool replace datapool sdb sdc"
        - "zpool replace datapool /dev/sdb /dev/sdc"
      # Award partial credit for correct syntax but wrong device names
      partial_credit: true
      partial_credit_commands:
        - pattern: "zpool replace datapool"
          points: 15
          note: "Correct subcommand but wrong device specification"

    - id: step-verify-resilver
      description: "Verify resilvering has started"
      required: true
      points: 20
      expected_commands:
        - "zpool status"
        - "zpool status datapool"
      # Must be run AFTER replace — agent checks command ordering
      must_follow: step-replace-drive

    - id: step-monitor
      description: "Monitor resilver progress"
      required: false
      points: 10
      expected_commands:
        - "zpool status"
        - "zpool iostat"
        - "watch zpool status"

  # Bonus actions not in the main rubric
  bonuses:
    - id: bonus-scrub
      trigger_command: "zpool scrub datapool"
      points: 5
      reason: "Running a scrub after resilver to verify full data integrity"

    - id: bonus-dmesg
      trigger_command: "dmesg | grep sdb"
      points: 5
      reason: "Checking dmesg to understand the root cause of the failure"

    - id: bonus-iostat
      trigger_command: "zpool iostat"
      points: 3
      reason: "Using iostat to observe resilver I/O throughput"

# ── Post-Scenario Debrief ─────────────────────────────────────────────────────

debrief:
  # Shown after the user types /done or finishes all required steps.
  # Agent uses this as a template, filling in user's actual performance.
  template: |
    ## Scenario Complete — ZFS Pool Recovery

    **Score: {score}/100** ({passed})

    ### What you did well
    {strengths}

    ### Gaps to review
    {gaps}

    ### Key takeaways
    - `zpool replace <pool> <old-dev> <new-dev>` replaces a device and starts resilvering automatically
    - Always verify resilvering with `zpool status` after replace
    - Use `dmesg | grep <device>` to understand why a drive failed (hardware error vs. manual removal)
    - A `zpool scrub` after resilver gives extra confidence in data integrity

    ### Recommended next steps
    {recommendations}
