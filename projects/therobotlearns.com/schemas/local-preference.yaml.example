# Local Preferences — Optional overrides for this machine/environment
# Created by /knowledge-base-setup, editable anytime.
#
# PURPOSE: Machine-local settings that override user-profile.yaml defaults.
# Useful when you work across multiple machines (e.g., more verbose output on
# a dev workstation, lighter output on a laptop with less screen space).
#
# PRECEDENCE: local-preference.yaml > user-profile.yaml > machine-profile.yaml
#
# This file is gitignored by default — safe to put machine-specific paths here.

# ── Domain Overrides ──────────────────────────────────────────────────────────

# Override the complexity/detail level from user-profile for specific domains
# on this machine. Useful for dev workstations where you want max depth.
domain_overrides:
  computing:
    detail: comprehensive  # override: want exhaustive detail on this dev machine
    # level: not overriding — keeps value from user-profile

  mathematics:
    detail: detailed       # slightly more depth than user-profile standard here

# ── Interface Preferences ─────────────────────────────────────────────────────

# Which quiz interface to launch when running /quiz
# Options: web | cli
#   web — launches the Next.js quiz app at localhost:3001
#   cli — runs the terminal quiz interface (no browser required)
quiz_ui: web

# How quiz and flashcard commands collect user responses.
# Options: mcp | standalone
#   mcp        — uses AskUserQuestion for structured input (default)
#   standalone — pure markdown presentation, user responds in chat text
interaction_mode: mcp

# Output format for exported flashcard decks.
# Options: anki | supermemo | plain
#   anki      — .apkg format compatible with Anki desktop
#   supermemo — XML format for SuperMemo
#   plain     — markdown tables (portable, human-readable)
flashcard_format: anki

# ── Agent Behavior ────────────────────────────────────────────────────────────

# Automatically create stub knowledge articles for related topics mentioned
# during a session, even if you didn't explicitly ask for them.
# Stubs are minimal — title, frontmatter, and a one-line description only.
auto_expand_topics: true

# Log session summaries to sessions/ directory after each /learn session.
# Format: sessions/YYYY-MM-DD-{topic}.md
session_logging: true

# Maximum number of sub-agents to run concurrently in background tasks.
# Lower this if you notice context window pressure or slow responses.
max_concurrent_agents: 3

# ── Notification Preferences ──────────────────────────────────────────────────

# How the agent should notify you when a background task completes.
# Options: inline | summary | silent
#   inline   — stream output as it arrives
#   summary  — post a summary block at the end
#   silent   — no output, just update files
background_task_output: summary

# ── Path Overrides ────────────────────────────────────────────────────────────

# Override default output paths for this machine if the project lives somewhere
# other than the standard location.
paths:
  knowledge_root: null       # null = use default (knowledge/)
  sessions_dir: null         # null = use default (sessions/)
  exports_dir: ~/Desktop/kb-exports  # custom: export flashcard decks to Desktop

# ── Review Cadence ────────────────────────────────────────────────────────────

# How often the agent should remind you to review flashcard decks.
# Used by /review-due to surface cards past their next_review date.
review_reminder: daily       # daily | weekly | manual

# Minimum number of cards due before the agent surfaces a reminder.
review_reminder_threshold: 5

# ── Experimental Features ────────────────────────────────────────────────────

# Enable features that are not yet stable.
experimental:
  simulation_voice_mode: false   # TTS narration for simulation scenarios
  peer_review_mode: false        # Agent critiques your written explanations
  concept_graph: false           # Build a graph of topic relationships over time
