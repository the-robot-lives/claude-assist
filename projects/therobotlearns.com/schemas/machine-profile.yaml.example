# Machine Profile — Auto-detected + user-amended tool inventory
# Created by /knowledge-base-setup, updated by agents as they discover tools.
#
# PURPOSE: Agents read this before suggesting commands so they don't recommend
# tools that aren't installed, use wrong flags, or assume wrong shell syntax.
#
# HOW IT'S MAINTAINED:
#   - /knowledge-base-setup auto-populates this on first run via system probes
#   - Agents append newly discovered tools during sessions
#   - You add `usage_tips` manually to correct hallucinations or document quirks
#   - Version fields are informational — agents won't re-check on every call

# ── Operating System ──────────────────────────────────────────────────────────

os:
  name: macOS          # macOS | Ubuntu | Debian | Fedora | Arch | Windows | WSL2
  version: "15.4"      # Full version string from `sw_vers` or `uname -r`
  arch: arm64          # arm64 | x86_64 | aarch64
  codename: "Sequoia"  # optional — useful for macOS and Ubuntu release names

# ── Shell ─────────────────────────────────────────────────────────────────────

shell: zsh             # zsh | bash | fish | powershell | nushell
shell_config: ~/.zshrc # primary config file agents can reference

# ── Version Manager ───────────────────────────────────────────────────────────

# IMPORTANT: If you use a version manager, specify it here. Agents will use
# the correct commands instead of system-level installs.
version_manager: asdf  # asdf | mise | nvm | pyenv | rbenv | none

# ── Package Managers ──────────────────────────────────────────────────────────

# List all available package managers in preference order.
# Agents will use the first one that satisfies a given install.
package_managers:
  - brew    # Homebrew — primary for macOS binaries
  - npm     # Node packages (global installs)
  - pip3    # Python packages
  - cargo   # Rust crates
  - gem     # Ruby gems (system Ruby only, asdf-managed Ruby preferred)

# ── Tools ─────────────────────────────────────────────────────────────────────

# Each entry describes an installed tool. Agents skip suggestions for tools
# where installed: false. Add `usage_tips` to correct known hallucinations.
#
# Fields:
#   installed    — bool, required
#   version      — string, informational
#   path         — absolute path from `which <tool>`, informational
#   via          — how it was installed (brew | asdf | npm | cargo | system | etc.)
#   usage_tips   — free-text notes agents should know before using this tool

tools:

  git:
    installed: true
    version: "2.44.0"
    path: /usr/bin/git
    via: system

  docker:
    installed: true
    version: "25.0.3"
    path: /usr/local/bin/docker
    via: docker-desktop
    usage_tips: "Docker Desktop on macOS — use `docker compose` (v2, no hyphen)
      not `docker-compose` (v1). Colima is not installed. Desktop must be running
      before any docker commands work."

  ffmpeg:
    installed: true
    version: "7.0"
    path: /opt/homebrew/bin/ffmpeg
    via: brew
    usage_tips: "Use -hwaccel videotoolbox on Apple Silicon for hardware-accelerated
      encoding/decoding. Libx264 and libx265 are included. AAC via aac encoder,
      not libfdk_aac (not compiled in this Homebrew build)."

  python3:
    installed: true
    version: "3.12.3"
    path: /opt/homebrew/bin/python3
    via: asdf
    usage_tips: "Managed via asdf — use `asdf install python 3.x.x` to switch.
      pip3 is available. venv preferred over conda for new projects."

  node:
    installed: true
    version: "22.2.0"
    path: /opt/homebrew/bin/node
    via: asdf
    usage_tips: "Managed via asdf. `npm` and `npx` available. pnpm is also
      installed globally. Prefer pnpm for monorepos."

  pnpm:
    installed: true
    version: "9.1.0"
    path: /opt/homebrew/bin/pnpm
    via: npm
    usage_tips: "Preferred package manager for Next.js projects in this repo."

  elixir:
    installed: true
    version: "1.16.2"
    path: /opt/homebrew/bin/elixir
    via: asdf
    usage_tips: "Erlang/OTP 26. mix and iex available. Use `mix phx.server` for
      Phoenix dev server. Hex package manager installed."

  postgresql:
    installed: true
    version: "16.2"
    path: /opt/homebrew/bin/psql
    via: brew
    usage_tips: "Homebrew postgres — service started via `brew services start postgresql@16`.
      Default socket at /tmp/.s.PGSQL.5432. Also available via Docker Compose
      in projects that define it."

  redis:
    installed: true
    version: "7.2.4"
    path: /opt/homebrew/bin/redis-cli
    via: brew
    usage_tips: "Redis server available via `brew services start redis`.
      Default port 6379."

  gh:
    installed: true
    version: "2.49.0"
    path: /opt/homebrew/bin/gh
    via: brew
    usage_tips: "GitHub CLI. Authenticated. Use `gh pr create`, `gh issue list`, etc."

  jq:
    installed: true
    version: "1.7.1"
    path: /opt/homebrew/bin/jq
    via: brew

  curl:
    installed: true
    version: "8.7.1"
    path: /usr/bin/curl
    via: system

  make:
    installed: true
    version: "3.81"
    path: /usr/bin/make
    via: system
    usage_tips: "System make on macOS is old (3.81). If a Makefile requires GNU
      make features, install `gmake` via brew and call `gmake` instead."

  rust:
    installed: true
    version: "1.78.0"
    path: /opt/homebrew/bin/rustc
    via: asdf
    usage_tips: "Managed via asdf. `cargo`, `rustc`, `rustfmt`, `clippy` available."

  imagemagick:
    installed: true
    version: "7.1.1"
    path: /opt/homebrew/bin/convert
    via: brew
    usage_tips: "ImageMagick 7 on macOS uses `magick` as the primary command.
      `convert` is a symlink. HEIC support included via libheif."

  ngrok:
    installed: false
    # Not installed — agent should not suggest ngrok tunnel commands.
    # Alternative: `brew install cloudflared` for tunnel needs.

  # Agent discovers tools by checking common paths and running `which <tool>`.
  # Newly found tools are appended here with installed: true and no usage_tips.
  # User should review and add usage_tips for tools with known quirks.

# ── Environment Variables ─────────────────────────────────────────────────────

# List env vars that are set and relevant. Do NOT include secret values here —
# just note that they exist so agents know not to ask you to set them.
env_vars_set:
  - ANTHROPIC_API_KEY
  - OPENAI_API_KEY
  - GITHUB_TOKEN
  - HOMEBREW_GITHUB_API_TOKEN
  # Add others as needed

# ── Network ───────────────────────────────────────────────────────────────────

# Inform agents about network constraints (VPN, proxy, firewall rules).
network:
  vpn_required_for: []    # domains or services requiring VPN
  proxy: null             # HTTP proxy URL if applicable, or null
  offline_capable: false  # true if you regularly work without internet
