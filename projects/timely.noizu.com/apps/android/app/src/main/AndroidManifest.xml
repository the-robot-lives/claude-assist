<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground-only companion. Deliberately absent: FOREGROUND_SERVICE,
         SYSTEM_ALERT_WINDOW, PACKAGE_USAGE_STATS, MediaProjection. Android does
         not capture; see apps/README.md. -->

    <application
        android:name=".TimelyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timely"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The SSO redirect target.

                 An App Link (https), not a custom scheme, because a custom
                 scheme is claimed by PATTERN: any installed app may register the
                 same one, receive the redirect, and redeem the authorization
                 code. An App Link is ownership-verified against assetlinks.json
                 on the domain, so the redirect cannot be taken in the first
                 place and PKCE becomes defence in depth rather than the only
                 defence.

                 android:autoVerify checks
                 https://timely.noizu.com/.well-known/assetlinks.json. Until that
                 file carries this package and the release signing cert SHA-256,
                 verification fails OPEN into the app-chooser dialog rather than
                 failing shut, so this ships safely ahead of the file — but the
                 ownership guarantee is not in force until it lands.

                 launchMode=singleTask so the redirect returns to the EXISTING
                 task through onNewIntent instead of stacking a second copy of
                 the app on top of the one that started sign-in.

                 The scheme/host/path must equal BuildConfig.OIDC_REDIRECT_URI;
                 RedirectUriTest resolves an intent against the merged manifest
                 to prove the value we send is the value we are registered for. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="timely.noizu.com"
                    android:path="/app/auth/callback" />
            </intent-filter>
        </activity>

        <!-- WorkManager's default initializer is removed so the Hilt-aware
             configuration in TimelyApplication is the only one that runs.
             Leaving both in place yields a worker factory that cannot construct
             @HiltWorker workers, and the sync worker then fails at runtime only. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
