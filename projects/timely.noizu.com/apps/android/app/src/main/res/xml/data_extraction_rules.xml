<?xml version="1.0" encoding="utf-8"?>
<!--
  Belt and braces alongside android:allowBackup="false".

  The token store lives in EncryptedSharedPreferences, but the master key is in
  the Android Keystore and does NOT leave the device, so a backup would capture
  ciphertext that is useless anyway. Excluding it outright is still the honest
  posture: bearer tokens and a local mirror of a user's workday are not things
  to hand to cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="timely_secure_tokens.xml" />
        <exclude domain="database" path="timely.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="timely_secure_tokens.xml" />
        <exclude domain="database" path="timely.db" />
    </device-transfer>
</data-extraction-rules>
