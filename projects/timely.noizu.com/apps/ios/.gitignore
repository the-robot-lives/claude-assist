.build/
.swiftpm/

# Generated by `xcodegen generate` from project.yml, which is the source of
# truth. Regenerate it rather than editing the project in Xcode and committing
# the result.
TimelyiOS.xcodeproj/
DerivedData/
*.xcuserstate

# Local SQLite store and its WAL/SHM sidecars (none exist yet, but the
# first local run of the app will create them).
*.sqlite
*.sqlite3
*.db
*-wal
*-shm
